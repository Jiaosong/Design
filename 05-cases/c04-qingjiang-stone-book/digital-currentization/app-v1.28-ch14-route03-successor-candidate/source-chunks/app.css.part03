/* NAV */
.primary-nav{position:absolute;z-index:70;left:0;right:0;bottom:0;height:64px;padding-bottom:env(safe-area-inset-bottom);display:grid;grid-template-columns:repeat(4,1fr);background:var(--bone);border-top:1px solid var(--river-black)}.primary-nav button{border:0;border-right:1px solid var(--line);background:transparent;display:grid;place-items:center;align-content:center;gap:2px;min-height:44px}.primary-nav button:last-child{border-right:0}.primary-nav svg{width:21px;height:21px;fill:none;stroke:var(--muted);stroke-width:1.65;stroke-linecap:round;stroke-linejoin:round}.primary-nav span{font:600 8px var(--sans);color:var(--muted)}.primary-nav button.active{background:var(--river-black)}.primary-nav button.active svg{stroke:var(--bone)}.primary-nav button.active span{color:var(--bone)}.route-child-rail{position:absolute;z-index:58;left:18px;right:18px;bottom:74px;height:38px;display:none;grid-template-columns:repeat(4,1fr);border-top:1px solid rgba(241,237,228,.28);border-bottom:1px solid rgba(241,237,228,.28)}.route-child-rail.visible{display:grid}.route-child-rail button{border:0;background:transparent;color:rgba(241,237,228,.56);font:700 7px var(--mono);letter-spacing:.08em}.route-child-rail button.active{color:var(--bone);border-bottom:1px solid #D88470}.app[data-screen="READ"] .route-child-rail,.app[data-screen="R06"] .route-child-rail{border-color:var(--line)}.app[data-screen="READ"] .route-child-rail button,.app[data-screen="R06"] .route-child-rail button{color:var(--muted)}.app[data-screen="READ"] .route-child-rail button.active,.app[data-screen="R06"] .route-child-rail button.active{color:var(--ink)}
/* CONTEXT / READ DETAIL */
.route-context,.read-detail{position:absolute;z-index:80;left:0;right:0;bottom:0;background:var(--bone);transform:translateY(105%);transition:transform .42s var(--ease);padding:18px 18px calc(84px + env(safe-area-inset-bottom));border-top:1px solid var(--river-black)}.route-context.open,.read-detail.open{transform:none}.context-rule{width:42px;height:2px;background:var(--deep);margin:0 auto 16px}.context-head,.read-detail-top{display:flex;align-items:start;justify-content:space-between;gap:12px}.context-head span,.read-detail-top>span{font:700 7px var(--mono);color:var(--cinnabar);letter-spacing:.12em}.context-head h2{font:500 30px/1 var(--serif);margin:6px 0}.context-head button,.read-detail-top button{height:44px;border:0;background:transparent;font:600 9px var(--sans);color:var(--muted)}.route-context>p{font-size:11px;line-height:1.65}.context-proof{display:flex;justify-content:space-between;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:10px 0;margin:14px 0;font:700 6px var(--mono);letter-spacing:.08em;color:var(--muted)}.context-read{width:100%;min-height:54px;border:0;background:var(--deep);color:var(--bone);display:flex;align-items:center;gap:12px;text-align:left;padding:8px 12px}.context-read svg{width:24px;height:24px;fill:none;stroke:var(--bone);stroke-width:1.65;stroke-linecap:round;stroke-linejoin:round}.context-read span{display:grid;gap:3px}.context-read b{font:500 13px var(--serif)}.context-read small{font:500 7px var(--sans);color:rgba(241,237,228,.6)}.read-detail{top:90px;overflow:auto}.read-detail h1{font:500 46px/1.05 var(--serif);margin:24px 0 16px}.read-detail>p{font:400 12px/1.8 var(--sans);color:var(--muted)}.read-detail-boundary{margin-top:30px;padding:16px 0;border-top:1px solid var(--river-black);border-bottom:1px solid var(--line);display:grid;gap:7px}.read-detail-boundary b{font:700 7px var(--mono);color:var(--cinnabar);letter-spacing:.1em}.read-detail-boundary span{font:400 10px/1.6 var(--sans);color:var(--muted)}.read-detail-actions{display:grid;grid-template-columns:1fr 1fr;margin-top:18px}.read-detail-actions button{min-height:48px;border:1px solid var(--river-black);background:transparent}.read-detail-actions button+button{border-left:0}
/* SETUP */
.setup-layer{position:absolute;z-index:95;inset:0;background:var(--bone);opacity:0;visibility:hidden;pointer-events:none;transition:opacity .3s var(--ease)}.setup-layer.open{opacity:1;visibility:visible;pointer-events:auto}.setup-step{height:100%;overflow:auto;padding:54px 18px 42px}.setup-meta{height:44px;border-bottom:1px solid var(--river-black);display:flex;align-items:start;justify-content:space-between;font:700 7px var(--mono);letter-spacing:.1em;color:var(--cinnabar)}.setup-meta button{height:44px;border:0;background:transparent;font:600 9px var(--sans);color:var(--muted);margin-top:-14px}.setup-step h1{font:500 52px/.98 var(--serif);letter-spacing:-.055em;margin:34px 0 17px}.setup-step>p{font:400 12px/1.75 var(--sans);color:var(--muted);max-width:350px}.reading-options{margin-top:30px;border-top:1px solid var(--river-black)}.reading-options button{width:100%;min-height:76px;border:0;border-bottom:1px solid var(--line);background:transparent;display:grid;grid-template-columns:54px 90px 1fr;align-items:center;text-align:left;padding:0}.reading-options span{font:700 7px var(--mono);color:var(--cinnabar)}.reading-options b{font:500 19px var(--serif)}.reading-options small{font:400 9px/1.45 var(--sans);color:var(--muted)}.reading-options button.active{background:rgba(46,117,113,.06)}.setup-next{width:100%;height:50px;margin-top:28px;border:1px solid var(--river-black);background:var(--river-black);color:var(--bone);font:600 12px var(--serif)}.setup-note{display:block;margin-top:14px;font:700 6px var(--mono);letter-spacing:.08em;color:var(--muted)}.offline-list{margin-top:24px;border-top:1px solid var(--river-black)}.offline-list>div{min-height:74px;border-bottom:1px solid var(--line);display:grid;grid-template-columns:32px 1fr auto;align-items:center;gap:10px}.offline-list svg{width:25px;height:25px;fill:none;stroke:var(--deep);stroke-width:1.65;stroke-linecap:round;stroke-linejoin:round}.offline-list span{display:grid;gap:3px}.offline-list b{font:500 15px var(--serif)}.offline-list small{font:400 8px var(--sans);color:var(--muted)}.offline-list em{font:700 6px var(--mono);font-style:normal;color:var(--cinnabar);letter-spacing:.08em}
/* TOOLS */
.tools{position:absolute;z-index:98;right:0;top:0;bottom:0;width:min(88%,360px);background:var(--river-black);color:var(--bone);padding:22px 18px;transform:translateX(105%);transition:transform .35s var(--ease);overflow:auto}.tools.open{transform:none}.tools-head{display:flex;justify-content:space-between;align-items:start;border-bottom:1px solid rgba(241,237,228,.25);padding-bottom:14px}.tools-head>div{display:grid;gap:5px}.tools-head span{font:700 7px var(--mono);color:#D88470;letter-spacing:.12em}.tools-head b{font:500 18px var(--serif)}.tools-head button{width:44px;height:44px;border:1px solid rgba(241,237,228,.3);background:transparent;color:var(--bone)}.tools section{margin-top:24px}.tools section>span{display:block;font:700 7px var(--mono);letter-spacing:.12em;color:rgba(241,237,228,.52);margin-bottom:9px}.segmented{display:grid;grid-template-columns:repeat(2,1fr);border-top:1px solid rgba(241,237,228,.25);border-left:1px solid rgba(241,237,228,.25)}.segmented button{min-height:44px;border:0;border-right:1px solid rgba(241,237,228,.25);border-bottom:1px solid rgba(241,237,228,.25);background:transparent;color:rgba(241,237,228,.65);font:700 7px var(--mono);letter-spacing:.07em}.segmented button.active{background:var(--bone);color:var(--river-black)}.reset-button{width:100%;height:44px;margin-top:26px;border:1px solid rgba(241,237,228,.3);background:transparent;color:var(--bone)}.tools>p{font:400 9px/1.6 var(--sans);color:rgba(241,237,228,.48);margin-top:18px}.toast{position:absolute;z-index:110;left:18px;right:18px;bottom:76px;min-height:44px;background:var(--river-black);color:var(--bone);padding:12px 14px;font:500 9px/1.4 var(--sans);opacity:0;transform:translateY(8px);pointer-events:none;transition:.25s var(--ease)}.toast.show{opacity:1;transform:none}
/* DIGITAL PRESENCE */
.app[data-digital="LIGHT"] .brand-copy small,.app[data-digital="LIGHT"] .status-line #digitalName{opacity:.55}.app[data-digital="LIGHT"] .read-detail-boundary{display:none}.app[data-digital="OFF"] .brand-button{opacity:0;pointer-events:none}.app[data-digital="OFF"] .route-child-rail button:not([data-nav-target="ROUTE"]){opacity:.25;pointer-events:none}.app[data-digital="OFF"] .scene-actions,.app[data-digital="OFF"] .r13-memory{display:none}.app[data-digital="OFF"] .status-line #digitalName{color:var(--cinnabar)}.app[data-reading-mode="QUICK"] .read-index button:not(.featured){opacity:.66}.app[data-reading-mode="FAMILY"] .read-index button[data-read="R09"]{opacity:.55}
@media(max-width:390px){.screen h1{font-size:41px}.today-copy h1{font-size:49px}.route-world{width:2100px;height:667px}.route-world img{width:2100px;height:667px}.route-head{grid-template-columns:1fr 96px}.read-index b{font-size:15px}.read-index small{font-size:6px}.r13-silence b{font-size:58px}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition-duration:.001ms!important;scroll-behavior:auto!important}}
