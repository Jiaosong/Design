/* TODAY */
.screen-today{padding-bottom:112px;background:var(--bone)}.today-copy{padding-top:18px;max-width:360px}.today-copy h1{font-size:55px;line-height:.99;letter-spacing:-.065em}.today-copy p{max-width:320px;font-size:13px}.today-river{height:205px;margin:28px -18px 0;position:relative;overflow:hidden;background:var(--deep)}.today-river svg{position:absolute;inset:0;width:100%;height:100%}.river-mass{fill:none;stroke:#8CB6AB;stroke-width:48;opacity:.38;stroke-linecap:round}.river-line{fill:none;stroke:var(--bone);stroke-width:2.2;opacity:.86}.trace-line{fill:none;stroke:var(--cinnabar);stroke-width:1.5;stroke-dasharray:8 10;opacity:.58}.today-river span{position:absolute;left:18px;bottom:14px;color:rgba(241,237,228,.62);font:700 7px var(--mono);letter-spacing:.12em}.journey-spine{border-top:1px solid var(--river-black);margin-top:22px}.journey-spine button{width:100%;min-height:70px;border:0;border-bottom:1px solid var(--line);background:transparent;display:grid;grid-template-columns:38px 32px 1fr auto;align-items:center;text-align:left;padding:0}.journey-spine svg{width:25px;height:25px;fill:none;stroke:var(--deep);stroke-width:1.65;stroke-linecap:round;stroke-linejoin:round}.journey-spine button>span{font:600 8px var(--mono);color:var(--cinnabar)}.journey-spine b{font:500 18px var(--serif)}.journey-spine small{font:700 7px var(--mono);letter-spacing:.1em;color:var(--muted)}.today-footer{display:flex;align-items:center;justify-content:space-between;margin-top:22px;gap:12px}.today-footer>span{font:700 7px var(--mono);letter-spacing:.12em;color:var(--jade)}.today-footer button{min-height:44px;border:0;border-bottom:1px solid var(--river-black);background:transparent;font:600 12px var(--serif)}
/* ROUTE */
.screen-route{padding:98px 0 128px;background:var(--deep);color:var(--bone)}.route-head{padding:18px 18px 16px;display:grid;grid-template-columns:1fr 108px;gap:14px;align-items:end}.screen-route .eyebrow{color:#D88470}.route-head h1{font-size:35px;margin:8px 0 0;color:var(--bone)}.route-boundary{border-left:1px solid rgba(241,237,228,.28);padding-left:10px;display:grid;gap:2px}.route-boundary b{font:700 11px var(--mono);color:#9FD0C8}.route-boundary span,.route-boundary small{font:600 6px/1.5 var(--mono);letter-spacing:.08em;color:rgba(241,237,228,.56)}.route-window{height:450px;position:relative;background:var(--bone);border-top:1px solid rgba(241,237,228,.35);border-bottom:1px solid rgba(241,237,228,.35);overflow:hidden}.route-scroll{position:absolute;inset:0;overflow:auto;scrollbar-width:none;cursor:grab;overscroll-behavior:contain}.route-scroll::-webkit-scrollbar{display:none}.route-scroll:active{cursor:grabbing}.route-world{width:2200px;height:699px;position:relative}.route-world img{width:2200px;height:699px;display:block;user-select:none;-webkit-user-drag:none}.map-anchor{position:absolute;width:46px;height:46px;border-radius:50%;transform:translate(-50%,-50%);border:0;background:transparent;padding:0}.map-anchor:before{content:"";position:absolute;inset:14px;border:1.5px solid var(--cinnabar);border-radius:50%;opacity:.28}.map-anchor:hover:before,.map-anchor:focus-visible:before,.map-anchor.selected:before{inset:8px;opacity:1}.a-dam{left:7.53%;top:26.61%}.a-cliff{left:26.97%;top:30.48%}.a-dock{left:84.22%;top:68.07%}.a-center{left:88.09%;top:86.13%}.map-caption{position:absolute;left:0;right:0;bottom:0;height:38px;padding:0 14px;background:rgba(241,237,228,.94);display:flex;align-items:center;justify-content:space-between;color:var(--ink);border-top:1px solid var(--line)}.map-caption span{font:700 7px var(--mono);color:var(--cinnabar);letter-spacing:.12em}.map-caption b{font:600 8px var(--sans);color:var(--muted)}.route-modes{display:grid;grid-template-columns:repeat(4,1fr);margin:14px 18px 0;border-top:1px solid rgba(241,237,228,.2);border-bottom:1px solid rgba(241,237,228,.2)}.route-modes button{height:54px;border:0;border-right:1px solid rgba(241,237,228,.14);background:transparent;color:rgba(241,237,228,.6);display:grid;place-items:center;align-content:center;gap:3px}.route-modes button:last-child{border-right:0}.route-modes span{font:700 9px var(--mono)}.route-modes b{font:500 9px var(--serif)}.route-modes button.active{color:var(--bone);border-bottom:2px solid var(--cinnabar)}.route-mode-copy{padding:13px 18px 0;display:grid;grid-template-columns:auto 1fr;gap:4px 10px;align-items:center}.route-mode-copy span{font:700 7px var(--mono);color:#D88470}.route-mode-copy b{font:500 14px var(--serif);text-align:right}.route-mode-copy small{grid-column:1/-1;font:500 7px/1.5 var(--sans);color:rgba(241,237,228,.48)}
/* READ */
.screen-read{background:var(--bone);padding-bottom:110px}.read-head{padding-top:18px}.read-head h1{font-size:46px}.read-head p{max-width:355px}.read-index{margin-top:28px;border-top:1px solid var(--river-black)}.read-index button{width:100%;min-height:60px;padding:0;border:0;border-bottom:1px solid var(--line);background:transparent;display:grid;grid-template-columns:46px 1fr auto;align-items:center;text-align:left}.read-index button span{font:700 8px var(--mono);color:var(--cinnabar)}.read-index b{font:500 16px var(--serif)}.read-index small{font:700 6.5px var(--mono);letter-spacing:.08em;color:var(--muted)}.read-index .featured{background:rgba(46,117,113,.055)}.read-index .danger{border-left:2px solid var(--cinnabar);padding-left:8px}
/* SCENES */
.screen-r06{padding:90px 0 108px;background:var(--bone)}.scene-field{height:42vh;min-height:330px;max-height:430px;position:relative;overflow:hidden}.r06-field{background:linear-gradient(180deg,#DCE1DD 0%,#C1CEC7 38%,#86A49B 62%,#466F68 78%,#2E7571 100%)}.r06-horizon{position:absolute;left:-18%;right:-18%;top:25%;height:44%;border-radius:0 0 50% 46%;background:linear-gradient(180deg,rgba(19,59,60,.10),rgba(19,59,60,.42));transform:rotate(-2deg)}.r06-river{position:absolute;left:-14%;right:-14%;bottom:-14%;height:43%;background:rgba(186,196,191,.48);transform:rotate(-4deg);border-radius:56% 48% 0 0}.scene-field>span{position:absolute;left:18px;bottom:14px;font:700 6.5px var(--mono);letter-spacing:.1em;color:rgba(241,237,228,.72)}.scene-copy{padding:24px 18px 0}.scene-copy h1{font-size:45px}.scene-copy p{font-size:11px;max-width:350px}.scene-actions{display:grid;grid-template-columns:1fr 1fr;margin:24px 18px 0;border-top:1px solid var(--river-black);border-bottom:1px solid var(--river-black)}.scene-actions button{min-height:76px;border:0;border-right:1px solid var(--line);background:transparent;display:flex;align-items:center;gap:10px;text-align:left;padding:8px}.scene-actions button:last-child{border-right:0}.scene-actions svg,.r13-memory svg{width:25px;height:25px;fill:none;stroke:var(--deep);stroke-width:1.65;stroke-linecap:round;stroke-linejoin:round}.scene-actions span,.r13-memory span{display:grid;gap:3px}.scene-actions b,.r13-memory b{font:500 13px var(--serif)}.scene-actions small,.r13-memory small{font:700 6px var(--mono);color:var(--muted);letter-spacing:.08em}.scene-reveal{position:absolute;z-index:35;left:0;right:0;bottom:0;padding:26px 18px calc(98px + env(safe-area-inset-bottom));background:var(--bone);border-top:1px solid var(--river-black)}.scene-reveal>span{font:700 7px var(--mono);color:var(--cinnabar);letter-spacing:.12em}.scene-reveal h2{font:500 30px/1.1 var(--serif);margin:10px 0}.scene-reveal p{font-size:11px}.scene-reveal button{min-height:44px;margin-top:16px;border:0;border-bottom:1px solid var(--ink);background:transparent;font:600 11px var(--serif)}
.screen-r13{background:var(--river-black);color:var(--bone);padding:100px 18px 112px}.screen-r13 .eyebrow{color:#D88470}.r13-silence{height:38vh;min-height:280px;display:flex;align-items:flex-end;justify-content:space-between;border-bottom:1px solid rgba(241,237,228,.34);position:relative}.r13-silence:before{content:"";position:absolute;left:0;top:18%;width:1px;height:52%;background:var(--cinnabar)}.r13-silence span{font:700 8px var(--mono);letter-spacing:.14em;color:rgba(241,237,228,.52);padding-bottom:12px}.r13-silence b{font:500 clamp(52px,15vw,76px)/.9 var(--serif);letter-spacing:-.06em;color:rgba(241,237,228,.92);padding-bottom:6px}.r13-copy{padding-top:24px}.r13-copy h1{font-size:43px;color:var(--bone)}.r13-copy p{color:rgba(241,237,228,.62);font-size:11px}.r13-memory{width:100%;min-height:62px;margin-top:30px;border:0;border-top:1px solid rgba(241,237,228,.34);border-bottom:1px solid rgba(241,237,228,.34);background:transparent;color:var(--bone);display:flex;align-items:center;gap:12px;text-align:left}.r13-memory svg{stroke:#D88470}
/* BOOK */
.screen-book{background:var(--bone);padding-bottom:110px}.book-head{padding-top:18px}.book-head h1{font-size:54px}.book-head p{max-width:350px}.book-empty{margin-top:40px;padding:58px 0;border-top:1px solid var(--river-black);border-bottom:1px solid var(--line)}.book-empty span{font:700 7px var(--mono);letter-spacing:.12em;color:var(--cinnabar)}.book-empty h2{font:500 28px var(--serif);margin:10px 0}.book-empty p{max-width:280px}.book-list{margin-top:32px;border-top:1px solid var(--river-black)}.book-entry{padding:18px 0;border-bottom:1px solid var(--line);display:grid;grid-template-columns:48px 1fr;gap:10px}.book-entry>span{font:700 8px var(--mono);color:var(--cinnabar)}.book-entry b{font:500 18px var(--serif)}.book-entry p{font-size:10px;margin-top:5px}.book-entry small{display:block;font:600 7px var(--mono);letter-spacing:.08em;color:var(--muted);margin-top:8px}.book-definition{margin-top:32px;background:var(--deep);color:var(--bone);padding:24px 18px;display:grid;gap:7px}.book-definition b{font:600 20px var(--serif)}.book-definition span{font:400 10px var(--sans);color:rgba(241,237,228,.65)}
/* SERVICE */
.screen-service{background:var(--bone);padding-bottom:112px}.service-head{padding-top:18px}.service-head h1{font-size:54px;max-width:360px}.service-head p{font-size:12px;max-width:355px}.service-state{margin-top:34px;padding:18px 0;border-top:1px solid var(--river-black);border-bottom:1px solid var(--river-black);display:grid;grid-template-columns:80px 1fr;align-items:center;gap:4px}.service-state span{font:700 7px var(--mono);letter-spacing:.12em;color:var(--muted)}.service-state b{font:500 30px var(--serif);text-align:right}.service-state small{grid-column:1/-1;text-align:right;font:700 6.5px var(--mono);letter-spacing:.08em;color:var(--muted)}.app[data-reality="NORMAL"] .service-state b{color:var(--normal)}.app[data-reality="DEGRADED"] .service-state b{color:var(--degraded)}.app[data-reality="CLOSED"] .service-state b{color:var(--closed)}.app[data-reality="UNKNOWN"] .service-state b{color:var(--unknown)}.service-priority{margin-top:22px}.service-priority>div{min-height:64px;border-bottom:1px solid var(--line);display:grid;grid-template-columns:28px 30px 1fr;align-items:center;column-gap:8px}.service-priority>div>span{font:700 7px var(--mono);color:var(--cinnabar)}.service-priority svg{width:23px;height:23px;fill:none;stroke:var(--deep);stroke-width:1.65;stroke-linecap:round;stroke-linejoin:round}.service-priority b{font:600 13px var(--sans);letter-spacing:.08em}.service-priority small{grid-column:3;font:400 9px var(--sans);color:var(--muted);margin-top:-18px}.service-continue{width:100%;height:50px;margin-top:26px;border:1px solid var(--river-black);background:transparent;font:600 12px var(--serif)}.app[data-reality="CLOSED"] .service-continue,.app[data-reality="UNKNOWN"] .service-continue{border-color:var(--line);color:var(--muted)}
