:root{
  --bone:#F1EDE4;--bone2:#E8E1D5;--river-black:#111918;--deep:#133B3C;--jade:#2E7571;--mica:#BAC4BF;--cinnabar:#B8543E;
  --ink:#1C2522;--muted:#6C756F;--line:rgba(17,25,24,.16);
  --normal:#4C7B65;--degraded:#B17D35;--closed:#A4473D;--unknown:#68706D;
  --serif:"Noto Serif CJK SC","Noto Serif SC","Songti SC",serif;
  --sans:"Noto Sans CJK SC","Noto Sans SC","PingFang SC","Microsoft YaHei",sans-serif;
  --mono:"Noto Sans Mono CJK SC","SFMono-Regular",Consolas,monospace;
  --ease:cubic-bezier(.22,.72,.2,1)
}
*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:#D9D3C8;color:var(--ink);font-family:var(--sans)}button{font:inherit;color:inherit;-webkit-tap-highlight-color:transparent}button:focus-visible,.route-scroll:focus-visible{outline:2px solid var(--cinnabar);outline-offset:2px}.icon-defs{position:absolute;overflow:hidden}
body{display:grid;place-items:start center}.app{position:relative;width:min(100%,430px);height:100svh;min-height:720px;overflow:hidden;background:var(--bone);isolation:isolate;box-shadow:0 0 60px rgba(17,25,24,.12)}
.app:after{content:"";position:absolute;inset:0;pointer-events:none;z-index:100;background-image:linear-gradient(30deg,rgba(17,25,24,.012) 12%,transparent 12.5%,transparent 87%,rgba(17,25,24,.012) 87.5%);background-size:21px 36px;mix-blend-mode:multiply;opacity:.28}
.topbar{position:absolute;z-index:60;left:0;right:0;top:0;height:66px;padding:10px 14px 6px;display:flex;align-items:center;justify-content:space-between;background:linear-gradient(180deg,var(--bone) 72%,rgba(241,237,228,0));pointer-events:none}.brand-button,.top-actions button{pointer-events:auto}.brand-button{height:46px;display:flex;align-items:center;gap:9px;border:0;background:transparent;padding:0}.stone-mark{width:30px;height:26px;position:relative;display:block}.stone-mark i{position:absolute;left:0;right:0;height:6px;border:1.5px solid var(--deep);transform:skewX(-11deg)}.stone-mark i:nth-child(1){top:1px;left:5px}.stone-mark i:nth-child(2){top:10px;right:5px}.stone-mark i:nth-child(3){top:19px;left:8px;border-color:var(--jade)}.brand-copy{display:grid;text-align:left;gap:1px}.brand-copy b{font:600 14px/1 var(--serif);letter-spacing:.04em}.brand-copy small{font:600 6px/1.2 var(--sans);letter-spacing:.14em;color:var(--muted)}.top-actions{display:flex;align-items:center;gap:5px}.tool-button{width:44px;height:44px;border:0;background:transparent;display:grid;place-items:center}.tool-button svg{width:22px;height:22px;stroke:var(--muted);stroke-width:1.65;fill:none}.return-button{height:44px;min-width:76px;border:1px solid var(--river-black);background:var(--bone);display:flex;align-items:center;justify-content:center;gap:6px;padding:0 10px;font:700 10px var(--sans);letter-spacing:.04em}.return-button svg{width:20px;height:20px;fill:none;stroke:var(--cinnabar);stroke-width:1.65;stroke-linecap:round;stroke-linejoin:round}
.status-line{position:absolute;z-index:55;top:66px;left:14px;right:14px;height:24px;border-top:1px solid var(--line);display:flex;align-items:center;gap:7px;font:700 6.6px/1 var(--mono);letter-spacing:.09em;color:var(--muted)}.status-line i{width:2px;height:2px;background:currentColor;border-radius:50%}.app[data-reality="NORMAL"] #statusName{color:var(--normal)}.app[data-reality="DEGRADED"] #statusName{color:var(--degraded)}.app[data-reality="CLOSED"] #statusName{color:var(--closed)}.app[data-reality="UNKNOWN"] #statusName{color:var(--unknown)}
.viewport{position:absolute;inset:0 0 64px;overflow:hidden}.screen{position:absolute;inset:0;overflow:auto;overscroll-behavior:contain;padding:98px 18px 42px;opacity:0;visibility:hidden;pointer-events:none;transform:translateY(10px);transition:opacity .35s var(--ease),transform .45s var(--ease);scrollbar-width:none}.screen::-webkit-scrollbar{display:none}.screen.active{opacity:1;visibility:visible;pointer-events:auto;transform:none}.eyebrow{font:700 8px/1.3 var(--mono);letter-spacing:.14em;color:var(--cinnabar);text-transform:uppercase}.screen h1{font:500 44px/1.05 var(--serif);letter-spacing:-.04em;margin:11px 0 16px}.screen p{font:400 12px/1.72 var(--sans);color:var(--muted);margin:0}
