  "source_boundary": "CIBSE stage-oriented Codes of Practice and the RIBA Plan of Work reference to BSRIA BG6 inform the process structure. Exact technical criteria remain discipline-, system-, code-, climate- and project-specific and are not invented by this draft.",
  "stages": [
    {
      "stage_id": "MEP-00",
      "stage_name": "Strategic Services Definition",
      "purpose": "Establish building-services outcomes, environmental targets, operational strategy, resilience needs, utility constraints and service scope.",
      "required_outputs": ["services_scope", "performance_objectives", "utility_and_infrastructure_unknowns", "initial_energy_environment_operations_strategy"],
      "critical_interfaces": ["CLIENT", "ARCHITECTURE", "ENERGY_SUSTAINABILITY", "UTILITIES", "OPERATIONS"],
      "exit_conditions": ["goals_and_responsibilities_declared", "critical_utility_unknowns_owned", "no_load_or_capacity_assumption_promoted_to fact"]
    },
    {
      "stage_id": "MEP-01",
      "stage_name": "Basis of Design and Requirements",
      "purpose": "Translate brief, occupancy, climate, process loads, comfort, indoor-environment, water, electrical, fire/life-safety and operational requirements into a controlled basis of design.",
      "required_outputs": ["basis_of_design", "load_input_register", "system_requirements", "design_responsibility_matrix", "investigation_and_metering_needs"],
      "critical_interfaces": ["ARCHITECTURE", "OPERATIONS", "FIRE", "SPECIALIST_SYSTEMS", "ENERGY"],
      "exit_conditions": ["load_inputs_traceable", "design_conditions_and_assumptions_explicit", "responsibilities_assigned"]
    },
    {
      "stage_id": "MEP-02",
      "stage_name": "System Concept Selection",
      "purpose": "Develop and compare HVAC, electrical, public-health/plumbing, controls and specialist-system concepts against performance, spatial, energy, cost, maintainability and resilience criteria.",
      "required_outputs": ["system_options", "selected_system_concepts", "plant_and_riser_allowances", "preliminary_loads_and_capacity_ranges", "controls_concept"],
      "critical_interfaces": ["ARCHITECTURAL_ZONES", "STRUCTURE", "ROOF_AND_PLANT", "RISERS", "FACADE", "UTILITIES"],
      "exit_conditions": ["selection_basis_traceable", "major_space_and_utility_dependencies_declared", "capacity_ranges_not_presented_as_final_verified sizing"]
    },
    {
      "stage_id": "MEP-03",
      "stage_name": "Spatial Coordination",
      "purpose": "Coordinate plant, risers, ducts, pipes, cable routes, terminal devices, maintenance zones, access, penetrations and service clearances with architecture and structure.",
      "required_outputs": ["coordinated_services_zones", "riser_and_plant_layout", "major_distribution_routes", "penetration_and_access_requirements", "interface_register"],
      "critical_interfaces": ["ARCHITECTURE", "STRUCTURE", "FIRE", "FACADE", "INTERIORS", "LIGHTING"],
      "exit_conditions": ["material_clashes_resolved_or_owned", "maintenance_access_modeled", "shared_variables_have_change_authority"]
    },
    {
      "stage_id": "MEP-04",
      "stage_name": "Technical Design",
      "purpose": "Develop calculations, equipment selections, distribution sizing, controls sequences, schematics and technical details to the required design-responsibility level.",
      "required_outputs": ["technical_calculations", "equipment_selection_basis", "system_schematics", "controls_sequences", "coordinated_drawings_and_specs", "commissioning_requirements"],
      "critical_interfaces": ["CONTROLS", "BMS", "FIRE_ALARM", "ELECTRICAL_POWER", "HYDRAULICS", "SPECIALISTS"],
      "exit_conditions": ["assurance_targets_closed_for_declared_scope", "supplier_or_specialist_design boundaries explicit", "commissioning intent defined"]
    },
    {
      "stage_id": "MEP-05",
      "stage_name": "Production / Installation Information",
      "purpose": "Translate technical design into coordinated installation, fabrication and specialist information while controlling substitutions and delegated design.",
      "required_outputs": ["installation_information", "builders_work_information", "reviewed_specialist_submissions", "updated_schedules_and_sequences"],
      "critical_interfaces": ["CONTRACTOR", "SPECIALIST_SUBCONTRACTORS", "STRUCTURE", "ARCHITECTURE"],
      "exit_conditions": ["delegated_design_boundaries_clear", "material_changes_reassured", "installation_handoff_readback_complete"]
    },
    {
      "stage_id": "MEP-06",
      "stage_name": "Construction, Testing and Commissioning",
      "purpose": "Support installation, manage technical changes, execute or review testing/commissioning evidence and resolve defects within assigned responsibilities.",
      "required_outputs": ["change_records", "test_and_commissioning_results", "defect_and_issue_records", "controls_validation_records", "site_observation_or_witness_records_if_in_scope"],
      "critical_interfaces": ["CONTRACTOR", "COMMISSIONING_MANAGER", "CONTROLS", "OPERATIONS", "AUTHORITIES_AS_APPLICABLE"],
      "exit_conditions": ["commissioning_results_target_bound", "defects_owned", "simulation_design_values_and_measured_results_kept distinct"]
    },
    {
      "stage_id": "MEP-07",
      "stage_name": "Handover and Operational Readiness",
      "purpose": "Transfer systems, setpoints, controls, maintenance, training and asset information to operations with residual risks and limitations explicit.",
      "required_outputs": ["O&M_information", "commissioning_summary", "controls_and_setpoint_record", "training_and_handover_records", "asset_information", "residual_risk_items"],
      "critical_interfaces": ["FACILITIES", "OPERATIONS", "CLIENT", "COMMISSIONING", "CONTROLS"],
      "exit_conditions": ["operations_acceptance_scope_defined", "known_limitations_transferred", "as_operated_configuration identity established"]
    },
    {
      "stage_id": "MEP-08",
      "stage_name": "In-Use Evaluation and Tuning",
      "purpose": "Evaluate actual system performance, comfort, energy/water use, controls behavior and maintainability; tune or reopen design decisions where evidence justifies it.",
      "required_outputs": ["in_use_performance_findings", "tuning_actions", "operational_issues", "change_proposals", "G9_reuse_candidates_if_transferable"],
      "critical_interfaces": ["FACILITIES", "OCCUPANTS", "ENERGY_MANAGEMENT", "CONTROLS"],
      "exit_conditions": ["measured_and_inferred_performance_separated", "tuning_changes_configuration_bound", "cross_project lessons separately admitted"]
    }
  ],
  "runtime_binding": {
