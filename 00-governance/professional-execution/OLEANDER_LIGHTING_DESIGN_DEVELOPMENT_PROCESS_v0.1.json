    "P6": "photometric_calculation_mockup_product_data commissioning measurement and QA",
    "P7": "glare_control_daylight_substitution_installation_and_operational uncertainty",
    "P8": "lighting_models_drawings_schedules_specs_calculations_submittals_and_handoffs",
