{
  "schema": "oleander.reference-materialization-gate.v1",
  "version": "1.0",
  "status": "ACTIVE_CURRENT",
  "scope": "OLEANDER_ALL_PROJECTS_ALL_CONVERSATIONS_REFERENCE_RECONSTRUCTION",
  "invariant": "BROWSER_VISIBLE_DOES_NOT_EQUAL_LOCAL_SOURCE_BYTES_AVAILABLE",
  "fidelity_invariant": "REPRODUCTION_MEANS_PIXEL_LEVEL_FIDELITY_BY_DEFAULT",
  "required_sequence": [
    "SOURCE_AUTHORITY_FOUND",
    "SOURCE_BYTES_MATERIALIZED",
    "SOURCE_HASHED",
    "REFERENCE_FRAME_EXTRACTED",
    "REFERENCE_SCALE_LOCKED",
    "COMPARISON_RUNTIME_VERIFIED",
    "INDEPENDENT_ONE_TO_ONE_RECONSTRUCTION",
    "PIXEL_LEVEL_COMPARISON",
    "MISMATCH_REPAIR",
    "RETEST"
  ],
  "materialization_routes": [
    "CONVERSATION_UPLOAD_OR_MOUNTED_FILE",
    "PUBLIC_DIRECT_URL_DOWNLOAD",
    "CONNECTOR_NATIVE_MATERIALIZE_OR_DOWNLOAD",
    "GITHUB_OR_GOOGLE_DRIVE_EXACT_FILE_TO_LOCAL_BYTES",
    "BROWSER_ONLY_SOURCE_RESULTS_IN_HOLD_NO_SOURCE_BYTES"
  ],
  "states": [
    "MATERIALIZED",
    "LOCKED_REFERENCE_FRAME",
    "HOLD_NO_SOURCE_BYTES",
    "HOLD_NO_RENDERER",
    "HOLD_SOURCE_AMBIGUOUS",
    "HOLD_NO_PIXEL_COMPARISON",
    "REVISE_PIXEL_MISMATCH",
    "PASS_PIXEL_LEVEL_FIDELITY"
  ],
  "canonical_adapter": "90-shared/toolchains/reference-materialization/materialize_reference.py",
  "pdf_renderer_order": [
    "pdftoppm",
    "pypdfium2"
  ],
  "manifest_name": "reference_materialization_manifest.json",
  "comparison_sequence": [
    "LOCKED_ORIGINAL_FRAME",
    "INDEPENDENT_ONE_TO_ONE_RECONSTRUCTION",
    "MATCHED_SCALE_SIDE_BY_SIDE",
    "PIXEL_ALIGNED_OVERLAY_OR_FLICKER",
    "PIXEL_DIFFERENCE_VIEW",
    "GEOMETRY_TYPE_SPACING_MISMATCH_LIST",
    "FIDELITY_REPAIR",
    "PIXEL_RETEST"
  ],
  "pixel_level_fidelity": {
    "default_target": "PIXEL_IDENTICAL_AT_LOCKED_REFERENCE_SCALE_OR_FRAME",
    "pass_rule": "REPRODUCTION_PASS_REQUIRES_PIXEL_LEVEL_COMPARISON_AND_NO_MATERIAL_PIXEL_MISMATCH",
    "deterministic_media_rule": "WHEN_REFERENCE_AND_RECONSTRUCTION_CAN_SHARE_A_DETERMINISTIC_RENDER_PIPELINE_TARGET_ZERO_PIXEL_DIFFERENCE",
    "render_noise_rule": "ANTIALIASING_RASTERIZER_ICC_OR_FONT_RENDERING_DIFFERENCES_MAY_BE_RECORDED_ONLY_WHEN_QUANTIFIED_ISOLATED_AND_PROVEN_NON_MATERIAL",
    "hold_rule": "IF_PIXEL_LEVEL_COMPARISON_CANNOT_BE_EXECUTED_OR_MATERIAL_PIXEL_MISMATCH_REMAINS_FIDELITY_GATE_IS_HOLD_OR_REVISE_NOT_PASS",
    "independence_rule": "COPYING_OR_REEXPORTING_THE_ORIGINAL_SOURCE_BYTES_DOES_NOT_COUNT_AS_RECONSTRUCTION_EVIDENCE"
  },
  "minimum_match_dimensions": [
    "CANVAS_FRAME_ASPECT_RATIO_CROP",
    "PRIMARY_GEOMETRY_SILHOUETTE_OBJECT_PLACEMENT",
    "GRID_MARGIN_ALIGNMENT_SPACING_WHITESPACE",
    "TYPOGRAPHY_METRICS_LINE_BREAKS_TRACKING_LEADING_WEIGHT",
    "LINEWEIGHT_STROKE_ICON_PICTOGRAM_ANNOTATION_GEOMETRY",
    "IMAGE_SCALE_CROP_TONE_COLOR_CONTRAST",
    "MATERIAL_LIGHTING_CAMERA_LENS_PERSPECTIVE_FOR_3D",
    "TIMING_EASING_PATH_OVERLAP_KEYFRAMES_FOR_MOTION"
  ],
  "required_receipt_fields": [
    "SOURCE_AUTHORITY",
    "SOURCE_LOCATOR",
    "SOURCE_BYTES_STATE",
    "SOURCE_SHA256",
    "REFERENCE_FRAME_STATE",
    "PAGE_OR_FRAME",
    "SCALE_OR_DPI",
    "RENDERER",
    "REFERENCE_FRAME_SHA256",
    "COMPARISON_RUNTIME",
    "PIXEL_DIFF_STATE",
    "PIXEL_DIFF_METRIC",
    "MISMATCH_STATE",
    "FIDELITY_GATE",
    "DOES_NOT_PROVE"
  ],
  "fail_closed_rules": [
    "IF_SOURCE_BYTES_NOT_MATERIALIZED_REPRODUCTION_PASS_IS_FORBIDDEN",
    "IF_REFERENCE_FRAME_NOT_LOCKED_PIXEL_COMPARISON_CANNOT_BE_CLAIMED",
    "IF_PIXEL_LEVEL_COMPARISON_NOT_EXECUTED_REPRODUCTION_PASS_IS_FORBIDDEN",
    "IF_MATERIAL_PIXEL_MISMATCH_REMAINS_REPRODUCTION_PASS_IS_FORBIDDEN",
    "DO_NOT_FABRICATE_MISSING_SOURCE_PIXELS_OR_DIMENSIONS",
    "DO_NOT_LOWER_REPRODUCTION_MEANING_TO_HIDE_RUNTIME_LIMITATIONS",
    "DO_NOT_RENAME_STRUCTURAL_OR_METHOD_STUDY_AS_REPRODUCTION",
    "DO_NOT_COUNT_DIRECT_SOURCE_COPY_OR_REEXPORT_AS_RECONSTRUCTION"
  ],
  "does_not_prove": [
    "SOURCE_AUTHORITY",
    "RIGHTS_CLEARANCE",
    "DESIGN_QUALITY",
    "FIELD_OR_ENGINEERING_TRUTH",
    "TRANSFER_VARIANT_QUALITY"
  ]
}
