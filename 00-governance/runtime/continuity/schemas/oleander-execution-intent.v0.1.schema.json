{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oleander.design/schemas/execution-intent.v0.1.schema.json",
  "title": "OLEANDER Execution Intent v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "intent_id",
    "captured_at",
    "source_surface",
    "target_surface",
    "scope",
    "intent_class",
    "raw_human_input",
    "normalized_instruction",
    "human_action_level",
    "status",
    "owner_native_precondition",
    "material_write_authorized",
    "authority_ceiling",
    "consumed_by_session_receipt",
    "does_not_prove"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "intent_id": {"type": "string", "pattern": "^INT-"},
    "captured_at": {"type": "string", "format": "date-time"},
    "source_surface": {"enum": ["COS", "CHATGPT_WEB", "CHATGPT_DESKTOP", "KNOWLEDGE_ADMIN", "OTHER"]},
    "target_surface": {"enum": ["LOCAL_COS", "REMOTE_CHAT", "EITHER", "NONE"]},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "workspace_key", "object_ref"],
      "properties": {
        "project_id": {"type": ["string", "null"], "pattern": "^PRJ-"},
        "workspace_key": {"type": ["string", "null"]},
        "object_ref": {"type": ["string", "null"]}
      }
    },
    "intent_class": {"enum": ["WORK_REQUEST", "ITERATION_STEER", "DESIGN_DECISION", "READ_ONLY_QUERY", "KNOWLEDGE_MAINTENANCE", "SYSTEM_MAINTENANCE"]},
    "raw_human_input": {"type": "string", "minLength": 1},
    "normalized_instruction": {"type": "string", "minLength": 1},
    "human_action_level": {"enum": ["NONE", "WORK_INTENT", "ITERATION_STEER", "DESIGN_DECISION", "DESIGN_KEEP", "PROMOTION_DECISION"]},
    "status": {"enum": ["CAPTURED", "LOCAL_REQUIRED", "READY", "CONSUMED", "HOLD", "CANCELLED"]},
    "owner_native_precondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reread_required", "authority_refs", "drift_policy"],
      "properties": {
        "reread_required": {"type": "boolean"},
        "authority_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "drift_policy": {"const": "FAIL_CLOSED_REREAD_OWNER_NATIVE_BEFORE_MATERIAL_PROJECT_WRITE"}
      }
    },
    "material_write_authorized": {"type": "boolean"},
    "authority_ceiling": {"type": "string", "minLength": 1},
    "consumed_by_session_receipt": {"type": ["string", "null"]},
    "does_not_prove": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
