  "new_receipt_rule": "EVERY_RECEIPT_NOT_IN_LEGACY_ALLOWLIST_MUST_INCLUDE_CONSTRAINT_LOCK_AND_FLOW_COMPLETION; VISUAL_EXECUTIONS_BINDING_SEMANTIC_CONTENT_IMAGES MUST ADD IMAGE_CONSUMPTION; CONTINUING_TASKS MUST ADD CONTINUATION_CHECKPOINT WHEN APPLICABLE; MATERIAL_CROSS_LAYER_HANDOFFS MUST ADD RUNTIME_LAYER_HANDOFF WHEN THE HANDOFF SUPPORTS CONTINUATION_REVIEW_OR_PROMOTION; MULTI_SURFACE_MATERIAL_MUTATIONS MUST ADD PARTIAL_COMMIT_RECONCILIATION WHEN DEPENDENT_ADVANCE_OR_HANDOFF_REQUIRES_COHERENT_SIDE_EFFECTS; MATERIAL_FAILURE_OR_CONTRADICTION_REQUIRING_CONTAINMENT_RECOVERY_OR_RECOVERY_CLOSURE_TO_SUPPORT_CONTINUATION_REVIEW_OR_PROMOTION MUST ADD RECOVERY_INCIDENT; CONCURRENCY_GUARD_AND_REMOTE_MUTATION_IDEMPOTENCY ARE RECORDED ONLY WHEN MATERIAL EXECUTION USES THEM; CROSS_CONTEXT_DISCOVERY_ADAPTER_ROUTE_AND_MULTI_NODE_AUTO_ADVANCE ARE RECORDED ONLY WHEN MATERIAL_EXECUTION_USES_THEM_AND_AN_EXISTING_PERSISTENCE_TRIGGER_APPLIES; PROFESSIONAL_EXECUTION_GRANULARITY MUST BE RECORDED WHEN A MATERIAL PROFESSIONAL-DOMAIN EXECUTION REQUIRES DECISION_OBJECT_CLAIM_OUTPUT PRECISION FOR CONTINUATION REVIEW REOPEN OR PROMOTION",
