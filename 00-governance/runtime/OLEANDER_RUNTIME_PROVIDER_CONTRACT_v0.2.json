{
  "contract_id": "OLEANDER_RUNTIME_PROVIDER_CONTRACT",
  "version": "0.2",
  "status": "CANDIDATE_NON_AUTHORITY",
  "decision_date": "2026-09-27",
  "purpose": "Define the provider-neutral execution seam below OLEANDER semantics, including ExecutionLedger, ActionRuntime, DurableJob and capability resolution, without moving Project State, Current, Decision, Artifact authority, professional-stage semantics or Promotion into providers.",
  "architecture_refs": [
    "product-docs/v0.3/OLEANDER_EXECUTION_FABRIC_ARCHITECTURE_v0.3.3.md",
    "00-governance/runtime/OLEANDER_COS_HARNESS_ADAPTER_v0.2.json",
    "00-governance/runtime/OLEANDER_CURRENT_ARCHITECTURE_MAP_v2.1.md",
    "00-governance/runtime/OLEANDER_TOOL_ADAPTER_CONTRACT_v0.1.json",
    "00-governance/runtime/OLEANDER_OBSERVABILITY_RECOVERY_CONTRACT_v1.0.json",
    "00-governance/runtime/OLEANDER_SYSTEM_MANIFEST_v0.2.json",
    "00-governance/runtime/OLEANDER_EXECUTION_RUNTIME_PRIMITIVES_v0.1.json",
    "00-governance/runtime/OLEANDER_EXECUTION_SURFACE_SCHEMA_v0.1.json",
    "00-governance/runtime/OLEANDER_CORE_INTERFACE_PRIMITIVES_v0.1.json"
  ],
  "authority_ceiling": "EXECUTION_CAPABILITY_AND_OBSERVABILITY_ONLY",
  "providers_under_spike": [
    "native_cos",
    "deepseek_harness",
    "microsoft_agent_framework",
    "pydantic_ai_temporal"
  ],
  "required_provider_operations": [
    "probe",
    "open_runtime_session",
    "execute_bounded_action",
    "normalize_execution_event",
    "report_health"
  ],
  "runtime_session_rules": [
    "PROVIDER_SESSION_IS_NOT_PROJECT_STATE",
    "PROVIDER_SESSION_IS_NOT_CURRENT_AUTHORITY",
    "PROVIDER_RESUME_REPLAY_OR_FORK_MAY_NOT_CREATE_PROJECT_TRUTH",
    "PROVIDER_REMOVAL_MUST_NOT_MAKE_OWNER_NATIVE_PROJECT_STATE_UNRECOVERABLE"
  ],
  "guard_rules": [
    "OLEANDER_ACTION_GUARD_PRECEDES_PROVIDER_NATIVE_APPROVAL",
    "PROVIDER_APPROVAL_MAY_NARROW_BUT_NEVER_WIDEN_OLEANDER_PERMISSION",
    "READ_ONLY_DOES_NOT_AUTO_AUTHORIZE_SENSITIVE_EXTERNAL_DISCLOSURE",
    "MATERIAL_COST_OR_BLAST_RADIUS_ESCALATION_REQUIRES_EXISTING_SCOPED_PERMISSION_OR_HOLD",
    "DENIED_OLEANDER_ACTION_MUST_NOT_REACH_PROVIDER_EXECUTION"
  ],
  "execution_ledger": {
    "semantic_class": "APPEND_ONLY_RUNTIME_EVIDENCE_NOT_PROJECT_STATE",
    "required_fields": [
      "event_id",
      "provider_id",
      "provider_session_id",
      "action_id",
      "event_type",
      "outcome",
      "observed_at",
      "does_not_prove"
    ],
    "allowed_event_types": [
      "ACTION_REQUESTED",
      "ACTION_GUARD_BLOCKED",
      "ACTION_DEFERRED",
      "ACTION_RESUMED",
      "PROVIDER_APPROVAL_BLOCKED",
      "EXECUTION_STARTED",
      "EXECUTION_OBSERVED",
      "EXECUTION_FAILED",
      "READBACK_REQUIRED",
      "READBACK_COMPLETED",
      "EXECUTION_COMPLETED"
    ],
    "forbidden_authority_fields": [
      "project_state",
      "project_current",
      "current",
      "design_decision",
      "design_keep",
      "professional_pass",
      "artifact_current",
      "knowledge_authority",
      "source_authority",
      "promotion",
      "release_authority",
      "statutory_approval"
    ],
    "promotion_rule": "EXECUTION_EVENT_MAY_SUPPORT_READBACK_OR_AUDIT_BUT_ONLY_AN_EXISTING_OWNER_NATIVE_PRODUCT_OR_RUNTIME_TRANSITION_MAY_UPDATE_PROJECT_OR_ARTIFACT_AUTHORITY",
    "implementation_ref": "00-governance/runtime/oleander_execution_runtime.py",
    "primitive_contract": "00-governance/runtime/OLEANDER_EXECUTION_RUNTIME_PRIMITIVES_v0.1.json"
  },
  "action_envelope_required_fields": [
    "action_id",
    "intent",
    "provider_id",
    "project_state_ref",
    "decision_object_id",
    "target_ref",
    "side_effect_class",
    "oleander_guard_decision",
    "provider_approval",
    "external_disclosure",
    "scoped_external_permission",
    "material_cost_or_blast_radius",
    "cost_or_blast_radius_authorized"
  ],
  "action_envelope_optional_fields": [
    "provider_session_id",
    "metadata"
  ],
  "intent_values": [
    "START",
    "RESUME",
    "CONTINUE",
    "RECOVER",
    "EXPLORE",
    "DEVELOP",
    "SYNTHESIZE",
    "COMPARE",
    "REVIEW",
    "REFRAME",
    "EXPLAIN",
    "DELEGATE",
    "STOP"
  ],
  "side_effect_classes": [
    "READ_ONLY",
    "LOCAL_MUTATION",
    "REMOTE_MUTATION",
    "AUTHORITY_MUTATION",
    "RELEASE_MUTATION"
  ],
  "normalized_outcomes": [
    "BLOCKED_BY_OLEANDER",
    "BLOCKED_BY_PROVIDER",
    "COMPLETED",
    "PARTIAL",
    "FAILED",
    "DEGRADED",
    "DEFERRED"
  ],
  "benchmark_result_states": [
    "CONTRACT_PASS",
    "CONTRACT_FAIL",
    "NATIVE_PROVIDER_SMOKE_PASS",
    "HOLD_MISSING_DEPENDENCY",
    "HOLD_MISSING_CREDENTIAL",
    "HOLD_MISSING_SERVER",
    "HOLD_PROVIDER_API_DRIFT"
  ],
  "hard_invariants": [
    "CONTINUE_DOES_NOT_IMPLY_RESUME",
    "RECOVER_PRESERVES_PARTIAL_RESULT_AS_PARTIAL",
    "PROVIDER_APPROVAL_CANNOT_OVERRIDE_OLEANDER_DENY",
    "PROVIDER_APPROVAL_MAY_NARROW_AN_OLEANDER_ALLOW",
    "PROVIDER_EVENTS_CANNOT_MUTATE_PROJECT_AUTHORITY",
    "PROVIDER_SWITCH_PRESERVES_PROJECT_DECISION_AND_ARTIFACT_IDENTITIES",
    "PROVIDER_OUTAGE_DEGRADES_ONLY_AFFECTED_EXECUTION_CAPABILITY",
    "TOOL_OR_PROVIDER_SUCCESS_DOES_NOT_PROVE_DESIGN_COMPLETION",
    "MATERIAL_MUTATION_WITHOUT_ACTUAL_READBACK_IS_PARTIAL",
    "STALE_RUNTIME_SNAPSHOT_CANNOT_PROVE_CURRENT_AVAILABILITY",
    "EXECUTION_SURFACE_AUTHORITY_CEILING_IS_EXECUTION_CAPABILITY_ONLY"
  ],
  "does_not_prove": [
    "provider_production_readiness",
    "design_quality",
    "professional_pass",
    "field_truth",
    "promotion",
    "external_pilot_value"
  ],
  "system_management_entry": {
    "gateway": "00-governance/runtime/oleander_system_gateway.py",
    "mcp_server": "00-governance/runtime/oleander_system_mcp.py",
    "context_schema": "00-governance/runtime/OLEANDER_SYSTEM_CONTEXT_ENVELOPE_v0.1.schema.json",
    "semantic_class": "CANDIDATE_PHASE2_RESOLUTION_AND_EXECUTION_ENTRYPOINT_NOT_AUTHORITY",
    "provider_context_may_not_become_project_state": true
  },
  "native_cos_mapping": {
    "adapter": "00-governance/runtime/OLEANDER_COS_HARNESS_ADAPTER_v0.2.json",
    "session_semantics": "EXECUTION_SESSION_ONLY",
    "compact_resume_semantics": "PROVIDER_SESSION_CONTINUITY_ONLY",
    "plugin_semantics": "EXECUTION_SURFACE_DISCOVERY_ONLY",
    "goal_loop_semantics": "CONTINUATION_POLICY_CONSUMER_ONLY",
    "project_state_owner": "OWNER_NATIVE_OLEANDER",
    "knowledge_owner": "OWNER_NATIVE_OLEANDER"
  },
  "supersedes": "00-governance/runtime/OLEANDER_RUNTIME_PROVIDER_CONTRACT_v0.1.json",
  "runtime_primitives": {
    "contract": "00-governance/runtime/OLEANDER_EXECUTION_RUNTIME_PRIMITIVES_v0.1.json",
    "implementation": "00-governance/runtime/oleander_execution_runtime.py",
    "execution_ledger": "APPEND_ONLY_RUNTIME_EVIDENCE_NOT_PROJECT_STATE",
    "action_runtime": "TYPED_EXECUTION_PIPELINE_BELOW_OLEANDER_ACTION_GUARD",
    "durable_job": "DURABLE_EXECUTION_STATE_NOT_PROJECT_STATE"
  },
  "environment_resolution": {
    "resolver": "00-governance/runtime/oleander_environment_resolver.py",
    "surface_schema": "00-governance/runtime/OLEANDER_EXECUTION_SURFACE_SCHEMA_v0.1.json",
    "stale_snapshot_rule": "STALE_MACHINE_LOCAL_SNAPSHOT_CANNOT_PRODUCE_AVAILABLE_ROUTE",
    "authority_mutation_transport_rule": "AUTHORITY_MUTATION_MAY_ROUTE_THROUGH_A_CAPABLE_EXECUTION_SURFACE_ONLY_AFTER_EXISTING_OWNER_NATIVE_AUTHORITY_GATE_IS_VERIFIED; THE_SURFACE_AUTHORITY_CEILING_REMAINS_EXECUTION_CAPABILITY_ONLY",
    "release_mutation_transport_rule": "RELEASE_MUTATION_MAY_ROUTE_ONLY_AFTER_EXISTING_RELEASE_AUTHORITY_IS_VERIFIED; ROUTING_DOES_NOT_TRANSFER_RELEASE_AUTHORITY_TO_THE_SURFACE"
  },
  "core_interface_contract": "00-governance/runtime/OLEANDER_CORE_INTERFACE_PRIMITIVES_v0.1.json",
  "v0_1_benchmark_compatibility": {
    "benchmark_ref": "00-governance/runtime/runtime_provider_spikes/results/OLEANDER_RUNTIME_PROVIDER_BENCHMARK_20260926.json",
    "benchmark_contract_ref": "00-governance/runtime/OLEANDER_RUNTIME_PROVIDER_CONTRACT_v0.1.json",
    "benchmark_fixture_only_fields": [
      "simulated_provider_outcome"
    ],
    "rule": "V0_1_BENCHMARK_REMAINS_IMMUTABLE_HISTORICAL_EVIDENCE_AND_IS_NOT_RELABELLED_AS_V0_2_CONFORMANCE"
  }
}
