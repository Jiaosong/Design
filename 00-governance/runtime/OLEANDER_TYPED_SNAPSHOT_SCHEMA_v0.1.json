{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "OLEANDER_TYPED_SNAPSHOT_SCHEMA_v0.1",
  "title": "OLEANDER Typed Snapshot v0.1",
  "type": "object",
  "required": ["schema", "snapshot_id", "objects"],
  "properties": {
    "schema": {"const": "OLEANDER_TYPED_SNAPSHOT_v0.1"},
    "snapshot_id": {"type": "string", "minLength": 1},
    "as_of": {"type": "string"},
    "project_id": {"type": ["string", "null"]},
    "objects": {
      "type": "array",
      "items": {"$ref": "#/$defs/object"}
    },
    "corpus_census": {"$ref": "#/$defs/census"},
    "support_packages": {
      "type": "array",
      "items": {"$ref": "#/$defs/supportPackage"}
    },
    "presentation_assets": {
      "type": "array",
      "items": {"$ref": "#/$defs/presentationAsset"}
    },
    "presentation_metrics": {
      "type": "object",
      "properties": {
        "independent_source_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "presentation_release": {"$ref": "#/$defs/presentationRelease"}
  },
  "$defs": {
    "object": {
      "type": "object",
      "required": ["id", "plane"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "plane": {"enum": ["KNOWLEDGE", "PROJECT", "RUNTIME_CONTROL"]},
        "semantic_class": {"type": "string"},
        "semantic_key": {"type": "string"},
        "scope_key": {"type": "string"},
        "is_current": {"type": "boolean"},
        "status": {"type": "string"},
        "retrieval_space": {"enum": ["CURRENT", "SUPPORT", "PROVENANCE", "EXCLUDED"]},
        "professional_state": {"type": "string"},
        "summary_badge": {"type": "string"},
        "review_evidence_class": {"enum": ["FULL_BODY_REVIEW_EVIDENCE", "GRAPH_ONLY", "LINEAGE_ONLY"]},
        "content_state": {"type": "string"},
        "bilingual_state": {"type": "string"},
        "independent_review_state": {"type": "string"},
        "full_body_integrity": {"type": "string"},
        "migration_state": {"type": "string"},
        "migration_origin_state": {"type": "string"},
        "classification_basis": {"type": ["string", "object", "array", "null"]},
        "project_failure_reason": {"type": "string"},
        "scope_kind": {"type": "string"},
        "granted_ceilings": {"type": "object"},
        "disposition": {"type": "string"},
        "acceptance_dimensions": {"type": "object"},
        "change_scope": {"type": "string"},
        "upstream_source_changed": {"type": "boolean"},
        "stale_effects": {"type": "array", "items": {"type": "string"}},
        "target_results": {"type": "object"},
        "summary_result": {"type": "string"},
        "aggregation_policy": {"type": ["string", "object", "null"]},
        "controlled_variable_class": {"type": "string"},
        "identity_equivalence_material": {"type": "boolean"},
        "identity_scope": {"type": "string"},
        "equivalence_policy": {"type": "string"},
        "derivation_changes_meaning_or_outcome": {"type": "boolean"},
        "semantic_interpreter": {"type": ["string", "object", "null"]},
        "required_input_dimensions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "resolved_input_dimensions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "derived_output_active": {"type": "boolean"},
        "transition_changes_downstream_behavior_or_outcome": {"type": "boolean"},
        "treated_as_material": {"type": "boolean"},
        "advances_state_machine": {"type": "boolean"},
        "subject_or_session_ref": {"type": ["string", "null"]},
        "n_way_model": {"type": "string"},
        "pairwise_acceptance_complete": {"type": "boolean"},
        "hub_invariant_result": {"type": "string"},
        "required_acceptance_dimensions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "failure_user_consequence_material": {"type": "boolean"},
        "recovery_path_status": {"type": "string"},
        "configuration_identity_mode": {"type": "string"},
        "candidate_revision": {"type": "string"},
        "check_target_revision": {"type": "string"},
        "current_use_revision": {"type": "string"},
        "equivalence_or_applicability_ref": {"type": ["string", "object", "null"]},
        "composed_change_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "component_assurance_complete": {"type": "boolean"},
        "integration_assurance_status": {"type": "string"},
        "base_or_interaction_context_changed": {"type": "boolean"},
        "candidate_assurance_status": {"type": "string"},
        "baseline_pointer_moved": {"type": "boolean"},
        "authorized_promotion_event_ref": {"type": ["string", "null"]},
        "rollback_mechanism": {"type": "string"},
        "reuses_prior_configuration_identity": {"type": "boolean"},
        "pointer_rewrite_authority_ref": {"type": ["string", "null"]},
        "lineage_preserved": {"type": "boolean"},
        "reactivated_prior_assurance": {"type": "boolean"},
        "post_rollback_applicability_review_ref": {"type": ["string", "null"]},
        "dependency_or_base_context_changed": {"type": "boolean"},
        "local_changeset_unchanged": {"type": "boolean"},
        "mechanical_merge_status": {"type": "string"},
        "semantic_integration_status": {"type": "string"},
        "semantic_integration_claimed_pass": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "census": {
      "type": "object",
      "required": ["as_of", "scope", "enumeration_basis", "counts"],
      "properties": {
        "as_of": {"type": "string"},
        "scope": {"type": ["string", "object", "array"]},
        "enumeration_basis": {"type": ["string", "object"]},
        "counts": {"type": "object"},
        "hard_ceiling": {"type": "boolean", "const": false}
      },
      "additionalProperties": true
    },
    "supportPackage": {
      "type": "object",
      "required": ["id", "artifacts"],
      "properties": {
        "id": {"type": "string"},
        "artifacts": {"type": "array", "items": {"type": "object"}},
        "semantic_object_count": {"type": "integer", "minimum": 0},
        "shared_semantic_responsibility": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "presentationAsset": {
      "type": "object",
      "required": ["presentation_asset_id"],
      "properties": {
        "presentation_asset_id": {"type": "string"},
        "semantic_source_id": {"type": "string"},
        "is_derivative": {"type": "boolean"},
        "source_role": {"type": "string"},
        "semantic_role": {"type": "string"},
        "truth_risk": {"enum": ["E0", "E1", "E2", "E3"]},
        "authorized_role_change": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "presentationRelease": {
      "type": "object",
      "required": ["id", "medium_readback"],
      "properties": {
        "id": {"type": "string"},
        "global_status": {"type": "string"},
        "medium_readback": {
          "type": "object",
          "additionalProperties": {"enum": ["PASS", "REVISE", "WAIT", "FAIL", "NOT_EVALUATED", "NOT_APPLICABLE"]}
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
