{
  "schema": "oleander.production-environment.v1",
  "version": "1.0",
  "implementation_revision": "1.0.5",
  "status": "ACTIVE_CURRENT",
  "scope": "OLEANDER_ALL_PROJECTS_ALL_CONVERSATIONS",
  "principle": "TOOL_AGNOSTIC_CAPABILITY_ROUTING",
  "hard_rules": [
    "NO_SINGLE_APP_IS_THE_OLEANDER_ENVIRONMENT",
    "FIGMA_IS_EXPLICIT_REQUEST_OR_EXISTING_FIGMA_SOURCE_ONLY_NOT_GENERIC_UI_ROUTE",
    "GENERIC_UI_TASK_MUST_NOT_PROBE_RECOMMEND_OR_CREATE_FIGMA",
    "BLENDER_SHARED_RUNTIME_IS_REUSABLE_ACROSS_OLEANDER",
    "RESOLVE_STICKY_USER_CONSTRAINTS_BEFORE_CAPABILITY_ROUTING",
    "ACTIVE_TOOL_DENY_BLOCKS_ADAPTER_SELECTION",
    "ACTIVE_CREATION_DENY_BLOCKS_GAP_DRIVEN_NEW_SKILL_METHOD_FRAMEWORK",
    "GENERIC_CONTINUE_DOES_NOT_REVOKE_ACTIVE_CONSTRAINTS",
    "FULL_OLEANDER_FLOW_REQUIRES_COMPLETION_GATE_BEFORE_COMPLETE_CLAIM",
    "VERIFY_CAPABILITY_BEFORE_EXECUTED",
    "USE_EXISTING_SKILL_AND_RUNTIME_BEFORE_CREATING_NEW_METHOD",
    "CURRENT_OLEANDER_SKILL_PRECEDES_SHARED_RUNTIME_SELECTION",
    "CANDIDATE_SHARED_RUNTIME_IS_NOT_DEFAULT_PRODUCTION_ELIGIBLE",
    "SOURCE_AUTHORITY_PRECEDES_TOOL_CHOICE",
    "NATIVE_EDITABLE_SOURCE_PRECEDES_FLATTENED_PREVIEW",
    "DESIGN_PRODUCTION_CONTRACT_BINDS_EDITABLE_MASTER_DERIVATIVE_DIMENSION_HANDOFF_AND_AI_SUPPLEMENT_BOUNDARIES",
    "BROWSER_VISIBLE_DOES_NOT_EQUAL_LOCAL_SOURCE_BYTES_AVAILABLE",
    "REFERENCE_MATERIALIZATION_PRECEDES_ONE_TO_ONE_RECONSTRUCTION_CLAIMS",
    "REPRODUCTION_MEANS_PIXEL_LEVEL_FIDELITY_BY_DEFAULT",
    "PIXEL_LEVEL_COMPARISON_REQUIRED_BEFORE_REPRODUCTION_PASS",
    "DIRECT_SOURCE_COPY_OR_REEXPORT_DOES_NOT_COUNT_AS_RECONSTRUCTION_EVIDENCE",
    "ARTIFACT_EXISTENCE_DOES_NOT_PROVE_DESIGN_QUALITY",
    "EVIDENCE_GATE_AND_DESIGN_QUALITY_GATE_ARE_INDEPENDENT",
    "INTERNAL_ARTIFACT_CRIT_DOES_NOT_EQUAL_INDEPENDENT_REVIEW",
    "ONE_LOGICAL_OBJECT_ONE_PRODUCTION_PR_BY_DEFAULT",
    "ACTIVE_SHARED_RUNTIME_INTERFACE_AND_JOB_LOCAL_MATERIALIZATION_ARE_SEPARATE_STATES",
    "JOB_LOCAL_BINARY_ABSENCE_MUST_RESOLVE_CURRENT_RUNTIME_REMATERIALIZATION_OR_SHARED_RUNNER_BEFORE_UNAVAILABLE",
    "NEW_SHARED_RUNTIME_IMPLEMENTATION_USES_90_SHARED_TOOLCHAINS_NOT_FROZEN_LEGACY_TOOLS_ROOT"
  ],
  "capability_states": [
    "NATIVE_AVAILABLE",
    "CONNECTOR_AVAILABLE",
    "SHARED_RUNTIME_AVAILABLE",
    "RUNNER_AVAILABLE",
    "FALLBACK_AVAILABLE",
    "PENDING_VERIFICATION",
    "UNAVAILABLE"
  ],
  "constraint_preflight": {
    "resolver": "00-governance/runtime/OLEANDER_DEFAULT_SKILL_RESOLVER_v1.2.json",
    "resolver_implementation_revision": "1.2.2",
    "required_before_tool_probe": true,
    "inherit_active_constraints_across_generic_followups": true,
    "explicit_revocation_only": true,
    "no_image_generation_effect": "DO_NOT_SELECT_OR_CALL_GENERATIVE_IMAGE_TOOL_OR_ADAPTER",
    "no_new_skill_effect": "DO_NOT_CREATE_NEW_SKILL; COMPOSE_EXISTING_OWNER_OR_HOLD",
    "full_flow_effect": "DO_NOT_REPORT_COMPLETE_UNTIL_ALL_APPLICABLE_FLOW_PHASES_PASS_OR_ARE_EXPLICITLY_NOT_APPLICABLE"
  },
  "design_production_contract": {
    "status": "ACTIVE_CURRENT_SUBORDINATE_CONTRACT",
    "contract": "00-governance/runtime/OLEANDER_DESIGN_ENVIRONMENT_PRODUCTION_CONTRACT_v1.0.json",
    "role": "IMPLEMENTATION_CONTRACT_NOT_NEW_METHOD_SKILL_GATE_OR_AUTHORITY",
    "scope": "EDITABLE_MASTER_SOURCE_DERIVATIVE_SEPARATION_DIMENSION_GEOMETRY_AUTHORITY_TEXT_VECTOR_EDITABILITY_CROSS_SOFTWARE_HANDOFF_AI_GENERATED_SUPPLEMENT_BOUNDARY",
    "inheritance_rule": "APPLY_TO_MATERIAL_DESIGN_PRODUCTION_AFTER_AUTHORITY_AND_EXISTING_SKILL_RESOLUTION_UNLESS_PROJECT_AUTHORITY_EXPLICITLY_OVERRIDES"
  },
  "resolver_order": [
    "READ_CURRENT_AUTHORITY_AND_SOURCE_AUTHORITY",
    "RESOLVE_STICKY_EXECUTION_CONSTRAINTS",
    "ENFORCE_ACTIVE_TOOL_OUTPUT_CREATION_AND_PROCESS_LOCKS",
    "RESOLVE_EXISTING_OLEANDER_SKILL",
    "IDENTIFY_REQUIRED_NATIVE_OUTPUT_AND_FIDELITY",
    "APPLY_CURRENT_DESIGN_PRODUCTION_CONTRACT_WHEN_MATERIAL_DESIGN_PRODUCTION_IS_IN_SCOPE",
    "IF_REFERENCE_RECONSTRUCTION_RESOLVE_REFERENCE_MATERIALIZATION_GATE",
    "PROBE_CURRENT_CONVERSATION_CAPABILITIES",
    "RESOLVE_ACTIVE_SHARED_OLEANDER_RUNTIME_INTERFACE_THEN_JOB_BINDING_REMATERIALIZATION_OR_SHARED_RUNNER",
    "SELECT_BEST_FIT_ADAPTER_WITHIN_ACTIVE_CONSTRAINTS",
    "USE_CANDIDATE_SHARED_RUNTIME_ONLY_FOR_VALIDATION_TRAINING_SUPPORT_OR_EXPLICITLY_LABELED_BOUNDED_PROJECT_REAPPLICATION",
    "USE_EQUIVALENT_FALLBACK_WHEN_IT_PRESERVES_REQUIRED_INFORMATION",
    "MARK_ONLY_THE_UNAVAILABLE_STEP_PENDING",
    "VERIFY_FLOW_COMPLETION_GATE_BEFORE_CLOSURE"
  ],
  "reference_materialization": {
    "status": "ACTIVE_CURRENT_GATE",
    "contract": "00-governance/runtime/OLEANDER_REFERENCE_MATERIALIZATION_GATE_v1.0.json",
    "human_contract": "00-governance/runtime/OLEANDER_REFERENCE_MATERIALIZATION_GATE_v1.0.md",
    "canonical_adapter": "90-shared/toolchains/reference-materialization/materialize_reference.py",
    "invariant": "BROWSER_VISIBLE_DOES_NOT_EQUAL_LOCAL_SOURCE_BYTES_AVAILABLE",
    "fidelity_invariant": "REPRODUCTION_MEANS_PIXEL_LEVEL_FIDELITY_BY_DEFAULT",
    "required_sequence": [
      "SOURCE_AUTHORITY_FOUND",
      "SOURCE_BYTES_MATERIALIZED",
      "SOURCE_HASHED",
      "REFERENCE_FRAME_EXTRACTED",
      "REFERENCE_SCALE_LOCKED",
      "COMPARISON_RUNTIME_VERIFIED",
      "INDEPENDENT_ONE_TO_ONE_RECONSTRUCTION",
      "PIXEL_LEVEL_COMPARISON",
      "MISMATCH_REPAIR",
      "RETEST"
    ],
    "pass_rule": "IF_PIXEL_LEVEL_COMPARISON_IS_NOT_EXECUTED_OR_MATERIAL_PIXEL_MISMATCH_REMAINS_REPRODUCTION_PASS_IS_FORBIDDEN",
    "deterministic_target": "ZERO_PIXEL_DIFFERENCE_WHEN_SHARED_DETERMINISTIC_RENDERING_MAKES_IT_TECHNICALLY_ACHIEVABLE",
    "fail_closed_rule": "IF_SOURCE_BYTES_REFERENCE_FRAME_COMPARISON_RUNTIME_OR_PIXEL_LEVEL_EVIDENCE_CANNOT_BE_LOCKED_FIDELITY_GATE_HOLD_AND_REPRODUCTION_PASS_FORBIDDEN"
  },
  "adapters": {
    "research_knowledge": {
      "preferred": ["Web", "official archives", "PDF", "Notion", "GitHub", "Google Drive"],
      "status": "DETECT_PER_RUN"
    },
    "reference_materialization": {
      "preferred": ["mounted conversation file", "public direct URL download", "connector-native materialization", "exact GitHub/Google Drive file retrieval", "90-shared/toolchains/reference-materialization/materialize_reference.py"],
      "status": "DETECT_PER_RUN",
      "evidence_boundary": "source bytes and hashes prove materialization/reproducibility only, not authority, rights, fidelity or design quality"
    },
    "deterministic_data": {
      "preferred": ["Python", "GDAL", "GeoPandas", "QGIS when verified", "deterministic geometry and image tools"],
      "status": "DETECT_PER_RUN",
      "evidence_boundary": "calculation or export success does not prove aesthetic quality"
    },
    "two_d_vector_layout": {
      "preferred": ["SVG", "HTML/CSS", "PDF/vector tooling"],
      "status": "DETECT_PER_RUN",
      "figma_policy": "EXPLICIT_REQUEST_OR_EXISTING_FIGMA_SOURCE_ONLY_DO_NOT_PROBE_FOR_GENERIC_UI_OR_VECTOR_TASK"
    },
    "three_d_spatial_product": {
      "preferred": ["Blender shared runtime", "Rhino/Grasshopper when verified", "CAD/BIM/FreeCAD when verified"],
      "status": "DETECT_PER_RUN",
      "blender_runtime_contract": "00-governance/runtime/OLEANDER_BLENDER_RUNTIME_v1.0.json",
      "blender_invocation": "use OLEANDER_BLENDER_RUNTIME_v1.0 resolver; tools/oleander-runtime/blender.sh is Legacy compatibility adapter only",
      "authority_rule": "derived render or mesh does not silently replace authoritative geometry/source"
    },
    "materials_cmf_render": {
      "preferred": ["Blender/Cycles", "measured/reference material data", "image tools for supplementary visualization"],
      "status": "DETECT_PER_RUN"
    },
    "motion_video": {
      "preferred": ["Blender animation/compositor", "FFmpeg when verified", "browser motion when appropriate"],
      "status": "DETECT_PER_RUN"
    },
    "web_interaction": {
      "preferred": ["HTML/CSS/JS", "browser runtime", "Playwright/Chromium when verified"],
      "status": "DETECT_PER_RUN"
    },
    "visual_readback": {
      "preferred": ["actual screenshots", "rendered pixels", "browser readback", "model render/viewport capture", "PDF page render"],
      "status": "DETECT_PER_RUN",
      "minimum": ["FIRST_READ_OR_THUMBNAIL", "DETAIL_OR_NEAR_READ"]
    }
  },
  "shared_runtime_lifecycle": {
    "default_production_requires": "ACTIVE",
    "candidate_allowed_contexts": ["VALIDATION", "TRAINING", "SUPPORT", "BOUNDED_PROJECT_REAPPLICATION_WITH_EXPLICIT_CANDIDATE_LABEL"],
    "candidate_default_production_eligible": false,
    "candidate_must_not_be_sole_final_native_output_authority": true
  },
  "review_and_transaction_policy": {
    "internal_artifact_first_crit": "PRODUCER_CONTEXT_ALLOWED_REVISE_HOLD_ONLY_NO_INDEPENDENT_KEEP",
    "independent_review_fields": ["producer_id", "reviewer_id", "review_input_artifact_id", "review_input_hash", "reviewer_independence_state", "review_verdict", "promotion_authority"],
    "independence_rule": "INDEPENDENT_REQUIRES_REVIEWER_ID_DIFFERENT_FROM_PRODUCER_ID_AND_EXACT_REVIEW_INPUT_HASH",
    "missing_identity_rule": "TREAT_AS_INTERNAL_ARTIFACT_FIRST_PROFESSIONAL_CRIT",
    "default_transaction": "ONE_PRODUCTION_PR_FOR_IMPLEMENTATION_READBACK_INTERNAL_CRIT_REPAIR_RETEST",
    "review_only_pr_default": "FORBIDDEN",
    "independent_review_surface": "PR_REVIEW_OR_ISOLATED_REVIEW_RECORD_BOUND_TO_EXACT_ARTIFACT_HASH",
    "transaction_closed_definition": "CURRENT_MUTATION_OR_REPAIR_TRANSACTION_PERSISTED",
    "flow_closed_definition": "ALL_REQUIRED_APPLICABLE_PHASES_COMPLETE_WITH_NO_FAIL_OR_HOLD"
  },
  "blender_shared_runtime": {
    "status": "ACTIVE_RUNTIME_INTERFACE",
    "scope": "OLEANDER_ALL_PROJECTS",
    "source": "00-governance/runtime/OLEANDER_BLENDER_RUNTIME_v1.0.json",
    "project_specific_absolute_paths": "FORBIDDEN",
    "conversation_rule": "Every OLEANDER conversation may route Blender work through the shared runtime contract; the individual run must still verify that its execution surface can invoke the runtime before claiming EXECUTED.",
    "interface_state_rule": "ACTIVE_RUNTIME_INTERFACE_IS_DISTINCT_FROM_JOB_LOCAL_MATERIALIZATION",
    "job_binding_states": ["MATERIALIZED", "NEEDS_REMATERIALIZATION", "RUNNER_RESOLVED", "EXECUTION_FAILED"],
    "current_runtime_implementation_namespace": "90-shared/toolchains/blender-runtime/",
    "preferred_rematerialization": "90-shared/toolchains/blender-runtime/ensure-blender-5.2.sh",
    "preferred_shared_runner": ".github/workflows/oleander-shared-blender-runner.yml",
    "legacy_compatibility_wrappers": ["tools/oleander-runtime/activate-blender.sh", "tools/oleander-runtime/blender.sh"],
    "legacy_namespace_rule": "FROZEN_TOOLS_ROOT_MAY_RETAIN_EXISTING_COMPATIBILITY_ADAPTERS_BUT_MUST_NOT_RECEIVE_NEW_RUNTIME_IMPLEMENTATION_OR_BOOTSTRAP_LOGIC",
    "unavailable_gate": "ONLY_AFTER_CURRENT_RUNTIME_RESOLVER_REMATERIALIZATION_AND_ALLOWED_SHARED_RUNNER_HAVE_ACTUALLY_FAILED"
  },
  "figma": {
    "role": "EXPLICIT_REQUEST_ONLY_HANDOFF_ADAPTER",
    "activation_gate": "EXPLICIT_FIGMA_DELIVERY_OR_EXISTING_FIGMA_SOURCE",
    "probe_policy": "DO_NOT_PROBE_RECOMMEND_OR_CREATE_FOR_GENERIC_UI_VECTOR_PROTOTYPING_OR_DESIGN_SYSTEM_TASKS",
    "use_when": [
      "the user or Project Authority explicitly requires editable Figma delivery",
      "an existing authoritative Figma file or project must be continued or repaired",
      "the connector is actually exposed and current capacity permits the bounded handoff"
    ],
    "do_not": [
      "probe Figma merely because the task says UI UX interface prototype component or design system",
      "recommend or route generic UI work to Figma when repo-native HTML CSS JS SVG can own the required native output",
      "create a new Figma file unless the activation gate is satisfied",
      "block a project because Figma is absent",
      "treat Figma as Source Authority by default",
      "substitute node count or export existence for visual review"
    ]
  },
  "execution_receipt": {
    "current_contract": "00-governance/runtime/OLEANDER_EXECUTION_RECEIPT_v1.0.json",
    "human_contract": "00-governance/runtime/OLEANDER_EXECUTION_RECEIPT_v1.0.md",
    "policy_revision": "1.1",
    "instance_directory": "00-governance/runtime/receipts/",
    "current_rule": "Use the Current Execution Receipt contract as the single instance schema. New receipts must record sticky constraint_lock and flow_completion; only explicitly allowlisted pre-policy receipts may omit them.",
    "evidence_record_rule": "VALIDATION_RETEST_BROWSER_RESULT_AND_REVIEW_FILES_ARE_EVIDENCE_RECORDS_NOT_ALTERNATE_EXECUTION_RECEIPT_SCHEMAS",
    "legacy_minimum_subset": ["TASK", "AUTHORITY", "SKILL_RESOLVED", "REQUIRED_OUTPUT", "CAPABILITY_STATE", "ADAPTER_SELECTED", "VERSION_OR_PATH_IF_VERIFIED", "EXECUTED_OR_PENDING", "READBACK_STATE", "EVIDENCE_GATE", "DESIGN_QUALITY_GATE", "DOES_NOT_PROVE"],
    "reference_reconstruction_additional_fields": ["SOURCE_LOCATOR", "SOURCE_BYTES_STATE", "SOURCE_SHA256", "REFERENCE_FRAME_STATE", "PAGE_OR_FRAME", "SCALE_OR_DPI", "RENDERER", "REFERENCE_FRAME_SHA256", "COMPARISON_RUNTIME", "PIXEL_DIFF_STATE", "PIXEL_DIFF_METRIC", "MISMATCH_STATE", "FIDELITY_GATE"],
    "boundary": "Legacy minimum subset is compatibility provenance only and does not define a second receipt schema."
  }
}
