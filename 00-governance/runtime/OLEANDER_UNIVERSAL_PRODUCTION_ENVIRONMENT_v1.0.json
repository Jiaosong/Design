{
  "schema": "oleander.production-environment.v1",
  "version": "1.0",
  "status": "ACTIVE_CURRENT",
  "scope": "OLEANDER_ALL_PROJECTS_ALL_CONVERSATIONS",
  "principle": "TOOL_AGNOSTIC_CAPABILITY_ROUTING",
  "hard_rules": [
    "NO_SINGLE_APP_IS_THE_OLEANDER_ENVIRONMENT",
    "FIGMA_IS_OPTIONAL_NOT_DEFAULT",
    "BLENDER_SHARED_RUNTIME_IS_REUSABLE_ACROSS_OLEANDER",
    "VERIFY_CAPABILITY_BEFORE_EXECUTED",
    "USE_EXISTING_SKILL_AND_RUNTIME_BEFORE_CREATING_NEW_METHOD",
    "SOURCE_AUTHORITY_PRECEDES_TOOL_CHOICE",
    "NATIVE_EDITABLE_SOURCE_PRECEDES_FLATTENED_PREVIEW",
    "BROWSER_VISIBLE_DOES_NOT_EQUAL_LOCAL_SOURCE_BYTES_AVAILABLE",
    "REFERENCE_MATERIALIZATION_PRECEDES_ONE_TO_ONE_RECONSTRUCTION_CLAIMS",
    "ARTIFACT_EXISTENCE_DOES_NOT_PROVE_DESIGN_QUALITY",
    "EVIDENCE_GATE_AND_DESIGN_QUALITY_GATE_ARE_INDEPENDENT"
  ],
  "capability_states": [
    "NATIVE_AVAILABLE",
    "CONNECTOR_AVAILABLE",
    "SHARED_RUNTIME_AVAILABLE",
    "RUNNER_AVAILABLE",
    "FALLBACK_AVAILABLE",
    "PENDING_VERIFICATION",
    "UNAVAILABLE"
  ],
  "resolver_order": [
    "READ_CURRENT_AUTHORITY_AND_SOURCE_AUTHORITY",
    "RESOLVE_EXISTING_OLEANDER_SKILL",
    "IDENTIFY_REQUIRED_NATIVE_OUTPUT_AND_FIDELITY",
    "IF_REFERENCE_RECONSTRUCTION_RESOLVE_REFERENCE_MATERIALIZATION_GATE",
    "PROBE_CURRENT_CONVERSATION_CAPABILITIES",
    "PROBE_SHARED_OLEANDER_RUNTIME_OR_RUNNER",
    "SELECT_BEST_FIT_ADAPTER",
    "USE_EQUIVALENT_FALLBACK_WHEN_IT_PRESERVES_REQUIRED_INFORMATION",
    "MARK_ONLY_THE_UNAVAILABLE_STEP_PENDING"
  ],
  "reference_materialization": {
    "status": "ACTIVE_CURRENT_GATE",
    "contract": "00-governance/runtime/OLEANDER_REFERENCE_MATERIALIZATION_GATE_v1.0.json",
    "human_contract": "00-governance/runtime/OLEANDER_REFERENCE_MATERIALIZATION_GATE_v1.0.md",
    "canonical_adapter": "tools/oleander-runtime/materialize_reference.py",
    "invariant": "BROWSER_VISIBLE_DOES_NOT_EQUAL_LOCAL_SOURCE_BYTES_AVAILABLE",
    "required_sequence": [
      "SOURCE_AUTHORITY_FOUND",
      "SOURCE_BYTES_MATERIALIZED",
      "SOURCE_HASHED",
      "REFERENCE_FRAME_EXTRACTED",
      "REFERENCE_SCALE_LOCKED",
      "COMPARISON_RUNTIME_VERIFIED"
    ],
    "fail_closed_rule": "IF_SOURCE_BYTES_OR_REFERENCE_FRAME_CANNOT_BE_LOCKED_FIDELITY_GATE_HOLD_AND_REPRODUCTION_PASS_FORBIDDEN"
  },
  "adapters": {
    "research_knowledge": {
      "preferred": ["Web", "official archives", "PDF", "Notion", "GitHub", "Google Drive"],
      "status": "DETECT_PER_RUN"
    },
    "reference_materialization": {
      "preferred": ["mounted conversation file", "public direct URL download", "connector-native materialization", "exact GitHub/Google Drive file retrieval", "tools/oleander-runtime/materialize_reference.py"],
      "status": "DETECT_PER_RUN",
      "evidence_boundary": "source bytes and hashes prove materialization/reproducibility only, not authority, rights, fidelity or design quality"
    },
    "deterministic_data": {
      "preferred": ["Python", "GDAL", "GeoPandas", "QGIS when verified", "deterministic geometry and image tools"],
      "status": "DETECT_PER_RUN",
      "evidence_boundary": "calculation or export success does not prove aesthetic quality"
    },
    "two_d_vector_layout": {
      "preferred": ["SVG", "HTML/CSS", "PDF/vector tooling", "Figma when explicitly useful and verified"],
      "status": "DETECT_PER_RUN",
      "figma_policy": "OPTIONAL_ADAPTER_NOT_REQUIRED_NOT_DEFAULT"
    },
    "three_d_spatial_product": {
      "preferred": ["Blender shared runtime", "Rhino/Grasshopper when verified", "CAD/BIM/FreeCAD when verified"],
      "status": "DETECT_PER_RUN",
      "blender_runtime_contract": "00-governance/runtime/OLEANDER_BLENDER_RUNTIME_v1.0.json",
      "blender_invocation": "bash tools/oleander-runtime/blender.sh <blender args>",
      "authority_rule": "derived render or mesh does not silently replace authoritative geometry/source"
    },
    "materials_cmf_render": {
      "preferred": ["Blender/Cycles", "measured/reference material data", "image tools for supplementary visualization"],
      "status": "DETECT_PER_RUN"
    },
    "motion_video": {
      "preferred": ["Blender animation/compositor", "FFmpeg when verified", "browser motion when appropriate"],
      "status": "DETECT_PER_RUN"
    },
    "web_interaction": {
      "preferred": ["HTML/CSS/JS", "browser runtime", "Playwright/Chromium when verified"],
      "status": "DETECT_PER_RUN"
    },
    "visual_readback": {
      "preferred": ["actual screenshots", "rendered pixels", "browser readback", "model render/viewport capture", "PDF page render"],
      "status": "DETECT_PER_RUN",
      "minimum": ["FIRST_READ_OR_THUMBNAIL", "DETAIL_OR_NEAR_READ"]
    }
  },
  "blender_shared_runtime": {
    "status": "ACTIVE_RUNTIME_INTERFACE",
    "scope": "OLEANDER_ALL_PROJECTS",
    "source": "00-governance/runtime/OLEANDER_BLENDER_RUNTIME_v1.0.json",
    "project_specific_absolute_paths": "FORBIDDEN",
    "preferred_wrapper": "tools/oleander-runtime/blender.sh",
    "conversation_rule": "Every OLEANDER conversation may route Blender work through the shared runtime contract; the individual run must still verify that its execution surface can invoke the runtime before claiming EXECUTED."
  },
  "figma": {
    "role": "OPTIONAL_SPECIALIST_ADAPTER",
    "use_when": [
      "the project explicitly requires editable Figma delivery",
      "a verified Figma connector materially improves component or interface work",
      "visual readback is actually available"
    ],
    "do_not": [
      "block a project because Figma is absent",
      "treat Figma as Source Authority by default",
      "substitute node count or export existence for visual review"
    ]
  },
  "execution_receipt": {
    "required_fields": [
      "TASK",
      "AUTHORITY",
      "SKILL_RESOLVED",
      "REQUIRED_OUTPUT",
      "CAPABILITY_STATE",
      "ADAPTER_SELECTED",
      "VERSION_OR_PATH_IF_VERIFIED",
      "EXECUTED_OR_PENDING",
      "READBACK_STATE",
      "EVIDENCE_GATE",
      "DESIGN_QUALITY_GATE",
      "DOES_NOT_PROVE"
    ],
    "reference_reconstruction_additional_fields": [
      "SOURCE_LOCATOR",
      "SOURCE_BYTES_STATE",
      "SOURCE_SHA256",
      "REFERENCE_FRAME_STATE",
      "PAGE_OR_FRAME",
      "SCALE_OR_DPI",
      "RENDERER",
      "REFERENCE_FRAME_SHA256",
      "COMPARISON_RUNTIME",
      "FIDELITY_GATE"
    ]
  }
}
