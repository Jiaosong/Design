    "no_material_delta_rule": "DO_NOT_CREATE_A_NEW_RECEIPT_OR_PROJECT_STATE_OBJECT_SOLELY_TO_RECORD_A_NO_DELTA_CHAT_TURN",
    "control_card_reuse": [
