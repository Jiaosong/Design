  "sticky_execution_constraints": {
    "required": true,
    "resolve_before_owner_or_tool_selection": true,
    "sources_in_precedence_order": [
      "LATEST_EXPLICIT_USER_INSTRUCTION",
      "CURRENT_TASK_EXPLICIT_CONSTRAINTS",
      "ACTIVE_EXECUTION_RECEIPT_FOR_SAME_TASK",
      "CURRENT_PROJECT_AUTHORITY_AND_DECISIONS"
    ],
    "constraint_types": [
      "TOOL_DENY",
      "OUTPUT_DENY",
      "CREATION_DENY",
      "OWNER_REQUIRE",
      "PROCESS_REQUIRE",
      "REVIEW_REQUIRE"
    ],
    "normalized_rules": [
      "NO_IMAGE_GENERATION",
      "NO_NEW_SKILL",
      "NO_NEW_METHOD",
      "NO_NEW_FRAMEWORK",
      "USE_EXISTING_OLEANDER_METHODS_AND_SKILLS",
      "FULL_OLEANDER_FLOW_REQUIRED",
      "NO_PRODUCER_SELF_PROMOTION"
    ],
    "inheritance_rule": "ACTIVE_CONSTRAINTS_PERSIST_ACROSS_CONTINUE_OPTIMIZE_REVISE_AND_FOLLOWUP_TURNS_WITHIN_THE_SAME_TASK",
    "revocation_rule": "ONLY_A_LATER_EXPLICIT_USER_INSTRUCTION_THAT_DIRECTLY_REVOKES_OR_CHANGES_THE_NAMED_CONSTRAINT_MAY_RELEASE_IT",
    "generic_continue_does_not_revoke": true,
    "implicit_tool_need_does_not_revoke": true,
    "skill_recommendation_does_not_revoke": true,
    "project_switch_requires_re_resolution": true,
    "hard_effects": {
      "NO_IMAGE_GENERATION": "BLOCK_IMAGE_GENERATION_TOOLS_AND_GENERATIVE_IMAGE_ADAPTERS; USE_NON_GENERATIVE_NATIVE_VECTOR_3D_LAYOUT_OR_EXISTING_SOURCE_WORKFLOWS; IF_REQUIRED_OUTPUT_CANNOT_BE_PRODUCED_WITHOUT_GENERATION_RETURN_HOLD_INSTEAD_OF_GENERATING",
      "NO_NEW_SKILL": "BLOCK_NEW_SKILL_CREATION_PROMOTION_OR_SIDECAR_SKILL; USE_EXISTING_OWNER_COMPOSITION_FALLBACK_OR_HOLD",
      "NO_NEW_METHOD": "BLOCK_NEW_NOTION_METHOD_CREATION; REUSE_CURRENT_METHOD_TOOL_PRACTICE_OR_RECORD_GAP_WITHOUT_CREATING",
      "NO_NEW_FRAMEWORK": "BLOCK_PARALLEL_FRAMEWORK_SCHEMA_OR_ROUTER_CREATION_UNLESS_USER_EXPLICITLY_REVOKES",
      "USE_EXISTING_OLEANDER_METHODS_AND_SKILLS": "ACTUAL_CURRENT_METHOD_SKILL_CAPABILITY_FILES_MUST_BE_READ_BEFORE_EXECUTION; VERBAL_CLAIM_OF_REUSE_IS_INSUFFICIENT",
      "FULL_OLEANDER_FLOW_REQUIRED": "ALL_APPLICABLE_FLOW_PHASES_MUST_REACH_PASS_OR_EXPLICIT_NOT_APPLICABLE_WITH_REASON_BEFORE_CLOSED_OR_COMPLETE_MAY_BE_REPORTED"
    }
  },
