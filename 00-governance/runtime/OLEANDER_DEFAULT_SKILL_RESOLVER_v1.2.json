  "stage_composition_policy": {
    "purpose": "RESOLVE_STAGE_AND_DECISION_SCOPED_CAPABILITY_COMPOSITION_WITHOUT_COLLAPSING_COMPLEX_DESIGN_INTO_A_FIXED_ONE_OR_TWO_SKILL_ROUTE",
    "minimum_sufficient_means": "SMALLEST_OWNER_SET_THAT_COVERS_ALL_MATERIAL_CAPABILITY_ROLES_NATIVE_OUTPUTS_READBACKS_AUTHORITY_BOUNDARIES_AND_TRIGGERED_REVIEWS_FOR_THE_ACTIVE_STAGE_DECISION_OUTPUT_SCOPE",
    "minimum_sufficient_does_not_mean": "MINIMUM_SKILL_COUNT",
    "resolve_sequence": [
      "READ_PROFESSIONAL_STAGE_AND_PROFESSIONAL_QUESTION_OR_DECISION_OBJECT",
      "RESOLVE_ACTIVE_PROFESSIONAL_STAGE_KNOWLEDGE_INPUTS",
      "BIND_AND_VALIDATE_OPERATIONAL_KNOWLEDGE_MOUNT",
      "RESOLVE_REQUIRED_CAPABILITY_ROLES",
      "SELECT_CURRENT_EXECUTION_OWNERS_OR_SKILLS",
      "HOLD_CANDIDATE_SKILL_OR_CANDIDATE_BODY_AS_NON_CURRENT_UNLESS_EXPLICIT_LEGAL_PROJECT_SPECIALIST_OVERRIDE",
      "DEDUPE_ONLY_AFTER_CAPABILITY_COVERAGE_IS_PROVEN",
      "BIND_AND_EXECUTE_REQUIRED_NATIVE_OUTPUTS",
      "ACTUAL_READBACK",
      "INDEPENDENT_REVIEW_WHEN_TRIGGERED",
      "STAGE_CLOSURE_GATE"
    ],
    "recompute_on": [
      "PROFESSIONAL_STAGE_CHANGE",
      "MATERIAL_DECISION_OBJECT_OR_CLAIM_CHANGE",
      "REQUIRED_NATIVE_OUTPUT_OR_READBACK_CHANGE",
      "INTERFACE_HANDOFF_OR_MATURITY_CHANGE",
      "OWNER_OR_TOOL_UNAVAILABLE_OR_INSUFFICIENT",
      "HOLD_RELEASE_CONDITION_ACTIVATES_NEW_VERIFICATION_PATH",
      "ACTUAL_READBACK_PROVES_CAPABILITY_GAP"
    ],
    "stage_transition_rule": "DO_NOT_INHERIT_PRIOR_STAGE_OWNER_SET_BY_DEFAULT; PRESERVE_ONLY_OWNERS_STILL_REQUIRED_BY_ACTIVE_CAPABILITY_OUTPUT_BINDINGS",
    "multi_skill_required_when": [
      "NO_SINGLE_CURRENT_OWNER_COVERS_ALL_MATERIAL_CAPABILITY_ROLES",
      "DIFFERENT_NATIVE_OUTPUTS_REQUIRE_DIFFERENT_AUTHORITATIVE_EXECUTION_OWNERS",
      "SPECIALIST_OR_TECHNICAL_AUTHORITY_MUST_REMAIN_SEPARATE_FROM_GENERAL_DESIGN_EXECUTION",
      "INDEPENDENT_REVIEW_MUST_REMAIN_SEPARATE_FROM_PRODUCER",
      "PARALLEL_OR_SEQUENCED_OUTPUTS_REQUIRE_TYPED_HANDOFFS_BETWEEN_DISTINCT_OWNERS"
    ],
    "single_owner_allowed_when": "ONE_CURRENT_CALLABLE_OWNER_GENUINELY_COVERS_ALL_ACTIVE_CAPABILITIES_NATIVE_OUTPUTS_READBACKS_AND_AUTHORITY_BOUNDARIES_WITHOUT_LOSS",
    "selective_reroute_rule": "REUSE_UNAFFECTED_OUTPUTS_AND_OWNERS; REROUTE_ONLY_AFFECTED_CAPABILITY_OUTPUT_BINDINGS; DO_NOT_RESTART_FULL_SKILL_STACK",
    "forbidden_compressions": [
