      "AUTHORITY_FINGERPRINT_MISMATCH",
      "SOURCE_OR_DESIGN_AUTHORITY_CHANGED",
      "CURRENT_NATIVE_MASTER_OR_WRITE_FRONTIER_CHANGED_EXTERNALLY",
      "DEPENDENCY_STALE_OR_RETEST_REQUIRED",
      "CHECKPOINT_MISSING_OR_LAST_ARTIFACT_NOT_READBACK_VERIFIED",
      "CHECKPOINT_SEQUENCE_ADVANCED_BY_ANOTHER_EXECUTOR"
    ],
    "context_switch_or_compression_is_not_authority_change": true,
    "resume_behavior": "SKIP_ALREADY_VERIFIED_COMPLETED_NODES_AND_EXECUTE_NEXT_ALLOWED_ACTION",
    "blind_repeat_completed_mutation_forbidden": true,
    "blocked_behavior": "RECHECK_ONLY_THE_DECLARED_RELEASE_CONDITION_WHEN_CHECKABLE; DO_NOT_BLINDLY_REPEAT_THE_FAILED_MUTATION",
    "closed_behavior": "GENERIC_CONTINUE_DOES_NOT_REOPEN_CLOSED_TASK_WITHOUT_NEW_EXPLICIT_SCOPE_OR_REOPEN_DECISION",
    "checkpoint_write_trigger": [
