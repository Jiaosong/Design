  "continuous_execution_policy": {
    "purpose": "AUTO_ADVANCE_READY_NODES_WITHIN_CURRENT_EXECUTION_TURN",
    "default_for_intents": [
      "CONTINUE",
      "PUSH_FORWARD",
      "EXECUTE",
      "REPAIR",
      "OPTIMIZE"
    ],
    "no_artificial_one_node_stop": true,
    "advance_requires": [
      "PREVIOUS_NODE_EXECUTED",
      "APPLICABLE_ACTUAL_READBACK_PASS_OR_TYPED_HANDOFF_ACCEPTED",
      "NEXT_NODE_READY",
      "AUTHORITY_FINGERPRINT_STILL_VALID",
      "ACTIVE_CONSTRAINTS_UNCHANGED_OR_EXPLICITLY_RE_RESOLVED",
      "SIDE_EFFECT_WITHIN_ALREADY_AUTHORIZED_CEILING",
      "EXPECTED_CHECKPOINT_SEQUENCE_STILL_CURRENT_FOR_MUTATION",
      "NO_STOP_CONDITION"
    ],
    "loop_sequence": [
      "EXECUTE_READY_NODE",
      "SELECTIVE_READBACK",
      "REPAIR_AND_RETEST_IF_LEGAL_AND_NEEDED",
      "UPDATE_EXISTING_CHECKPOINT_IF_TRIGGERED",
      "RESOLVE_NEXT_READY_NODE",
      "CONTINUE_WHILE_ALLOWED"
    ],
    "stop_conditions": [
      "FLOW_COMPLETION_GATE_PASS",
      "GENUINE_BLOCKER",
      "AUTHORITY_CONFLICT_OR_AMBIGUOUS_FRONTIER",
      "CONCURRENT_CHECKPOINT_ADVANCE",
      "USER_DESIGN_OR_SCOPE_DECISION_REQUIRED",
      "IRREVERSIBLE_OR_HIGHER_SIDE_EFFECT_ACTION_NOT_ALREADY_AUTHORIZED",
      "MISSING_UNRECOVERABLE_SOURCE",
      "FUTURE_CONDITION_OR_EXTERNAL_WAIT_REQUIRED",
      "REQUIRED_INDEPENDENT_REVIEW_UNAVAILABLE",
      "TOOL_OR_RUNTIME_HARD_LIMIT"
    ],
    "side_effect_ceiling_inherits_user_and_current_authority": true,
    "failure_rule": "ROOT_CAUSE_REPAIR_RETEST_THEN_CONTINUE_IF_NEXT_NODE_IS_READY; NO_BLIND_RETRY_LOOP",
    "parallelism_rule": "ONLY_INDEPENDENT_DAG_NODES_WITH_TOOL_SURFACE_SUPPORT_MAY_RUN_IN_PARALLEL; OTHERWISE_SERIALIZE",
    "background_execution_forbidden": true,
    "generic_child_agent_spawn_not_assumed": true,
    "checkpoint_on_forced_stop": "UPDATE_EXISTING_CHECKPOINT_ONLY_WHEN_EXISTING_PERSISTENCE_TRIGGER_IS_MET",
    "forced_stop_output": "REPORT_EXACT_CURRENT_NODE_NEXT_ALLOWED_ACTION_OR_BLOCKER_WITHOUT_PROMISING_BACKGROUND_WORK",
    "does_not_create": [
      "BACKGROUND_WORKER",
      "NEW_AGENT_RUNTIME",
      "NEW_DAG_TAXONOMY",
      "NEW_PROJECT_STATE"
    ]
