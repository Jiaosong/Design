      "CURRENT_PROJECT_CONTROL_CARD",
      "CURRENT_TASK_AND_PROJECT_STATE"
    ],
    "required_checkpoint_fields": [
      "checkpoint_state",
      "current_node",
      "last_verified_artifact",
      "resume_from",
      "next_allowed_action",
