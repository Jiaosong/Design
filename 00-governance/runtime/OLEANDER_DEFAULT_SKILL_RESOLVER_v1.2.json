      "TASK_ID_WHEN_KNOWN",
      "LOGICAL_OBJECT_OR_CANONICAL_IDS",
      "CURRENT_NATIVE_MASTER_OR_REF",
      "AUTHORITY_FINGERPRINT"
    ],
    "frontier_match_rule": "USE_EXACT_STABLE_KEYS_WHEN_AVAILABLE; TITLE_OR_CHAT_SUMMARY_ONLY_IS_INSUFFICIENT",
    "same_task_multiple_checkpoint_rule": "SELECT_HIGHEST_CHECKPOINT_SEQUENCE_THEN_LATEST_CHECKPOINT_UPDATED_AT_AMONG_AUTHORITY_MATCHING_CHECKPOINTS; OLDER_MATCHES_REMAIN_PROVENANCE",
    "distinct_task_ambiguity_rule": "IF_CURRENT_AUTHORITY_DOES_NOT_IDENTIFY_ONE_ACTIVE_TASK_AND_MULTIPLE_DISTINCT_FRONTIERS_REMAIN RETURN_HOLD_AMBIGUOUS_FRONTIER_INSTEAD_OF_GUESSING",
    "cross_chat_restore_behavior": "DISCOVER_EXISTING_FRONTIER_THEN_APPLY_DIRECT_RESUME_OR_REVALIDATE_RULES",
    "chat_history_or_summary_is_not_checkpoint_authority": true,
    "revalidate_when": [
