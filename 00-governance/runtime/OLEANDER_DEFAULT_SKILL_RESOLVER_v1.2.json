      "expected_checkpoint_sequence",
      "executor_id",
      "execution_lease_state",
      "lease_acquired_at",
      "checkpoint_updated_at"
    ],
    "does_not_create": [
      "NEW_PROJECT_STATE",
      "NEW_DAG_TAXONOMY",
      "NEW_SKILL",
      "NEW_METHOD",
      "NEW_FRAMEWORK",
      "GLOBAL_CHECKPOINT_DATABASE",
