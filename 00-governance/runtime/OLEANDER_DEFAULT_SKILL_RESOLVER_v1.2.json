      "DOMAIN_NATIVE_SOURCE_TO_PRESENTATION_DERIVATIVE",
      "SPECIALIST_AUTHORITY_TO_GENERAL_DESIGN_OWNER",
      "INDEPENDENT_REVIEW_TO_PRODUCER_SELF_CHECK",
      "MATERIAL_DESIGN_DIMENSION_DROPPED_TO_REDUCE_OWNER_COUNT"
    ],
    "does_not_create": [
      "NEW_SKILL_TAXONOMY",
      "FIXED_STAGE_TO_SKILL_TABLE",
      "SECOND_ROUTER",
      "UNIVERSAL_FULL_SKILL_PIPELINE"
    ]
  },
