{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "oleander_baidu_storage": {
      "type": "stdio",
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${PLUGIN_ROOT}/runtime/run_stdio_secure.ps1"
      ],
      "cwd": "${PLUGIN_ROOT}/runtime"
    }
  }
}
