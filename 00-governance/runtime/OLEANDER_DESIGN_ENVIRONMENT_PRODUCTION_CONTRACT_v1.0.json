{
  "schema": "oleander.design-environment-production-contract.v1",
  "version": "1.0",
  "status": "ACTIVE_CURRENT_SUBORDINATE_CONTRACT",
  "date": "2026-08-27",
  "scope": "ALL_OLEANDER_DESIGN_PRODUCTION_SURFACES_UNLESS_PROJECT_AUTHORITY_EXPLICITLY_OVERRIDES",
  "role": "IMPLEMENTATION_CONTRACT_NOT_NEW_METHOD_SKILL_GATE_OR_AUTHORITY",
  "parents": [
    "00-governance/runtime/OLEANDER_UNIVERSAL_PRODUCTION_ENVIRONMENT_v1.0.json",
    "00-governance/runtime/OLEANDER_CLOUD_FREE_PROJECT_PROFILE_v1.0.json",
    "00-governance/runtime/OLEANDER_CLOUD_FREE_EXECUTION_ROUTING_BINDING_v0.1.json"
  ],
  "purpose": "Bind software routing to an editable, source-authority-safe production chain so design work remains reconstructable, dimensionally truthful where applicable, and separable from derivatives, previews and AI-generated supplemental imagery.",
  "core_invariants": [
    "SKILL_OWNER_FIRST_SOFTWARE_SECOND",
    "GENERIC_UI_UX_INTERFACE_PROTOTYPE_COMPONENT_OR_DESIGN_SYSTEM_TASK_DOES_NOT_ACTIVATE_FIGMA",
    "ONE_IDENTIFIED_EDITABLE_MASTER_PER_LOGICAL_DESIGN_OBJECT",
    "SOURCE_AUTHORITY_PRECEDES_DERIVED_PRESENTATION",
    "NATIVE_EDITABLE_SOURCE_PRECEDES_FLATTENED_PREVIEW",
    "DERIVED_EXPORT_NEVER_SILENTLY_BECOMES_MASTER",
    "REAL_WORLD_DIMENSION_AUTHORITY_STAYS_IN_VERIFIED_GEOMETRY_TECHNICAL_SOURCE_OR_EXPLICIT_GOVERNED_DESIGN_ESTIMATE",
    "TEXT_LABELS_DIMENSIONS_AND_SYSTEM_CONTENT_REMAIN_EDITABLE_OR_VECTOR_WHEN_THE_DELIVERABLE_REQUIRES_EDITABILITY",
    "AI_GENERATED_IMAGE_IS_SUPPLEMENTAL_VISUALIZATION_ONLY_NOT_DESIGN_SOURCE_AUTHORITY",
    "SOFTWARE_HANDOFF_MUST_DECLARE_KNOWN_INFORMATION_LOSS",
    "TOOL_SUCCESS_DOES_NOT_EQUAL_DESIGN_PASS"
  ],
  "asset_roles": {
    "SOURCE_AUTHORITY": "Approved factual, geometric, visual, research or project source that constrains the design object.",
    "EDITABLE_MASTER": "The current reconstructable native or open-native design source for one logical object.",
    "WORKING_DERIVATIVE": "Intermediate artifact derived from the master for a bounded operation; it cannot replace the master silently.",
    "DELIVERY_DERIVATIVE": "Export for review, publishing, fabrication communication or deployment such as PDF, PNG, MP4, GLB or built web bundle.",
    "REFERENCE": "Read-only precedent, source image, specification or evidence used for comparison or guidance.",
    "GENERATED_SUPPLEMENT": "AI-generated or other synthetic visualization used only as supplemental effect/reference/diagram material and never as authority for facts, dimensions, typography, components or final editable structure."
  },
  "master_source_contract": {
    "rules": [
      "EVERY_MATERIAL_DESIGN_OBJECT_HAS_ONE_CURRENT_EDITABLE_MASTER_IDENTITY",
      "MASTER_LOCATION_FORMAT_OWNER_AND_VERSION_OR_COMMIT_ARE_RECORDED",
      "IF_A_SAAS_NATIVE_FILE_IS_MASTER_A_RECOVERABLE_OPEN_OR_REPO_NATIVE_COUNTERPART_OR_EXPORT_STRATEGY_IS_RECORDED_WHERE_FEASIBLE",
      "A_PNG_JPG_SCREENSHOT_RENDER_PREVIEW_OR_DEPLOYMENT_IS_NOT_AN_EDITABLE_MASTER",
      "A_PDF_IS_A_MASTER_ONLY_WHEN_THE_PROJECT_AUTHORITY_EXPLICITLY_DEFINES_IT_AS_EDITABLE_SOURCE_AND_RECONSTRUCTION_REQUIREMENTS_ARE_MET",
      "PROMOTING_A_DERIVATIVE_TO_MASTER_REQUIRES_EXPLICIT_IDENTITY_AND_AUTHORITY_UPDATE_NOT_FILENAME_DRIFT"
    ],
    "required_record": [
      "object_id",
      "source_authority",
      "editable_master_path_or_locator",
      "native_or_open_native_format",
      "owner_tool_or_runtime",
      "version_commit_or_revision",
      "editability_state",
      "derived_outputs",
      "known_losses"
    ]
  },
  "production_zones": {
    "note": "These are semantic roles, not mandatory new folders. Map them onto the project's existing approved directory architecture; do not create duplicate hierarchies merely to match these labels.",
    "roles": [
      "SOURCE_AUTHORITY",
      "EDITABLE_MASTER",
      "WORKING",
      "REFERENCE",
      "GENERATED_SUPPLEMENT",
      "DERIVED_EXPORT",
      "DELIVERY",
      "ARCHIVE_OR_SUPERSEDED"
    ],
    "rules": [
      "CURRENT_MASTER_AND_DERIVED_EXPORTS_MUST_BE_DISTINGUISHABLE_WITHOUT_OPENING_EVERY_FILE",
      "TEMP_AUTOSAVE_CACHE_PROXY_AND_RENDER_CACHE_DO_NOT_ENTER_DELIVERY",
      "ONLY_ONE_CURRENT_MASTER_POINTER_EXISTS_PER_LOGICAL_OBJECT",
      "SUPERSEDED_MASTERS_REMAIN_TRACEABLE_BUT_DO_NOT_COMPETE_WITH_CURRENT"
    ]
  },
  "software_responsibility_matrix": {
    "WEB_UI_INTERACTION": {
      "authoritative_production": ["HTML", "CSS", "JavaScript", "SVG", "repo-native tokens/data", "real browser runtime"],
      "optional_adapters": ["Figma connector only after explicit Figma-delivery request or existing authoritative Figma source/project continuation or repair, plus capacity check", "Penpot USER_WEB_MANUAL fallback only when a separate design workspace is genuinely required"],
      "must_preserve": ["semantic structure", "responsive behavior", "component/state logic", "editable text", "tokens or explicit style variables", "keyboard/accessibility semantics when applicable"],
      "boundary": "Generic UI/UX/interface/prototype/component/design-system work does not activate Figma. Design-canvas screenshots and prototypes do not replace implemented browser evidence when web runtime is the required native output."
    },
    "GRAPHIC_BRAND_PACKAGING_POP": {
      "authoritative_production": ["editable SVG", "HTML/CSS/SVG when appropriate", "explicit native vector/layout source when project authority requires it"],
      "optional_adapters": ["Figma connector for explicit editable Figma handoff only", "Illustrator/InDesign or equivalent specialist software only when already available or externally operated; not a default dependency"],
      "must_preserve": ["vector text unless outlined final production copy is explicitly required", "bleed/trim/safe-area data", "linked asset identity", "spot/process color intent when applicable", "dieline separation when applicable"],
      "boundary": "Flattened PNG/JPG is review or delivery derivative, not the design master. Supplier/prepress proof remains a separate external validation when required."
    },
    "RASTER_IMAGE_TREATMENT": {
      "authoritative_production": ["existing authoritative source image plus deterministic source transform when sufficient"],
      "optional_adapters": ["Photopea USER_WEB_MANUAL fallback", "Photoshop or equivalent specialist software only when already available or externally operated; not a default dependency"],
      "must_preserve": ["original source identity", "non-destructive or reproducible transform record when material", "pixel dimensions", "color profile intent", "crop relationship"],
      "boundary": "Image treatment does not change project facts, source authority or dimensional truth."
    },
    "SPATIAL_PRODUCT_CMF_3D": {
      "authoritative_production": ["Blender ACTIVE shared runtime when callable and fit", "verified CAD/BIM/Class-A authoring runtime only when the required professional output is actually available"],
      "optional_adapters": ["SketchUp Web USER_WEB_MANUAL fallback for bounded spatial work", "Rhino/Grasshopper/CAD/BIM specialist software only when verified and actually available"],
      "must_preserve": ["declared units", "real-world scale", "origin/axis", "authoritative dimensions", "geometry identity", "material assignments", "camera state when used as evidence"],
      "boundary": "Render, screenshot, AI image, browser proxy or mesh viewer cannot substitute for required CAD/BIM/Class-A/manufacturing geometry."
    },
    "TECHNICAL_VECTOR_DRAWING": {
      "authoritative_production": ["verified dimensions/data", "editable SVG or other approved vector/technical source", "PDF derivative"],
      "optional_adapters": ["Figma connector only when explicit Figma handoff is required", "specialist CAD/drafting software when verified and actually available"],
      "must_preserve": ["dimension values", "units", "line hierarchy", "view identity", "editable annotations", "geometry-dimension consistency"],
      "boundary": "Illustrative geometry or AI-generated imagery cannot establish engineering dimensions."
    },
    "DATA_VIZ_GIS": {
      "authoritative_production": ["CSV/JSON/GeoJSON or governed dataset", "oleander-data-viz", "SVG/HTML", "QGIS/GDAL/GeoPandas when verified and required"],
      "must_preserve": ["data lineage", "coordinate reference system when spatial", "units", "mapping between data and visual marks", "editable labels where required"],
      "boundary": "Decorative raster output does not replace the governed dataset or spatial source."
    },
    "MOTION_VIDEO": {
      "authoritative_production": ["browser motion for runtime interaction", "Blender animation/compositor when fit", "FFmpeg for deterministic media operations when verified"],
      "optional_adapters": ["After Effects/Premiere or equivalent specialist software only when already available or externally operated; not a default dependency"],
      "must_preserve": ["source asset identity", "timing", "frame rate", "state transition meaning", "reduced-motion alternative when applicable"],
      "boundary": "Rendered video proves visible output only; it does not prove editable scene/project health or runtime interaction semantics."
    },
    "DEPLOY_SHARE": {
      "authoritative_production": ["source repository plus governed deployment configuration"],
      "optional_adapters": ["Vercel connector", "GitHub Pages", "Cloudflare Pages Free"],
      "must_preserve": ["source commit binding", "asset completeness", "environment/config provenance", "rollback path"],
      "boundary": "Deploy success does not equal browser, design, accessibility or release pass."
    }
  },
  "figma_boundary": {
    "role": "EXPLICIT_REQUEST_OR_EXISTING_FIGMA_SOURCE_HANDOFF_ADAPTER_NOT_GLOBAL_CURRENT",
    "activation_gate_any": [
      "EXPLICIT_FIGMA_DELIVERY_REQUEST",
      "EXISTING_AUTHORITATIVE_FIGMA_FILE_OR_PROJECT_MUST_BE_CONTINUED_OR_REPAIRED"
    ],
    "probe_policy": "DO_NOT_PROBE_RECOMMEND_OR_CREATE_FOR_GENERIC_UI_UX_INTERFACE_PROTOTYPE_COMPONENT_OR_DESIGN_SYSTEM_TASKS",
    "new_file_preconditions": [
      "EXPLICIT_FIGMA_DELIVERY_REQUEST",
      "EXISTING_FILE_AND_PAGE_REUSE_CHECKED",
      "CURRENT_CAPACITY_CONFIRMED_WITHOUT_PAID_UPGRADE_OR_DELETION_PRESSURE",
      "RECOVERABLE_NON_FIGMA_SOURCE_OR_HANDOFF_STRATEGY_RECORDED"
    ],
    "rules": [
      "CONNECTOR_AVAILABILITY_ALONE_DOES_NOT_ACTIVATE_FIGMA",
      "COMPONENTS_VARIABLES_AUTO_LAYOUT_AND_TEXT_REMAIN_NATIVE_WHEN_FIGMA_IS_THE_REQUIRED_EDITABLE_HANDOFF",
      "DO_NOT_FLATTEN_COMPONENT_SYSTEM_INTO_SCREENSHOT_OR_SINGLE_RASTER",
      "FIGMA_PREVIEW_OR_EXPORT_DOES_NOT_BECOME_SOURCE_AUTHORITY_BY_EXISTENCE"
    ]
  },
  "dimension_and_geometry_authority": {
    "applicable_to": ["spatial", "architecture", "landscape", "interior", "product", "packaging structure", "technical drawing", "fabrication communication"],
    "required": [
      "unit_system",
      "scale_or_real_size_basis",
      "dimension_authority_source",
      "geometry_authority_source",
      "coordinate_axis_or_reference_when_relevant",
      "field_or_engineering_validation_state_when_relevant"
    ],
    "rules": [
      "AI_IMAGE_HAS_ZERO_DIMENSIONAL_AUTHORITY",
      "PERSPECTIVE_RENDER_HAS_ZERO_HIDDEN_DIMENSIONAL_AUTHORITY_UNLESS_BOUND_TO_VERIFIED_GEOMETRY",
      "VISIBLE_SCALE_FIGURE_DOES_NOT_REPLACE_DIMENSION_DATA",
      "UNKNOWN_FIELD_CONDITIONS_REMAIN_EXPLICITLY_OPEN_AND_DO_NOT_GET_INVENTED",
      "DESIGN_ESTIMATES_USE_RECOMMENDED_VALUE_RANGE_BASIS_SENSITIVITY_AND_FIELD_CHECK_WHEN_EXACT_FIELD_DATA_IS_UNAVAILABLE"
    ]
  },
  "text_and_vector_contract": {
    "rules": [
      "DESIGN_SYSTEM_UI_LABELS_BODY_COPY_DIMENSIONS_ANNOTATIONS_AND_MARKETING_COPY_REMAIN_EDITABLE_TEXT_OR_VECTOR_TEXT_IN_THE_MASTER",
      "AI_RENDERED_TEXT_IS_NEVER_FINAL_TEXT_ASSET",
      "RASTERIZED_OR_OUTLINED_TEXT_IS_A_DERIVATIVE_UNLESS_PRODUCTION_SPEC_EXPLICITLY_REQUIRES_OUTLINES",
      "WHEN_OUTLINED_FINAL_ARTWORK_IS_REQUIRED_KEEP_AN_EDITABLE_TEXT_SOURCE_AND_FONT_OR_TYPE_SPEC_PROVENANCE_SEPARATELY"
    ]
  },
  "ai_generated_visual_boundary": {
    "default": "DO_NOT_USE_UNLESS_EXPLICITLY_ALLOWED_BY_ACTIVE_CONSTRAINTS_AND_MATERIALLY_USEFUL",
    "allowed_roles": ["SUPPLEMENTAL_EFFECT_RENDER", "REFERENCE_VISUAL", "CONCEPT_EXPLORATION", "DIAGRAM_SUPPORT"],
    "forbidden_roles": ["SOURCE_AUTHORITY", "DIMENSION_AUTHORITY", "ENGINEERING_EVIDENCE", "NATIVE_EDITABLE_MASTER", "FINAL_UI_TEXT", "DESIGN_SYSTEM_COMPONENT_SOURCE", "FACTUAL_SITE_OR_PRODUCT_PROOF_WITHOUT_INDEPENDENT_EVIDENCE"],
    "rules": [
      "AI_VISUAL_MUST_BE_LABELED_OR_TRACEABLE_AS_GENERATED_SUPPLEMENT_WHEN_USED_IN_THE_PRODUCTION_CHAIN",
      "REBUILD_FINAL_TEXT_LABELS_DIMENSIONS_AND_SYSTEM_GEOMETRY_AS_REAL_EDITABLE_ASSETS",
      "DO_NOT_INFER_HIDDEN_GEOMETRY_MATERIAL_SPECIFICATION_DIMENSIONS_OR_SITE_FACTS_FROM_GENERATED_PIXELS",
      "IF_AI_VISUAL_CONFLICTS_WITH_VERIFIED_SOURCE_GEOMETRY_FACTS_OR_DIMENSIONS_THE_VERIFIED_SOURCE_WINS"
    ]
  },
  "handoff_contract": {
    "required_when": "A_MATERIAL_DESIGN_OBJECT_CROSSES_SOFTWARE_RUNTIME_OR_FILE_FORMAT_BOUNDARIES",
    "required_fields": [
      "object_id",
      "upstream_master",
      "upstream_tool_runtime_and_version_when_known",
      "downstream_tool_runtime",
      "exchange_format",
      "unit_and_scale",
      "coordinate_axis_or_canvas_size",
      "color_space_or_profile_when_relevant",
      "font_or_text_policy_when_relevant",
      "linked_dependency_policy",
      "editable_information_preserved",
      "known_losses_or_bakes",
      "round_trip_or_reopen_check",
      "output_hash_or_commit_when_material"
    ],
    "fail_conditions": [
      "UNDECLARED_UNIT_OR_SCALE_CHANGE",
      "UNDECLARED_AXIS_OR_COORDINATE_CHANGE",
      "MISSING_LINKED_ASSETS_OR_FONTS",
      "TEXT_OR_COMPONENT_STRUCTURE_FLATTENED_WHEN_EDITABILITY_IS_REQUIRED",
      "DERIVED_FILE_REPLACES_MASTER_WITHOUT_AUTHORITY_UPDATE",
      "KNOWN_INFORMATION_LOSS_HIDDEN_OR_UNRECORDED"
    ]
  },
  "workflow": [
    "0_AUTHORITY_PREFLIGHT__resolve_project_source_design_and_current_master_authorities",
    "1_OWNER_RESOLUTION__resolve_existing_OLEANDER_skill_or_method_owner_before_software",
    "2_NATIVE_OUTPUT_DEFINITION__declare_editable_master_required_native_output_fidelity_units_dimensions_text_editability_and_delivery_derivatives",
    "3_CAPABILITY_AND_SOFTWARE_SELECTION__use_current_connector_or_ACTIVE_runtime_that_preserves_native_output_then bounded fallback_or_HOLD",
    "4_PRODUCTION__work_in_the_identified_master_without_silent_authority_or_unit_drift",
    "5_TYPED_HANDOFF__record_cross_tool_exchange_and_known_losses",
    "6_ACTUAL_READBACK__open_render_or_execute_the_real artifact_at_required_viewports_scales_or_views",
    "7_REVIEW__run_applicable_Artifact_Review_Post_Generation_Review_and_delivery_QC_without_collapsing_Evidence_and_Design_Quality",
    "8_PERSISTENCE_AND_CURRENT_CLEANUP__persist_recoverable_master_and_required_derivatives_keep_one_CURRENT_and_archive_or_supersede_old_candidates_traceably"
  ],
  "definition_of_done": [
    "CURRENT_EDITABLE_MASTER_IDENTIFIED",
    "SOURCE_AUTHORITY_BOUND",
    "REQUIRED_NATIVE_OUTPUT_AND_DERIVED_OUTPUTS_SEPARATED",
    "UNITS_DIMENSION_GEOMETRY_AUTHORITY_RECORDED_WHEN_APPLICABLE",
    "TEXT_AND_SYSTEM_ASSETS_EDITABLE_WHEN_REQUIRED",
    "SOFTWARE_ROLE_AND_EXECUTION_SURFACE_RECORDED",
    "MATERIAL_CROSS_SOFTWARE_HANDOFFS_HAVE_TYPED_HANDOFF_RECORDS",
    "AI_GENERATED_VISUALS_IF_ANY_ARE_SUPPLEMENTAL_TRACEABLE_AND_NON_AUTHORITATIVE",
    "ACTUAL_VISUAL_RUNTIME_OR_PHYSICAL_READBACK_EXECUTED_AS_APPLICABLE",
    "BLOCKING_REVIEW_DEFECTS_RESOLVED_OR_EXPLICITLY_HOLD",
    "MASTER_AND_REQUIRED_DERIVATIVES_PERSISTED_WITH_RECOVERABLE_CURRENT_POINTER",
    "NO_PARALLEL_COMPETING_CURRENT_MASTER_CREATED"
  ],
  "does_not_prove": [
    "DESIGN_QUALITY",
    "FIELD_TRUTH",
    "ENGINEERING_APPROVAL",
    "MANUFACTURING_APPROVAL",
    "RIGHTS_CLEARANCE",
    "HUMAN_VALIDATION",
    "PROMOTION_OR_RELEASE"
  ]
}
