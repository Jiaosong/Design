    "CURRENT_AUTHORITY_IDENTITY",
    "ACTIVE_USER_CONSTRAINTS",
    "HUMAN_DESIGN_KEEP_RIGHT",
    "HUMAN_PROMOTION_RIGHT",
    "STATUTORY_LICENSED_AUTHORITY"
  ],
  "trigger_classes": [
