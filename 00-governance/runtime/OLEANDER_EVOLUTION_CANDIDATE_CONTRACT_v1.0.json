      "CI_GREEN_AS_ADOPTION",
      "CANDIDATE_SKILL_IDENTITY_AS_CURRENT_CALLABLE_OWNER",
      "CANDIDATE_BODY_AS_CURRENT_CALLABLE_OWNER",
      "MISSING_OR_STALE_TASK_CLAIM_KNOWLEDGE_MOUNT_AS_PROFESSIONAL_EXECUTION_PASS",
      "PRE_RELEASE_EVALUATION_RECEIPT_AS_POST_RELEASE_SUCCESSOR_RECEIPT",
      "IN_PLACE_MUTATION_OF_CURRENT_PROFESSIONAL_MACHINE_ONLY_TO_ADD_ROUTING_METADATA",
      "ONE_OR_TWO_FIXED_SKILLS_REUSED_THROUGH_ALL_STAGES_AS_COMPREHENSIVE_DESIGN",
      "ALL_SKILLS_RUN_AT_EVERY_STAGE_AS_COMPREHENSIVE_DESIGN",
