{
  "schema": "oleander.evolution-candidate-contract.v1",
  "version": "1.0",
  "status": "ACTIVE_CURRENT_CONTRACT",
  "effective_date": "2026-09-15",
  "purpose": "Machine-readable contract for bounded OLEANDER self-improvement candidates. Evolution may propose and evaluate changes but may not self-promote Current authority, human Design KEEP, project Promotion, active user constraints or statutory authority.",
  "state_values": [
    "EV0_OBSERVED",
    "EV1_CANDIDATE",
    "EV2_EVAL_READY",
    "EV3_EVAL_PASSED",
    "EV4_INDEPENDENT_REVIEWED",
    "EV5_PROMOTION_READY",
    "EV6_CURRENT_ADOPTED",
    "EV7_MONITORED",
    "EVH_HOLD",
    "EVR_REJECTED"
  ],
  "target_classes": [
    "KNOWLEDGE_METHODS",
    "SKILLS",
    "CAPABILITY_ROUTING",
    "TOOL_DESCRIPTIONS",
    "TOOL_ADAPTERS",
    "READER_RETRIEVAL_RUNTIME",
    "FILE_HANDLING_ROUTES",
    "VALIDATORS",
    "SCHEMAS",
    "PROFESSIONAL_PROCESS_DEFINITIONS",
    "ARCHITECTURE_CONTROL_GRAPH"
  ],
