,"REASONING","SYNTHESIS","OPTION","SPATIAL","PLANNING","BRIEF","GOAL_FRAMING","EXPERIENCE_ARCHITECTURE","INFORMATION_ROUTE","CONTENT_INFORMATION","JOURNEY","WORKFLOW","ROUTE_TOPOLOGY","RELATIONSHIP_ADJACENCY","THRESHOLD","ZONING","CIRCULATION","ROOM_USE","MASTERPLAN","FFE_CONCEPT","WHOLE_PLAN_SECTION_DESIGN_CRITIQUE","DIAGRAM_MODELLING","STATE_FLOW_DIAGRAMMING","CONTEXT_OF_USE_MODELLING","ASSUMPTION_DEPENDENCY_REGISTER","REQUIREMENT_RESPONSE_TRACEABILITY","EVIDENCE_TRACEABILITY","SCOPE_INTERFACE","BOUNDARY_AUTHORITY","PROCUREMENT_RESPONSIBILITY","VALUE_TRADEOFF","RETENTION_PHASING","SITE_SYSTEM_DIAGNOSIS","STEWARDSHIP_CHANGE","CONTINUOUS_IMPROVEMENT","CORRECTIVE_CHANGE","SERVICE_OPERATION_FEEDBACK","DEGRADED_FAILURE_SCENARIO_ANALYSIS","MISSION_THREAD"],"exact_any":["CROSS_DOMAIN_INTERFACE_COORDINATION","ENGINEERING_HANDOFF_SPECIFICATION","FFE_EQUIPMENT_LAYOUT","INFORMATION_ARCHITECTURE_MODELLING","LANDSCAPE_FACADE_INTERFACE","BASELINE_READBACK_CONTROL","CROSS_DOMAIN_CONTRADICTION_ANALYSIS","FRESH_NATIVE_ARTIFACT_READBACK","OPERATIONAL_CONFLICT_ANALYSIS","OPERATIONAL_SEQUENCE_READBACK","PEAK_DEGRADED_OPERATION_READBACK","PLAN_GEOMETRY_READBACK","PLAN_MODEL_ROOM_FIT_READBACK","PLAN_SECTION_MATERIAL_CONSEQUENCE_READBACK","SCHEDULE_GEOMETRY_CONSEQUENCE_READBACK","SEQUENCE_TEMPORARY_STATE_READBACK","SPECIALIST_INTERFACE_HANDOFF"]},"resolution_class":"EXISTING_OWNER","owner_refs":["oleander-design-process"],"authority_ceiling":"DESIGN_REASONING_AND_DESIGN_OBJECT_EXECUTION_NOT_SPECIALIST_TECHNICAL_VALIDATION","missing_binding_result":"HOLD"},{"rule_id":"PSC-UNOWNED-PROFESSIONAL-CAPABILITY","match":{"fallback":true},"resolution_class":"PROJECT_OR_SPECIALIST_OWNER_REQUIRED","owner_refs":[],"authority_ceiling":"NO_GENERIC_SKILL_SUBSTITUTION","missing_binding_result":"HOLD"}],"composition_rule":"Resolve every active stage capability role independently, bind project/specialist and independent-review roles explicitly, verify Current callability/lifecycle for reusable owners, then dedupe owner identities only after role coverage is proven.","single_owner_rule":"A single owner is sufficient only when every active capability role resolves to that owner or an explicitly not-triggered supporting role without authority or fidelity loss.","no_owner_rule":"PROJECT_OR_SPECIALIST_OWNER_REQUIRED, INDEPENDENT_REVIEWER_REQUIRED, unavailable CANDIDATE_BODY, or NO_DEDICATED_OWNER_HOLD remains HOLD until an explicit legal binding exists; never substitute oleander-design-process merely to avoid HOLD.","recompute_rule":"Re-run capability-role routing on professional-stage, decision/claim, native-output/readback, interface-maturity, owner-callability, or HOLD-release changes and selectively reroute affected bindings only.","candidate_owner_rule":"CANDIDATE_OWNER_IS_DISCOVERY_OR_BOUNDED_EVALUATION_CONTEXT_ONLY_NOT_CURRENT_CALLABLE_EXECUTION_AUTHORITY; HOLD_UNLESS_AN_EXPLICIT_CURRENT_PROJECT_SPECIALIST_BINDING_LEGALLY_OVERRIDES_THE_ROLE","candidate_body_rule":"CANDIDATE_BODY_IS_NOT_CURRENT_CALLABLE_EXECUTION_AUTHORITY; HOLD_UNLESS_AN_EXPLICIT_CURRENT_PROJECT_SPECIALIST_BINDING_LEGALLY_OVERRIDES_THE_ROLE"},
  "hard_guards": ["NOTION_CANONICAL_ID_DOMAIN_ROLE_AND_RELATIONS_REMAIN_UPSTREAM_AUTHORITY","EXECUTION_OWNER_DOES_NOT_CHANGE_NOTION_LOCATION_OR_NAME","NO_DEDICATED_OWNER_IS_NOT_A_REASON_TO_CREATE_A_NEW_SKILL","CANDIDATE_OWNER_MUST_BE_REPORTED_AS_CANDIDATE","DELIVERY_QC_DOES_NOT_EQUAL_DESIGN_REVIEW_OR_USER_VALIDATION","OUTPUT_MEDIUM_CAN_OVERRIDE_DOMAIN_FALLBACK_WHEN_THE_CURRENT_TASK_REQUIRES_A_SPECIFIC_NATIVE_ARTIFACT","PROJECT_CURRENT_EXECUTION_OWNER_OVERRIDES_GENERIC_FALLBACK_ONLY_WHEN_CURRENT_AUTHORITY_EXPLICITLY_ASSIGNES_IT","ONE_EXECUTION_OWNER_MAY_SERVE_MANY_NOTION_METHODS_AND_DOMAINS","ONE_NOTION_METHOD_MAY_USE_MULTIPLE_EXECUTION_SKILLS_ACROSS_DIFFERENT_OUTPUTS","MINIMUM_SUFFICIENT_OWNER_SET_PRECEDES_MULTI_SKILL_DAG_EXPANSION","PROFESSIONAL_STAGE_CAPABILITY_ROLE_MUST_RESOLVE_BEFORE_OWNER_COUNT_MINIMIZATION","PROJECT_OR_SPECIALIST_OWNER_REQUIRED_MUST_HOLD_WHEN_NO_EXPLICIT_PROJECT_BINDING_EXISTS","INDEPENDENT_REVIEWER_REQUIRED_MUST_NOT_RESOLVE_TO_PRODUCER","CANDIDATE_BODY_MUST_NOT_BE_TREATED_AS_CALLABLE_INSTALLED_OWNER","CANDIDATE_SKILL_OWNER_MUST_NOT_BE_TREATED_AS_CURRENT_CALLABLE_OWNER"],
