  "professional_stage_capability_routing": {"purpose":"Normalize domain-native stage capability-role labels into the existing execution-owner map without creating a second Skill taxonomy, fixed stage-to-Skill table, or authority expansion.","is_routing_extension_not_taxonomy":true,"resolution_inputs":["PROFESSIONAL_DOMAIN","PROFESSIONAL_STAGE","CAPABILITY_ROLE","REQUIRED_NATIVE_OUTPUT","CURRENT_PROJECT_OWNER_BINDINGS","CURRENT_OWNER_CALLABILITY","CLAIM_AND_REVIEW_BOUNDARY"],"valid_resolution_classes":["EXISTING_OWNER","CANDIDATE_OWNER","CANDIDATE_BODY_REQUIRES_CALLABILITY","PROJECT_OR_SPECIALIST_OWNER_REQUIRED","INDEPENDENT_REVIEWER_REQUIRED","NO_DEDICATED_OWNER_HOLD"],"ordered_first_match":true,"rules":[{"rule_id":"PSC-INDEPENDENT-REVIEW","match":{"contains_any":["INDEPENDENT_"],"exact_any":["INDEPENDENT_REVIEW_BINDING"]},"resolution_class":"INDEPENDENT_REVIEWER_REQUIRED","owner_refs":[],"authority_ceiling":"REVIEW_ONLY_NOT_PRODUCER","missing_binding_result":"HOLD"},{"rule_id":"PSC-PROFESSIONAL-SPECIALIST-GUARD","match":{"starts_with_any":["STRUCTURAL_","MEP_","LIGHTING_","LUMINAIRE_","PHOTOMETRIC_","COMMISSIONING_","FABRICATION_","PRE_FUNCTIONAL_","TAB_BALANCING_","FUNCTIONAL_LOGICAL_","STATE_BEHAVIOR_","CAPABILITY_FUNCTION_","HUMAN_SYSTEM_","INTERFACE_CONTROL_","INTERFACE_FAILURE_","LOGICAL_ARCHITECTURE_","PHYSICAL_ARCHITECTURE_"],"exact_any":["LOAD_AND_DIVERSITY_CALCULATION","LOAD_ASSUMPTION_MODELLING","DEMAND_LOAD_ASSUMPTION_MODELLING","GRADING_DRAINAGE_TECHNICAL_REASONING","PLANT_SOIL_IRRIGATION_DATA","FIELD_MEASUREMENT","SITE_CONSTRUCTION_OBSERVATION","SITE_CONSTRUCTION_READBACK","SITE_INSTALLATION_READBACK","INSTALLATION_SITE_READBACK","ESTABLISHMENT_FIELD_READBACK","SYSTEM_INTEGRATION_EXECUTION","REQUIREMENTS_ENGINEERING","VERIFICATION_TEST_ANALYSIS","VALIDATION_USER_OPERATION_RESEARCH","ACCESSIBILITY_EVALUATION","ACCESSIBILITY_RUNTIME_CHECK","USABILITY_RESEARCH","PHYSICAL_MOCKUP_SAMPLE_REVIEW","SPECIFICATION_PROCUREMENT_CONTROL","SUBSTITUTION_EQUIVALENCE_REVIEW","EQUIPMENT_SUBMITTAL_REVIEW","INTERIOR_ASSEMBLY_DETAILING","JOINERY_COMPONENT_COORDINATION","PROFESSIONAL_STATUTORY_HANDOFF_CONTROL","ACCESSIBILITY_FIRE_INTERFACE_CHECKING","LIFE_SAFETY_ACCESSIBILITY_SPATIAL_RESERVATION","CONTROLS_SEQUENCE_DESIGN","CONTROL_SCENE_RUNTIME_READBACK","CONTROL_SEQUENCE_READBACK","NIGHT_CONDITION_EVIDENCE_QC","EXTERIOR_NIGHT_ENVIRONMENT_DESIGN","DAYLIGHT_LUMINOUS_CONCEPT_DESIGN","GLARE_BRIGHTNESS_COLOR_ANALYSIS","SURFACE_MATERIAL_INTERACTION_REASONING","DESIGN_TO_MOCKUP_CORRELATION","CONFIGURATION_DATA_MANAGEMENT","INTEGRATION_STRATEGY_PLANNING","PDR_READINESS_READBACK","REVERIFICATION_REVALIDATION_PLANNING","IN_USE_CHANGE_IMPACT_ANALYSIS","HANDOVER_DEFECT_RECONCILIATION","O_AND_M_ASSET_DATA_RECONCILIATION","TRAINING_AND_OPERATIONAL_READINESS","MEASURED_PERFORMANCE_ANALYSIS","FINE_TUNING_CHANGE_REASONING","MAINTENANCE_REPLACEMENT_REASONING","TUNING_CHANGE_ANALYSIS","ACCEPTANCE_CRITERIA_MODELLING","ANOMALY_CONFIGURATION_BOUND_READBACK","AS_BUILT_EVIDENCE_READBACK","CONCEPT_STRUCTURAL_MODELLING","CONSTRUCTION_COORDINATION","DEFECT_NONCONFORMITY_TRACKING","ENERGY_RESILIENCE_ANALYSIS","ENERGY_RESILIENCE_COMPARISON","FFE_FINISH_PRODUCT_DATA_RECONCILIATION","FIELD_CHANGE_TECHNICAL_RECORD","HANDOVER_RECONCILIATION","INSTALLATION_INFORMATION_REVIEW","INTERFACE_DATA_COORDINATION","IN_USE_MONITORING_ANALYSIS","MAINTENANCE_OPERATION_SCHEDULING","MAINTENANCE_REPLACEMENT_ACCESS_READBACK","MODEL_READBACK","NONCONFORMITY_EVIDENCE_REVIEW","NONCONFORMITY_EVIDENCE_TRACKING","OPERATIONAL_CONCEPT_MODELLING","PRODUCT_DATA_REVIEW","RCP_SERVICE_INTERFACE_COORDINATION","SUBMITTAL_SAMPLE_MOCKUP_REVIEW","SYSTEM_DIAGRAM_PRODUCTION","SYSTEM_TRADE_STUDY","USABILITY_SENSORY_PERFORMANCE_ANALYSIS","CLEARANCE_ACCESS_MAINTENANCE_READBACK","COST_LIFECYCLE_EVIDENCE_INTERPRETATION","STRUCTURE_MEP_ENVELOPE_INTERFACE_DATA","WET_SERVICE_DATA_COORDINATION","BASIS_OF_DESIGN_DEFINITION","CHANGE_IMPACT_REASONING","SYSTEM_TOPOLOGY_OPTION_REASONING","VERIFICATION_VALIDATION_PLANNING"]},"resolution_class":"PROJECT_OR_SPECIALIST_OWNER_REQUIRED","owner_refs":[],"authority_ceiling":"DOMAIN_PROFESSIONAL_OR_PROJECT_BOUND_SPECIALIST","missing_binding_result":"HOLD"},{"rule_id":"PSC-TECHNICAL-DRAWING","match":{"contains_any":["TECHNICAL_DRAWING","TECHNICAL_PLAN_SECTION"],"exact_any":["MEASURED_PLAN_SECTION_PRODUCTION","PLAN_SECTION_TECHNICAL_READBACK","EDITABLE_SITE_PLAN_LEVEL_READBACK","2D_PLAN_SECTION_ELEVATION_READBACK","INTEGRATED_SITE_PLAN_SECTION_READBACK","PLAN_SECTION_GEOMETRY"]},"resolution_class":"CANDIDATE_BODY_REQUIRES_CALLABILITY","owner_refs":["OLEANDER Technical Drawing"],"authority_ceiling":"TECHNICAL_GRAPHIC_TRANSLATION_ONLY","missing_binding_result":"HOLD"},{"rule_id":"PSC-UI-VISUAL-INTERACTION-COMBINED","match":{"exact_any":["UI_VISUAL_AND_INTERACTION_READBACK"]},"resolution_class":"CANDIDATE_OWNER","owner_refs":["oleander-ui-visual-composition","oleander-ui-interaction"],"authority_ceiling":"CANDIDATE_UI_EXECUTION_ONLY","missing_binding_result":"HOLD"},{"rule_id":"PSC-UI-INTERACTION","match":{"exact_any":["INTERACTION_BEHAVIOR_PROTOTYPE","INTERACTION_STATE_DESIGN","INTERACTIVE_PROTOTYPE_EXECUTION","UI_INTERACTION_IMPLEMENTATION_ALIGNMENT","IMPLEMENTED_RUNTIME_READBACK","SUPPORT_DEGRADED_STATE_VALIDATION"]},"resolution_class":"CANDIDATE_OWNER","owner_refs":["oleander-ui-interaction"],"authority_ceiling":"CANDIDATE_INTERACTION_EXECUTION_ONLY","missing_binding_result":"HOLD"},{"rule_id":"PSC-UI-VISUAL","match":{"exact_any":["UI_VISUAL_COMPOSITION"]},"resolution_class":"CANDIDATE_OWNER","owner_refs":["oleander-ui-visual-composition"],"authority_ceiling":"CANDIDATE_UI_VISUAL_EXECUTION_ONLY","missing_binding_result":"HOLD"},{"rule_id":"PSC-MOTION","match":{"exact_any":["TEMPORAL_MOTION_BEHAVIOR","TEMPORAL_TRANSITION_REASONING"]},"resolution_class":"EXISTING_OWNER","owner_refs":["oleander-motion"],"authority_ceiling":"TEMPORAL_EXECUTION_ONLY","missing_binding_result":"HOLD"},{"rule_id":"PSC-DELIVERY-QC","match":{"exact_any":["DELIVE