{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oleander.project-specialist-owner-binding.v1",
  "title": "OLEANDER Project Specialist Owner Binding v1",
  "type": "object",
  "required": [
    "object_type",
    "schema_version",
    "binding_id",
    "project_id",
    "source_revision",
    "capability_role",
    "status",
    "owner_kind",
    "owner_ref",
    "authorization_ref",
    "authorization_state",
    "scope_refs",
    "required_native_outputs",
    "authority_ceiling",
    "independent_review_required",
    "review_owner_ref",
    "review_state",
    "revocation_triggers",
    "stale",
    "binding_verdict",
    "does_not_prove"
  ],
  "properties": {
    "object_type": {"const": "PROJECT_SPECIALIST_OWNER_BINDING"},
    "schema_version": {"const": "1.0"},
    "binding_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "workstream_id": {"type": ["string", "null"]},
    "source_revision": {"type": "string", "minLength": 1},
    "capability_role": {"const": "TECHNICAL_DRAWING"},
    "status": {"enum": ["HOLD", "CURRENT", "STALE", "REVOKED"]},
    "owner_kind": {"enum": ["NOT_ASSIGNED", "HUMAN_SPECIALIST", "PROJECT_ORGANIZATION_SPECIALIST", "EXTERNAL_PROFESSIONAL_SPECIALIST"]},
    "owner_ref": {"type": ["string", "null"]},
    "authorization_ref": {"type": ["string", "null"]},
    "authorization_state": {"enum": ["NOT_ASSIGNED", "PENDING", "VERIFIED", "REVOKED"]},
    "scope_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "required_native_outputs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "authority_ceiling": {"const": "PROJECT_TECHNICAL_DRAWING_PRODUCTION_NOT_PROFESSIONAL_APPROVAL"},
    "independent_review_required": {"type": "boolean"},
    "review_owner_ref": {"type": ["string", "null"]},
    "review_state": {"enum": ["NOT_REQUIRED", "NOT_RUN", "PASS", "FAIL", "HOLD"]},
    "supersedes_binding_ref": {"type": ["string", "null"]},
    "revocation_triggers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "stale": {"type": "boolean"},
    "binding_verdict": {"enum": ["PASS", "HOLD", "REVOKED"]},
    "does_not_prove": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
