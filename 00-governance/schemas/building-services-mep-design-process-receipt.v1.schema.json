{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oleander.building-services-mep-design-process-receipt.v1",
  "title": "OLEANDER Building Services / MEP Design Process Receipt v1",
  "type": "object",
  "required": [
    "receipt_type", "schema_version", "project_id", "process_ref", "source_revision",
    "claim_ceiling", "stage_records", "system_tracks", "interface_summary", "professional_review",
    "blocking_open_items", "open_items", "reopened_items", "stale", "result", "does_not_prove"
  ],
  "properties": {
    "receipt_type": {"const": "BUILDING_SERVICES_MEP_DESIGN_PROCESS_RECEIPT"},
    "schema_version": {"const": "1.0"},
    "project_id": {"type": "string", "minLength": 1},
    "workstream_id": {"type": ["string", "null"]},
    "process_ref": {"const": "00-governance/schemas/building-services-mep-design-process.v1.json"},
    "source_revision": {"type": "string", "minLength": 1},
    "claim_ceiling": {"type": "string", "minLength": 1},
    "stage_records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stageRecord"}},
    "system_tracks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/systemTrack"}},
    "interface_summary": {"type": "array", "items": {"$ref": "#/$defs/interfaceRecord"}},
    "professional_review": {"$ref": "#/$defs/reviewRecord"},
    "blocking_open_items": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "open_items": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "reopened_items": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "stale": {"type": "boolean"},
    "result": {"enum": ["PASS", "REVISE", "REJECT", "HOLD"]},
    "does_not_prove": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "stageRecord": {
      "type": "object",
      "required": ["stage_id", "triggered", "status", "knowledge_mount_refs", "native_output_refs", "actual_readback_refs", "open_items"],
      "properties": {
        "stage_id": {"enum": ["BSP-STRATEGIC", "BSP-BRIEF", "BSP-CONCEPT", "BSP-SPATIAL", "BSP-TECHNICAL", "BSP-PRODUCTION", "BSP-CONSTRUCTION-CX", "BSP-HANDOVER", "BSP-INUSE"]},
        "triggered": {"type": "boolean"},
        "status": {"enum": ["NOT_TRIGGERED", "PENDING", "IN_PROGRESS", "PASS", "REVISE", "REJECT", "HOLD", "STALE"]},
        "knowledge_mount_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "native_output_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "actual_readback_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "open_items": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "systemTrack": {
      "type": "object",
      "required": ["system_id", "status", "design_refs", "commissioning_required", "commissioning_state", "integrated_system_test_required", "integrated_system_test_state", "seasonal_or_deferred_test_open", "evidence_refs"],
      "properties": {
        "system_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["PENDING", "IN_PROGRESS", "PASS", "REVISE", "REJECT", "HOLD", "STALE"]},
        "design_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "commissioning_required": {"type": "boolean"},
        "commissioning_state": {"enum": ["NOT_REQUIRED", "NOT_RUN", "PASS", "FAIL", "HOLD", "DEFERRED_OUTSIDE_CLAIM"]},
        "integrated_system_test_required": {"type": "boolean"},
        "integrated_system_test_state": {"enum": ["NOT_REQUIRED", "NOT_RUN", "PASS", "FAIL", "HOLD", "DEFERRED_OUTSIDE_CLAIM"]},
        "seasonal_or_deferred_test_open": {"type": "boolean"},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "interfaceRecord": {
      "type": "object",
      "required": ["interface_id", "required", "state", "evidence_refs"],
      "properties": {
        "interface_id": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "state": {"enum": ["NOT_REQUIRED", "OPEN", "PASS", "FAIL", "HOLD"]},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "reviewRecord": {
      "type": "object",
      "required": ["required", "state", "reviewer_ref", "review_input_refs"],
      "properties": {
        "required": {"type": "boolean"},
        "state": {"enum": ["NOT_REQUIRED", "NOT_RUN", "PASS", "FAIL", "HOLD"]},
        "reviewer_ref": {"type": ["string", "null"]},
        "review_input_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
