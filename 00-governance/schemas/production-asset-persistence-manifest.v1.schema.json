{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oleander.local/schemas/production-asset-persistence-manifest.v1.schema.json",
  "title": "OLEANDER Production Asset Persistence Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project", "version", "production_id", "status", "promotion_eligible", "artifacts", "verified_at"],
  "properties": {
    "schema": {"const": "oleander.production-asset-persistence.v1"},
    "project": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "production_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["PERSISTENCE PENDING", "PERSISTENCE FAIL", "PERSISTENCE PASS"]},
    "promotion_eligible": {"type": "boolean"},
    "verified_at": {"type": ["string", "null"], "format": "date-time"},
    "notes": {"type": "string"},
    "artifacts": {
      "type": "array",
      "minItems": 4,
      "items": {"$ref": "#/$defs/artifact"},
      "allOf": [
        {"contains": {"properties": {"role": {"const": "native_source"}}}},
        {"contains": {"properties": {"role": {"const": "canonical_model"}}}},
        {"contains": {"properties": {"role": {"const": "production_zip"}}}},
        {"contains": {"properties": {"role": {"const": "checksum"}}}}
      ]
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "required", "applicability", "filename", "sha256", "bytes", "durable_copies"],
      "properties": {
        "role": {"enum": ["native_source", "canonical_model", "production_zip", "checksum", "other"]},
        "required": {"type": "boolean"},
        "applicability": {"enum": ["REQUIRED", "N/A"]},
        "na_reason": {"type": ["string", "null"]},
        "filename": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "bytes": {"type": ["integer", "null"], "minimum": 0},
        "durable_copies": {"type": "array", "items": {"$ref": "#/$defs/copy"}}
      }
    },
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "stable_id", "reference", "retention_class", "retrieval_verified", "retrieved_sha256", "retrieved_bytes", "open_verified"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "stable_id": {"type": "string", "minLength": 1},
        "reference": {"type": "string", "minLength": 1},
        "retention_class": {"type": "string", "minLength": 1},
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "uploaded_at": {"type": ["string", "null"], "format": "date-time"},
        "retrieval_verified": {"type": "boolean"},
        "retrieved_at": {"type": ["string", "null"], "format": "date-time"},
        "retrieved_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "retrieved_bytes": {"type": ["integer", "null"], "minimum": 0},
        "open_verified": {"type": "boolean"},
        "verification_note": {"type": "string"}
      }
    }
  }
}
