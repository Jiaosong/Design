{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oleander.project-risk-hazard-register.v1",
  "title": "OLEANDER Project Risk / Hazard Register v1",
  "type": "object",
  "required": ["object_type", "schema_version", "register_id", "project_id", "source_revision", "status", "risks", "blocking_risk_ids", "stale", "register_verdict", "does_not_prove"],
  "properties": {
    "object_type": {"const": "PROJECT_RISK_HAZARD_REGISTER"},
    "schema_version": {"const": "1.0"},
    "register_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "workstream_id": {"type": ["string", "null"]},
    "source_revision": {"type": "string", "minLength": 1},
    "status": {"enum": ["WORKING", "CURRENT", "STALE", "HOLD"]},
    "risks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/risk"}},
    "blocking_risk_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "stale": {"type": "boolean"},
    "register_verdict": {"enum": ["PASS", "REVISE", "REJECT", "HOLD"]},
    "does_not_prove": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "risk": {
      "type": "object",
      "required": ["risk_id", "in_claim", "hazard_statement", "method_ref", "owner_ref", "severity_class", "likelihood_basis", "mitigation_refs", "verification_method", "evidence_refs", "state", "residual_risk_owner_ref", "reopen_triggers"],
      "properties": {
        "risk_id": {"type": "string", "minLength": 1},
        "in_claim": {"type": "boolean"},
        "hazard_statement": {"type": "string", "minLength": 1},
        "method_ref": {"type": "string", "minLength": 1, "description": "Domain-appropriate method, e.g. FMEA/FMECA, FTA, STPA, HAZOP, code or professional risk method. No universal score is imposed."},
        "owner_ref": {"type": "string", "minLength": 1},
        "severity_class": {"type": "string", "minLength": 1},
        "likelihood_basis": {"type": "string", "minLength": 1},
        "mitigation_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "verification_method": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "state": {"enum": ["OPEN", "MITIGATED", "CLOSED", "ACCEPTED_OUTSIDE_CLAIM", "HOLD"]},
        "residual_risk_owner_ref": {"type": "string", "minLength": 1},
        "reopen_triggers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
