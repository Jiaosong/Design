        "required_maturity_to_close": {
          "enum": [
            "IDENTIFIED",
            "DEFINED",
            "COORDINATED",
            "EXERCISED",
            "VERIFIED"
          ]
        },
        "allowed_dispositions_on_exit": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "OPEN",
              "BLOCKED",
              "CLOSED",
              "OUTSIDE_CLAIM"
            ]
          }
        },
        "acceptance_contract_ref": {
          "type": [
            "string",
