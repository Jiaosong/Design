    "stageInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_instance_id",
        "stage_definition_ref",
        "stage_id",
        "cycle",
        "baseline_ref",
        "execution_state",
        "review_verdict",
        "claim_ceiling",
        "inputs",
        "outputs",
        "consequential_knowledge_mount_required",
        "knowledge_mount_refs",
        "interface_refs",
        "evidence_refs",
        "review_refs",
        "open_items",
        "stale_scope",
        "reopen_events",
        "exit_condition_state",
        "actual_readback_refs",
        "last_updated"
      ],
      "properties": {
        "stage_instance_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "stage_definition_ref": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "stage_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "cycle": {
          "type": "integer",
          "minimum": 1
        },
        "baseline_ref": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "execution_state": {
          "$ref": "#/$defs/executionState"
        },
        "review_verdict": {
          "$ref": "#/$defs/professionalVerdict"
        },
        "claim_ceiling": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "inputs": {
          "$ref": "#/$defs/stringArray"
        },
        "outputs": {
          "$ref": "#/$defs/stringArray"
        },
        "consequential_knowledge_mount_required": {
          "type": "boolean"
        },
        "knowledge_mount_refs": {
          "$ref": "#/$defs/stringArray"
        },
        "interface_refs": {
          "$ref": "#/$defs/stringArray"
        },
        "evidence_refs": {
          "$ref": "#/$defs/stringArray"
        },
        "review_refs": {
          "$ref": "#/$defs/stringArray"
        },
        "open_items": {
          "$ref": "#/$defs/stringArray"
        },
        "stale_scope": {
          "$ref": "#/$defs/stringArray"
        },
        "reopen_events": {
          "$ref": "#/$defs/stringArray"
        },
        "exit_condition_state": {
          "enum": [
            "NOT_EVALUATED",
            "OPEN",
            "SATISFIED",
            "BLOCKED",
            "STALE"
          ]
        },
        "actual_readback_refs": {
          "$ref": "#/$defs/stringArray"
        },
        "last_updated": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "granularity_binding_state": {
          "enum": [
            "LEGACY_STAGE_ONLY",
            "DECISION_OBJECT_BOUND"
          ]
        },
        "decision_object_refs": {
          "$ref": "#/$defs/stringArray"
        },
        "claim_refs": {
          "$ref": "#/$defs/stringArray"
        },
        "output_execution_bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/outputExecutionBinding"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "execution_state": {
                "const": "BLOCKED"
              }
            },
            "required": [
              "execution_state"
            ]
          },
          "then": {
            "properties": {
              "open_items": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "execution_state": {
                "const": "STALE"
              }
            },
            "required": [
              "execution_state"
            ]
          },
          "then": {
            "properties": {
              "stale_scope": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "execution_state": {
                "const": "CLOSED"
              },
              "review_verdict": {
                "enum": [
                  "PASS",
                  "REVISE",
                  "REJECT"
                ]
              }
            },
            "required": [
              "execution_state",
              "review_verdict"
            ]
          },
          "then": {
            "properties": {
              "outputs": {
                "minItems": 1
              },
              "review_refs": {
                "minItems": 1
              },
              "actual_readback_refs": {
                "minItems": 1
              },
              "exit_condition_state": {
                "const": "SATISFIED"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "execution_state": {
                "const": "CLOSED"
              },
              "consequential_knowledge_mount_required": {
                "const": true
              }
            },
            "required": [
              "execution_state",
              "consequential_knowledge_mount_required"
            ]
          },
          "then": {
            "properties": {
              "knowledge_mount_refs": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "granularity_binding_state": {
                "const": "DECISION_OBJECT_BOUND"
              }
            },
            "required": [
              "granularity_binding_state"
            ]
          },
          "then": {
            "required": [
              "decision_object_refs",
              "claim_refs",
              "output_execution_bindings"
            ],
            "properties": {
              "decision_object_refs": {
                "minItems": 1
              },
              "claim_refs": {
                "minItems": 1
              },
              "output_execution_bindings": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
