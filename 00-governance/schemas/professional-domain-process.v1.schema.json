{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oleander.local/schemas/professional-domain-process.v1.schema.json",
  "title": "OLEANDER Professional Domain Process v1",
  "description": "Subordinate machine contract for reusable professional-domain process definitions and project/runtime process instances. It does not define universal professional stages or replace the Master Runtime, Knowledge Architecture, Cross-Disciplinary Integration, Design Quality review, or domain-specific receipts.",
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringArray": {
      "type": "array",
      "items": {"$ref": "#/$defs/nonEmptyString"}
    },
    "interfaceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interface_binding_id",
        "source_domain",
        "source_stage_ref",
        "direction",
        "shared_variables",
        "coupling",
        "criticality",
        "required_maturity_to_enter",
        "required_maturity_to_close",
        "allowed_dispositions_on_exit",
        "native_source_of_truth",
        "change_reopen_rule"
      ],
      "properties": {
        "interface_binding_id": {"$ref": "#/$defs/nonEmptyString"},
        "source_domain": {"$ref": "#/$defs/nonEmptyString"},
        "source_stage_ref": {"type": ["string", "null"], "minLength": 1},
        "direction": {"enum": ["IN", "OUT", "BIDIRECTIONAL"]},
        "shared_variables": {"$ref": "#/$defs/stringArray"},
        "coupling": {"enum": ["INFORMATIVE", "DEPENDENT", "RECIPROCAL", "TIGHTLY_COUPLED"]},
        "criticality": {"enum": ["ROUTINE", "MATERIAL", "MAJOR", "CRITICAL"]},
        "required_maturity_to_enter": {"enum": ["IDENTIFIED", "DEFINED", "COORDINATED", "EXERCISED", "VERIFIED"]},
        "required_maturity_to_close": {"enum": ["IDENTIFIED", "DEFINED", "COORDINATED", "EXERCISED", "VERIFIED"]},
        "allowed_dispositions_on_exit": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["OPEN", "BLOCKED", "CLOSED", "OUTSIDE_CLAIM"]}
        },
        "acceptance_contract_ref": {"type": ["string", "null"], "minLength": 1},
        "native_source_of_truth": {"$ref": "#/$defs/nonEmptyString"},
        "change_reopen_rule": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "stageDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_id",
        "stage_name",
        "professional_question",
        "entry_conditions",
        "required_inputs",
        "knowledge_inputs",
        "required_dd_dimensions",
        "required_native_outputs",
        "interface_requirements",
        "interface_bindings",
        "required_readback",
        "professional_review_owner",
        "open_items_allowed",
        "exit_conditions",
        "reopen_triggers",
        "claim_ceiling",
        "does_not_prove"
      ],
      "properties": {
        "stage_id": {"$ref": "#/$defs/nonEmptyString"},
        "stage_name": {"$ref": "#/$defs/nonEmptyString"},
        "professional_question": {"$ref": "#/$defs/nonEmptyString"},
        "entry_conditions": {"$ref": "#/$defs/stringArray"},
        "required_inputs": {"$ref": "#/$defs/stringArray"},
        "knowledge_inputs": {"$ref": "#/$defs/stringArray"},
        "required_dd_dimensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["DD-01", "DD-02", "DD-03", "DD-04", "DD-05", "DD-06", "DD-07", "DD-08", "DD-09", "DD-10", "DD-11", "DD-12"]
          }
        },
        "required_native_outputs": {"$ref": "#/$defs/stringArray"},
        "interface_requirements": {"$ref": "#/$defs/stringArray"},
        "interface_bindings": {
          "type": "array",
          "items": {"$ref": "#/$defs/interfaceBinding"}
        },
        "human_experience_consequences": {"$ref": "#/$defs/stringArray"},
        "design_language_consequences": {"$ref": "#/$defs/stringArray"},
        "technical_consequences": {"$ref": "#/$defs/stringArray"},
        "content_projection_requirements": {"$ref": "#/$defs/stringArray"},
        "required_readback": {"$ref": "#/$defs/stringArray"},
        "professional_review_owner": {"$ref": "#/$defs/nonEmptyString"},
        "independent_review_requirement": {"type": "string"},
        "open_items_allowed": {"$ref": "#/$defs/stringArray"},
        "exit_conditions": {"$ref": "#/$defs/stringArray"},
        "reopen_triggers": {"$ref": "#/$defs/stringArray"},
        "claim_ceiling": {"$ref": "#/$defs/nonEmptyString"},
        "does_not_prove": {"$ref": "#/$defs/stringArray"}
      }
    },
    "processDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "process_id",
        "domain",
        "version",
        "title",
        "purpose",
        "scope_in",
        "scope_out",
        "authority_position",
        "current_definition_ref",
        "trigger",
        "knowledge_binding",
        "stages",
        "interface_contract",
        "execution_binding",
        "assurance",
        "change_contract",
        "completion_contract"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "kind": {"const": "PROFESSIONAL_DOMAIN_PROCESS_DEFINITION"},
        "process_id": {"$ref": "#/$defs/nonEmptyString"},
        "domain": {"$ref": "#/$defs/nonEmptyString"},
        "version": {"$ref": "#/$defs/nonEmptyString"},
        "title": {"$ref": "#/$defs/nonEmptyString"},
        "purpose": {"$ref": "#/$defs/nonEmptyString"},
        "scope_in": {"$ref": "#/$defs/stringArray"},
        "scope_out": {"$ref": "#/$defs/stringArray"},
        "authority_position": {"$ref": "#/$defs/nonEmptyString"},
        "current_definition_ref": {"$ref": "#/$defs/nonEmptyString"},
        "trigger": {
          "type": "object",
          "additionalProperties": false,
          "required": ["project_flow_trigger", "design_question_types", "responsibility_triggers", "claim_ceiling_rule", "not_triggered_when", "mandatory_reopen_triggers"],
          "properties": {
            "project_flow_trigger": {"$ref": "#/$defs/nonEmptyString"},
            "design_question_types": {"$ref": "#/$defs/stringArray"},
            "responsibility_triggers": {"$ref": "#/$defs/stringArray"},
            "claim_ceiling_rule": {"$ref": "#/$defs/nonEmptyString"},
            "not_triggered_when": {"$ref": "#/$defs/stringArray"},
            "mandatory_reopen_triggers": {"$ref": "#/$defs/stringArray"}
          }
        },
        "knowledge_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required_methods", "theory_routes", "source_routes", "evidence_routes", "precedent_case_routes", "practice_routes"],
          "properties": {
            "required_methods": {"$ref": "#/$defs/stringArray"},
            "theory_routes": {"$ref": "#/$defs/stringArray"},
            "source_routes": {"$ref": "#/$defs/stringArray"},
            "evidence_routes": {"$ref": "#/$defs/stringArray"},
            "standard_code_routes": {"$ref": "#/$defs/stringArray"},
            "precedent_case_routes": {"$ref": "#/$defs/stringArray"},
            "practice_routes": {"$ref": "#/$defs/stringArray"},
            "tool_knowledge_routes": {"$ref": "#/$defs/stringArray"}
          }
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/stageDefinition"}
        },
        "interface_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["integration_owner_ref", "inputs_from_domains", "outputs_to_domains", "shared_variables", "controlling_authority_requirements", "required_interface_maturity_to_enter", "required_interface_maturity_to_close", "allowed_open_interface_conditions", "integration_readback_requirements"],
          "properties": {
            "integration_owner_ref": {"$ref": "#/$defs/nonEmptyString"},
            "inputs_from_domains": {"$ref": "#/$defs/stringArray"},
            "outputs_to_domains": {"$ref": "#/$defs/stringArray"},
            "shared_variables": {"$ref": "#/$defs/stringArray"},
            "controlling_authority_requirements": {"$ref": "#/$defs/stringArray"},
            "required_interface_maturity_to_enter": {"enum": ["IDENTIFIED", "DEFINED", "COORDINATED", "EXERCISED", "VERIFIED"]},
            "required_interface_maturity_to_close": {"enum": ["IDENTIFIED", "DEFINED", "COORDINATED", "EXERCISED", "VERIFIED"]},
            "allowed_open_interface_conditions": {"$ref": "#/$defs/stringArray"},
            "integration_readback_requirements": {"$ref": "#/$defs/stringArray"}
          }
        },
        "execution_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required_native_outputs", "native_source_of_truth_rules", "execution_owner_requirements", "required_capabilities", "tool_adapter_requirements", "typed_handoff_contracts", "actual_readback_requirements"],
          "properties": {
            "required_native_outputs": {"$ref": "#/$defs/stringArray"},
            "native_source_of_truth_rules": {"$ref": "#/$defs/stringArray"},
            "execution_owner_requirements": {"$ref": "#/$defs/stringArray"},
            "required_capabilities": {"$ref": "#/$defs/stringArray"},
            "tool_adapter_requirements": {"$ref": "#/$defs/stringArray"},
            "typed_handoff_contracts": {"$ref": "#/$defs/stringArray"},
            "actual_readback_requirements": {"$ref": "#/$defs/stringArray"}
          }
        },
        "assurance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["professional_review", "evidence_review", "technical_gates", "independent_review", "receipt_contract", "does_not_prove"],
          "properties": {
            "professional_review": {"$ref": "#/$defs/nonEmptyString"},
            "evidence_review": {"$ref": "#/$defs/nonEmptyString"},
            "technical_gates": {"$ref": "#/$defs/stringArray"},
            "independent_review": {"$ref": "#/$defs/nonEmptyString"},
            "receipt_contract": {"$ref": "#/$defs/nonEmptyString"},
            "does_not_prove": {"$ref": "#/$defs/stringArray"}
          }
        },
        "change_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reopen_triggers", "stale_scope_rules", "upstream_impact_rules", "downstream_impact_rules", "interface_reopen_rules", "receipt_stale_rules"],
          "properties": {
            "reopen_triggers": {"$ref": "#/$defs/stringArray"},
            "stale_scope_rules": {"$ref": "#/$defs/stringArray"},
            "upstream_impact_rules": {"$ref": "#/$defs/stringArray"},
            "downstream_impact_rules": {"$ref": "#/$defs/stringArray"},
            "interface_reopen_rules": {"$ref": "#/$defs/stringArray"},
            "receipt_stale_rules": {"$ref": "#/$defs/stringArray"}
          }
        },
        "completion_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["process_exit_conditions", "open_items_allowed", "professional_receipt", "promotion_effect", "claim_ceiling", "does_not_prove"],
          "properties": {
            "process_exit_conditions": {"$ref": "#/$defs/stringArray"},
            "open_items_allowed": {"$ref": "#/$defs/stringArray"},
            "professional_receipt": {"$ref": "#/$defs/nonEmptyString"},
            "promotion_effect": {"$ref": "#/$defs/nonEmptyString"},
            "claim_ceiling": {"$ref": "#/$defs/nonEmptyString"},
            "does_not_prove": {"$ref": "#/$defs/stringArray"}
          }
        }
      }
    },
    "stageInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_instance_id",
        "stage_definition_ref",
        "stage_id",
        "cycle",
        "baseline_ref",
        "execution_state",
        "review_verdict",
        "claim_ceiling",
        "inputs",
        "outputs",
        "interface_refs",
        "evidence_refs",
        "review_refs",
        "open_items",
        "stale_scope",
        "reopen_events",
        "exit_condition_state",
        "actual_readback_refs",
        "last_updated"
      ],
      "properties": {
        "stage_instance_id": {"$ref": "#/$defs/nonEmptyString"},
        "stage_definition_ref": {"$ref": "#/$defs/nonEmptyString"},
        "stage_id": {"$ref": "#/$defs/nonEmptyString"},
        "cycle": {"type": "integer", "minimum": 1},
        "baseline_ref": {"$ref": "#/$defs/nonEmptyString"},
        "execution_state": {"enum": ["NOT_STARTED", "READY", "IN_PROGRESS", "BLOCKED", "CURRENT", "STALE", "CLOSED", "SUPERSEDED"]},
        "review_verdict": {"enum": ["NOT_RUN", "N_A", "PASS", "REVISE", "REJECT", "HOLD"]},
        "claim_ceiling": {"$ref": "#/$defs/nonEmptyString"},
        "inputs": {"$ref": "#/$defs/stringArray"},
        "outputs": {"$ref": "#/$defs/stringArray"},
        "interface_refs": {"$ref": "#/$defs/stringArray"},
        "evidence_refs": {"$ref": "#/$defs/stringArray"},
        "review_refs": {"$ref": "#/$defs/stringArray"},
        "open_items": {"$ref": "#/$defs/stringArray"},
        "stale_scope": {"$ref": "#/$defs/stringArray"},
        "reopen_events": {"$ref": "#/$defs/stringArray"},
        "exit_condition_state": {"enum": ["NOT_EVALUATED", "OPEN", "SATISFIED", "BLOCKED", "STALE"]},
        "actual_readback_refs": {"$ref": "#/$defs/stringArray"},
        "last_updated": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "processInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "instance_id",
        "project_id",
        "decision_object_refs",
        "process_definition_ref",
        "process_id",
        "process_version",
        "domain",
        "owner",
        "current_baseline",
        "execution_state",
        "claim_ceiling",
        "stage_instances",
        "active_interface_refs",
        "open_items",
        "professional_receipt_refs",
        "integration_receipt_refs",
        "stale_scope",
        "reopen_events",
        "last_updated"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "kind": {"const": "DOMAIN_PROCESS_INSTANCE"},
        "instance_id": {"$ref": "#/$defs/nonEmptyString"},
        "project_id": {"$ref": "#/$defs/nonEmptyString"},
        "workstream_id": {"type": ["string", "null"]},
        "decision_object_refs": {"$ref": "#/$defs/stringArray"},
        "process_definition_ref": {"$ref": "#/$defs/nonEmptyString"},
        "process_id": {"$ref": "#/$defs/nonEmptyString"},
        "process_version": {"$ref": "#/$defs/nonEmptyString"},
        "domain": {"$ref": "#/$defs/nonEmptyString"},
        "owner": {"$ref": "#/$defs/nonEmptyString"},
        "current_baseline": {"$ref": "#/$defs/nonEmptyString"},
        "execution_state": {"enum": ["NOT_STARTED", "READY", "IN_PROGRESS", "BLOCKED", "CURRENT", "STALE", "CLOSED", "SUPERSEDED"]},
        "claim_ceiling": {"$ref": "#/$defs/nonEmptyString"},
        "stage_instances": {
          "type": "array",
          "items": {"$ref": "#/$defs/stageInstance"}
        },
        "active_interface_refs": {"$ref": "#/$defs/stringArray"},
        "open_items": {"$ref": "#/$defs/stringArray"},
        "professional_receipt_refs": {"$ref": "#/$defs/stringArray"},
        "integration_receipt_refs": {"$ref": "#/$defs/stringArray"},
        "stale_scope": {"$ref": "#/$defs/stringArray"},
        "reopen_events": {"$ref": "#/$defs/stringArray"},
        "last_updated": {"$ref": "#/$defs/nonEmptyString"}
      }
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/processDefinition"},
    {"$ref": "#/$defs/processInstance"}
  ]
}
