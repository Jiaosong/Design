{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oleander.local/schemas/professional-domain-process.v1.schema.json",
  "title": "OLEANDER Professional Domain Process v1",
  "description": "Subordinate machine contract for reusable professional-domain process definitions and project/runtime process instances. It preserves authentic domain stages, delegates consequential knowledge admission to the Knowledge Integrity & Operational Mount contract, and does not replace the Master Runtime, Knowledge Architecture, Cross-Disciplinary Integration, Design Quality review, or domain-specific receipts.",
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "professionalVerdict": {
      "enum": [
        "NOT_RUN",
        "N_A",
        "PASS",
        "REVISE",
        "REJECT",
        "HOLD"
      ]
    },
    "executionState": {
      "enum": [
        "NOT_STARTED",
        "READY",
        "IN_PROGRESS",
        "BLOCKED",
        "CURRENT",
        "STALE",
        "CLOSED",
        "SUPERSEDED"
      ]
    },
    "interfaceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interface_binding_id",
        "source_domain",
        "source_stage_ref",
        "direction",
        "shared_variables",
        "coupling",
        "criticality",
        "required_maturity_to_enter",
        "required_maturity_to_close",
        "allowed_dispositions_on_exit",
        "native_source_of_truth",
        "change_reopen_rule"
      ],
      "properties": {
        "interface_binding_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source_domain": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source_stage_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "direction": {
          "enum": [
            "IN",
            "OUT",
            "BIDIRECTIONAL"
          ]
        },
        "shared_variables": {
          "$ref": "#/$defs/stringArray"
        },
        "coupling": {
          "enum": [
            "INFORMATIVE",
            "DEPENDENT",
            "RECIPROCAL",
            "TIGHTLY_COUPLED"
          ]
        },
        "criticality": {
          "enum": [
            "ROUTINE",
            "MATERIAL",
            "MAJOR",
            "CRITICAL"
