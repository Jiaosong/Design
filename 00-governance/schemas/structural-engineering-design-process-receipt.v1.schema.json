{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oleander.structural-engineering-design-process-receipt.v1",
  "title": "OLEANDER Structural Engineering Design Process Receipt v1",
  "type": "object",
  "required": [
    "receipt_type", "schema_version", "project_id", "process_ref", "source_revision",
    "claim_ceiling", "basis_of_structural_design_ref", "stage_records", "analysis_model_refs",
    "calculation_drawing_trace_refs", "interface_summary", "independent_check", "blocking_open_items",
    "open_items", "reopened_items", "stale", "result", "does_not_prove"
  ],
  "properties": {
    "receipt_type": {"const": "STRUCTURAL_ENGINEERING_DESIGN_PROCESS_RECEIPT"},
    "schema_version": {"const": "1.0"},
    "project_id": {"type": "string", "minLength": 1},
    "workstream_id": {"type": ["string", "null"]},
    "process_ref": {"const": "00-governance/schemas/structural-engineering-design-process.v1.json"},
    "source_revision": {"type": "string", "minLength": 1},
    "claim_ceiling": {"type": "string", "minLength": 1},
    "basis_of_structural_design_ref": {"type": "string", "minLength": 1},
    "stage_records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stageRecord"}},
    "analysis_model_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "calculation_drawing_trace_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "field_shop_change_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "interface_summary": {"type": "array", "items": {"$ref": "#/$defs/interfaceRecord"}},
    "independent_check": {"$ref": "#/$defs/reviewRecord"},
    "blocking_open_items": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "open_items": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "reopened_items": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "stale": {"type": "boolean"},
    "result": {"enum": ["PASS", "REVISE", "REJECT", "HOLD"]},
    "does_not_prove": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "stageRecord": {
      "type": "object",
      "required": ["stage_id", "triggered", "status", "knowledge_mount_refs", "native_output_refs", "actual_readback_refs", "checking_state", "interface_state", "open_items"],
      "properties": {
        "stage_id": {"enum": ["SE-SPW0", "SE-SPW1", "SE-SPW2", "SE-SPW3", "SE-SPW4", "SE-SPW4.5", "SE-SPW5", "SE-SPW6", "SE-SPW7"]},
        "triggered": {"type": "boolean"},
        "status": {"enum": ["NOT_TRIGGERED", "PENDING", "IN_PROGRESS", "PASS", "REVISE", "REJECT", "HOLD", "STALE"]},
        "knowledge_mount_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "native_output_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "actual_readback_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "checking_state": {"enum": ["NOT_REQUIRED", "NOT_RUN", "PASS", "FAIL", "HOLD"]},
        "interface_state": {"enum": ["NOT_REQUIRED", "OPEN", "COORDINATED", "PASS", "FAIL", "HOLD"]},
        "open_items": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "interfaceRecord": {
      "type": "object",
      "required": ["interface_id", "required", "state", "evidence_refs"],
      "properties": {
        "interface_id": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "state": {"enum": ["NOT_REQUIRED", "OPEN", "PASS", "FAIL", "HOLD"]},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "reviewRecord": {
      "type": "object",
      "required": ["required", "state", "reviewer_ref", "review_input_refs"],
      "properties": {
        "required": {"type": "boolean"},
        "state": {"enum": ["NOT_REQUIRED", "NOT_RUN", "PASS", "FAIL", "HOLD"]},
        "reviewer_ref": {"type": ["string", "null"]},
        "review_input_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
