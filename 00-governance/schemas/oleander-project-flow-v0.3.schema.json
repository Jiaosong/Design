{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oleander.project-flow.v0.3",
  "title": "OLEANDER Canonical Project Flow Contract v0.3",
  "type": "object",
  "required": [
    "project",
    "decision_question",
    "design_state",
    "authority",
    "fidelity",
    "locked_variables",
    "open_variables",
    "exit_condition",
    "persistence"
  ],
  "$defs": {
    "application_mapping_code": {
      "enum": [
        "B01", "B02", "B03", "B04",
        "CU01", "CU02", "CU03", "CU04",
        "IP01", "IP02", "IP03", "IP04",
        "SP01", "SP02", "SP03", "SP04"
      ]
    },
    "knowledge_level": {
      "enum": ["L0", "L1", "L2", "L3", "L4", "L5", "L6", "L7"]
    }
  },
  "properties": {
    "project": {
      "type": "object",
      "required": ["name", "project_level", "project_id"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "project_level": {
          "enum": ["P0", "P1", "P2", "P3", "P4"],
          "description": "Project Axis level only: P0 Portfolio / P1 Program / P2 Project / P3 Workstream / P4 Validation."
        },
        "project_id": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "^(?:C[0-9]{2,}|B0[1-4]|CU0[1-4]|IP0[1-4]|SP0[1-4]|Priority-[0-3]|AIG-0[1-3])$"
          },
          "description": "Explicit Project Axis identity. Bare Case IDs, Application Mapping codes, Delivery Priority codes and AIG governance IDs are machine-rejected here."
        },
        "case_id": {
          "type": ["string", "null"],
          "pattern": "^C[0-9]{2,}$",
          "description": "Canonical Case Axis ID where applicable. It does not substitute for project_id."
        },
        "delivery_priority": {
          "enum": ["Priority-0", "Priority-1", "Priority-2", "Priority-3", null]
        },
        "application_primary_mapping": {
          "anyOf": [
            {"$ref": "#/$defs/application_mapping_code"},
            {"type": "null"}
          ],
          "description": "Primary Application Mapping only; not Knowledge Architecture ownership and not Project Axis identity."
        },
        "application_mapping": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/application_mapping_code"},
          "description": "Business/Culture/IP/Spatial application locations only."
        },
        "knowledge_context": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["domain", "level"],
            "properties": {
              "domain": {"type": "string", "minLength": 1},
              "level": {"$ref": "#/$defs/knowledge_level"},
              "object_id": {"type": ["string", "null"]}
            },
            "additionalProperties": false
          },
          "description": "Knowledge Architecture references. Each object resolves an explicit Domain and exact L0-L7 level before Application Mapping."
        }
      },
      "additionalProperties": false
    },
    "decision_question": {"type": "string", "minLength": 1},
    "loop": {"enum": ["EXPLORATION_SANDBOX", "CANONICAL_PRODUCTION"]},
    "design_state": {"enum": ["EXPLORE", "CANDIDATE", "REVISE", "REJECTED", "PROMOTED", "LOCKED", "SUPERSEDED"]},
    "job_state": {"enum": ["CREATED", "RESOLVED", "QUEUED", "RUNNING", "SUCCEEDED", "FAILED", "CANCELLED", "CACHED"]},
    "authority": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["state"],
        "properties": {
          "state": {"enum": ["NONE", "WORKING_SOURCE", "CANDIDATE_AUTHORITY", "CANONICAL_AUTHORITY", "FROZEN_AUTHORITY"]},
          "source": {"type": ["string", "null"]},
          "hash": {"type": ["string", "null"]}
        }
      }
    },
    "fidelity": {"enum": ["FID0_PREFLIGHT", "FID1_DESIGN_VALIDATION", "FID2_PROMOTION", "FID3_PRESENTATION"]},
    "locked_variables": {"type": "array", "items": {"type": "string"}},
    "open_variables": {"type": "array", "items": {"type": "string"}},
    "comparison": {
      "type": "object",
      "properties": {
        "candidates": {"type": "array", "items": {"type": "string"}},
        "reading_scale": {"type": "array", "items": {"type": "string"}},
        "failure_signs": {"type": "array", "items": {"type": "string"}},
        "review_contract_hash": {"type": ["string", "null"]}
      }
    },
    "resource_budget": {
      "type": "object",
      "properties": {
        "max_variants": {"type": "integer", "minimum": 1},
        "max_iterations": {"type": "integer", "minimum": 0},
        "max_runtime_minutes": {"type": "number", "minimum": 0},
        "max_resolution": {"type": "integer", "minimum": 1},
        "parallelism": {"type": "integer", "minimum": 1}
      }
    },
    "execution": {
      "type": "object",
      "properties": {
        "capability": {"type": "string"},
        "worker": {"type": "string"},
        "runtime": {"type": "string"},
        "scene_compile_hash": {"type": ["string", "null"]},
        "artifact_cache_key": {"type": ["string", "null"]}
      }
    },
    "qa": {
      "type": "object",
      "properties": {
        "machine": {"enum": ["PENDING", "PASS", "REVISE", "BLOCKED", "FAILED"]},
        "visual": {"enum": ["PENDING", "PASS", "REVISE", "REJECT", "BLOCKED"]},
        "project": {"enum": ["PENDING", "PASS", "REVISE", "REJECT", "BLOCKED"]},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "design_quality_development": {
      "type": "object",
      "required": ["triggered", "status", "stale"],
      "properties": {
        "triggered": {"type": "boolean"},
        "status": {"enum": ["NOT_TRIGGERED", "PENDING", "IN_PROGRESS", "KEEP", "REVISE", "REJECT", "HOLD", "STALE_AT_AFFECTED_SCOPE"]},
        "maturity": {"enum": ["DQ0_UNDEFINED", "DQ1_DIRECTION", "DQ2_COHERENT_CANDIDATE", "DQ3_DEVELOPED_SYSTEM", "DQ4_DISTINCTIVE_RESOLVED_SYSTEM", "DQ5_PROVEN_CROSS_CONTEXT_LANGUAGE", null]},
        "receipt": {"type": ["string", "null"]},
        "receipt_hash": {"type": ["string", "null"]},
        "project_design_dna_ref": {"type": ["string", "null"]},
        "open_items": {"type": "array", "items": {"type": "string"}},
        "reopened_items": {"type": "array", "items": {"type": "string"}},
        "stale": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "architecture_design_development": {
      "type": "object",
      "required": ["triggered", "status"],
      "properties": {
        "triggered": {"type": "boolean"},
        "status": {"enum": ["NOT_TRIGGERED", "PENDING", "IN_PROGRESS", "PASS", "REVISE", "REJECT", "HOLD", "STALE_AT_AFFECTED_SCOPE"]},
        "receipt": {"type": ["string", "null"]},
        "receipt_hash": {"type": ["string", "null"]},
        "open_items": {"type": "array", "items": {"type": "string"}},
        "reopened_items": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "project_requirement_acceptance": {
      "type": "object",
      "required": ["triggered", "status", "stale"],
      "properties": {
        "triggered": {"type": "boolean"},
        "status": {"enum": ["NOT_TRIGGERED", "PENDING", "IN_PROGRESS", "PASS", "REVISE", "REJECT", "HOLD", "STALE_AT_AFFECTED_SCOPE"]},
        "baseline_ref": {"type": ["string", "null"]},
        "baseline_hash": {"type": ["string", "null"]},
        "blocking_requirement_ids": {"type": "array", "items": {"type": "string"}},
        "stale": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "cross_disciplinary_integration": {
      "type": "object",
      "required": ["triggered", "status", "stale"],
      "properties": {
        "triggered": {"type": "boolean"},
        "status": {"enum": ["NOT_TRIGGERED", "PENDING", "IN_PROGRESS", "PASS", "REVISE", "REJECT", "HOLD", "STALE_AT_AFFECTED_SCOPE"]},
        "receipt": {"type": ["string", "null"]},
        "receipt_hash": {"type": ["string", "null"]},
        "open_major_critical_interfaces": {"type": "array", "items": {"type": "string"}},
        "stale": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "professional_processes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["domain", "triggered", "status", "stale"],
        "properties": {
          "domain": {"type": "string", "minLength": 1},
          "triggered": {"type": "boolean"},
          "status": {"enum": ["NOT_TRIGGERED", "PENDING", "IN_PROGRESS", "PASS", "REVISE", "REJECT", "HOLD", "STALE_AT_AFFECTED_SCOPE"]},
          "receipt": {"type": ["string", "null"]},
          "receipt_hash": {"type": ["string", "null"]},
          "capability_holds": {"type": "array", "items": {"type": "string"}},
          "stale": {"type": "boolean"}
        },
        "additionalProperties": true
      }
    },
    "technical_drawing_execution": {
      "type": "object",
      "required": ["triggered", "owner_state"],
      "properties": {
        "triggered": {"type": "boolean"},
        "owner_state": {"enum": ["NOT_TRIGGERED", "CURRENT_CALLABLE", "PROJECT_SPECIALIST_BOUND", "CANDIDATE_BODY_HOLD"]},
        "owner_ref": {"type": ["string", "null"]},
        "binding_ref": {"type": ["string", "null"]},
        "binding_hash": {"type": ["string", "null"]},
        "required_native_outputs": {"type": "array", "items": {"type": "string"}},
        "hold_reason": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "configuration_change_control": {
      "type": "object",
      "required": ["triggered", "status", "stale"],
      "properties": {
        "triggered": {"type": "boolean"},
        "status": {"enum": ["NOT_TRIGGERED", "PENDING", "IN_PROGRESS", "PASS", "REVISE", "REJECT", "HOLD", "STALE_AT_AFFECTED_SCOPE"]},
        "register_ref": {"type": ["string", "null"]},
        "register_hash": {"type": ["string", "null"]},
        "open_issue_ids": {"type": "array", "items": {"type": "string"}},
        "stale": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "risk_hazard_control": {
      "type": "object",
      "required": ["triggered", "status", "stale"],
      "properties": {
        "triggered": {"type": "boolean"},
        "status": {"enum": ["NOT_TRIGGERED", "PENDING", "IN_PROGRESS", "PASS", "REVISE", "REJECT", "HOLD", "STALE_AT_AFFECTED_SCOPE"]},
        "register_ref": {"type": ["string", "null"]},
        "register_hash": {"type": ["string", "null"]},
        "blocking_risk_ids": {"type": "array", "items": {"type": "string"}},
        "stale": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "operational_acceptance": {
      "type": "object",
      "required": ["triggered", "status", "stale"],
      "properties": {
        "triggered": {"type": "boolean"},
        "status": {"enum": ["NOT_TRIGGERED", "PENDING", "IN_PROGRESS", "PASS", "REVISE", "REJECT", "HOLD", "STALE_AT_AFFECTED_SCOPE"]},
        "compilation_ref": {"type": ["string", "null"]},
        "compilation_hash": {"type": ["string", "null"]},
        "blocking_items": {"type": "array", "items": {"type": "string"}},
        "stale": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "exit_condition": {"type": "string", "minLength": 1},
    "promotion": {
      "type": "object",
      "properties": {
        "eligible": {"type": "boolean"},
        "decision": {"enum": ["PENDING", "PROMOTE", "REVISE", "REJECT", "BLOCK"]},
        "reason": {"type": "string"}
      }
    },
    "artifact": {
      "type": "object",
      "properties": {
        "artifact_id": {"type": ["string", "null"]},
        "artifact_hash": {"type": ["string", "null"]},
        "source_job": {"type": ["string", "null"]},
        "supersedes": {"type": ["string", "null"]}
      }
    },
    "persistence": {
      "type": "object",
      "required": ["policy", "pap_required", "pap_status"],
      "properties": {
        "policy": {"enum": ["TEMP_ONLY", "RECEIPT_ONLY", "PRE_PROMOTION_PAP", "PROMOTION_SYNC", "CONTRACT_REQUIRED_SYNC"]},
        "pap_required": {"type": "boolean"},
        "pap_status": {"enum": ["NOT_TRIGGERED", "PENDING", "FAIL", "PASS"]},
        "durable_store": {"type": ["string", "null"]},
        "durable_file_id": {"type": ["string", "null"]},
        "retrieved_sha256": {"type": ["string", "null"]},
        "open_test": {"enum": ["NOT_RUN", "PASS", "FAIL", null]},
        "receipt": {"type": ["string", "null"]},
        "github": {"type": ["string", "null"]},
        "notion": {"type": ["string", "null"]},
        "drive": {"type": ["string", "null"]}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["promotion", "design_quality_development"],
        "properties": {
          "promotion": {
            "required": ["decision"],
            "properties": {"decision": {"const": "PROMOTE"}}
          },
          "design_quality_development": {
            "required": ["triggered"],
            "properties": {"triggered": {"const": true}}
          }
        }
      },
      "then": {
        "properties": {
          "design_quality_development": {
            "required": ["status", "receipt", "stale"],
            "properties": {
              "status": {"const": "KEEP"},
              "receipt": {"type": "string", "minLength": 1},
              "stale": {"const": false}
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["promotion", "architecture_design_development"],
        "properties": {
          "promotion": {
            "required": ["decision"],
            "properties": {"decision": {"const": "PROMOTE"}}
          },
          "architecture_design_development": {
            "required": ["triggered"],
            "properties": {"triggered": {"const": true}}
          }
        }
      },
      "then": {
        "properties": {
          "architecture_design_development": {
            "required": ["status", "receipt"],
            "properties": {
              "status": {"const": "PASS"},
              "receipt": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["promotion", "persistence"],
        "properties": {
          "promotion": {
            "required": ["decision"],
            "properties": {"decision": {"const": "PROMOTE"}}
          },
          "persistence": {
            "required": ["pap_required"],
            "properties": {"pap_required": {"const": true}}
          }
        }
      },
      "then": {
        "properties": {
          "persistence": {
            "required": ["pap_status"],
            "properties": {"pap_status": {"const": "PASS"}}
          }
        }
      }
    },
    {
      "if": {
        "required": ["promotion", "project_requirement_acceptance"],
        "properties": {
          "promotion": {"required": ["decision"], "properties": {"decision": {"const": "PROMOTE"}}},
          "project_requirement_acceptance": {"required": ["triggered"], "properties": {"triggered": {"const": true}}}
        }
      },
      "then": {
        "properties": {
          "project_requirement_acceptance": {
            "required": ["status", "baseline_ref", "stale"],
            "properties": {
              "status": {"const": "PASS"},
              "baseline_ref": {"type": "string", "minLength": 1},
              "stale": {"const": false},
              "blocking_requirement_ids": {"maxItems": 0}
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["promotion", "cross_disciplinary_integration"],
        "properties": {
          "promotion": {"required": ["decision"], "properties": {"decision": {"const": "PROMOTE"}}},
          "cross_disciplinary_integration": {"required": ["triggered"], "properties": {"triggered": {"const": true}}}
        }
      },
      "then": {
        "properties": {
          "cross_disciplinary_integration": {
            "required": ["status", "receipt", "stale"],
            "properties": {
              "status": {"const": "PASS"},
              "receipt": {"type": "string", "minLength": 1},
              "stale": {"const": false},
              "open_major_critical_interfaces": {"maxItems": 0}
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["promotion", "technical_drawing_execution"],
        "properties": {
          "promotion": {"required": ["decision"], "properties": {"decision": {"const": "PROMOTE"}}},
          "technical_drawing_execution": {"required": ["triggered"], "properties": {"triggered": {"const": true}}}
        }
      },
      "then": {
        "properties": {
          "technical_drawing_execution": {
            "required": ["owner_state", "owner_ref"],
            "properties": {
              "owner_state": {"enum": ["CURRENT_CALLABLE", "PROJECT_SPECIALIST_BOUND"]},
              "owner_ref": {"type": "string", "minLength": 1}
            },
            "oneOf": [
              {
                "properties": {
                  "owner_state": {"const": "CURRENT_CALLABLE"}
                }
              },
              {
                "required": ["binding_ref"],
                "properties": {
                  "owner_state": {"const": "PROJECT_SPECIALIST_BOUND"},
                  "binding_ref": {"type": "string", "minLength": 1}
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": ["promotion", "configuration_change_control"],
        "properties": {
          "promotion": {"required": ["decision"], "properties": {"decision": {"const": "PROMOTE"}}},
          "configuration_change_control": {"required": ["triggered"], "properties": {"triggered": {"const": true}}}
        }
      },
      "then": {
        "properties": {
          "configuration_change_control": {
            "required": ["status", "register_ref", "stale"],
            "properties": {
              "status": {"const": "PASS"},
              "register_ref": {"type": "string", "minLength": 1},
              "stale": {"const": false},
              "open_issue_ids": {"maxItems": 0}
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["promotion", "risk_hazard_control"],
        "properties": {
          "promotion": {"required": ["decision"], "properties": {"decision": {"const": "PROMOTE"}}},
          "risk_hazard_control": {"required": ["triggered"], "properties": {"triggered": {"const": true}}}
        }
      },
      "then": {
        "properties": {
          "risk_hazard_control": {
            "required": ["status", "register_ref", "stale"],
            "properties": {
              "status": {"const": "PASS"},
              "register_ref": {"type": "string", "minLength": 1},
              "stale": {"const": false},
              "blocking_risk_ids": {"maxItems": 0}
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["promotion", "operational_acceptance"],
        "properties": {
          "promotion": {"required": ["decision"], "properties": {"decision": {"const": "PROMOTE"}}},
          "operational_acceptance": {"required": ["triggered"], "properties": {"triggered": {"const": true}}}
        }
      },
      "then": {
        "properties": {
          "operational_acceptance": {
            "required": ["status", "compilation_ref", "stale"],
            "properties": {
              "status": {"const": "PASS"},
              "compilation_ref": {"type": "string", "minLength": 1},
              "stale": {"const": false},
              "blocking_items": {"maxItems": 0}
            }
          }
        }
      }
    }
  ]
}
