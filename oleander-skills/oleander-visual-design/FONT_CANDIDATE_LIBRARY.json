{
  "schema_version": "0.1",
  "status": "CANDIDATE_REGISTRY",
  "owner": "oleander-visual-design/TYPOGRAPHY_SYSTEM_EXTENSION.md",
  "policy": {
    "purpose": "Reusable discovery pool for open-source typography candidates; not a house style or automatic selection authority.",
    "selection": [
      "resolve language/content/medium/reading duty",
      "retrieve a materially diverse shortlist",
      "render real-content specimens",
      "check exact release/license/coverage/runtime/fallback",
      "human select/modify/reopen",
      "only then bind project Current"
    ],
    "exact_source_recheck_required": true,
    "font_binaries_stored_here": false
  },
