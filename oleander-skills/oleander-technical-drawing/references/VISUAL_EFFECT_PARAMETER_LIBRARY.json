{
  "library_id": "TD-VFX-PARAM-001",
  "version": "0.1",
  "status": "CANDIDATE / NO_PROMOTION",
  "knowledge_authority": "Notion / KN-METHOD-TECHDRAW-SPATIAL-TRANSLATION-001 + existing CMF / Motion knowledge",
  "boundary": "Parameters are candidate starting ranges for controlled experiments. They are not universal aesthetic rules, material facts, engineering tolerances or accessibility proof.",
  "global_rules": {
    "effect_off_rule": "Geometry, topology, state and required information must remain legible when non-essential effects are OFF.",
    "semantic_owner_required": true,
    "mapped_data_requires_legend": true,
    "source_fidelity_effects_may_not_upgrade_authority": true,
    "analytical_geometry_may_not_be_displaced_for_style": true,
    "reduced_motion_required_for_nontrivial_motion": true,
    "required_review_scales": ["NEAR", "MID", "FAR"],
    "preferred_units": {
      "opacity": "0..1",
      "blur": "px at target viewport",
      "stroke": "px at target viewport",
      "texture_spacing": "px at target viewport",
      "angle": "deg",
      "duration": "ms",
      "stagger": "ms/item",
      "displacement": "px at target viewport"
    }
  },
  "static_parameters": {
    "gradient": {
      "fields": ["axis_deg", "stops", "interpolation", "contrast_span", "mask_id", "role", "why", "off_state"],
      "candidate_ranges": {
        "stop_count": [2, 5],
        "tonal_lightness_span_hierarchy": [0.04, 0.18],
        "tonal_lightness_span_material": [0.03, 0.22],
        "tonal_lightness_span_analytical": "DATA_DERIVED_ONLY"
      },
      "fail_if": ["no semantic owner", "analytical field without mapped variable", "analytical field without legend", "gradient is sole carrier of geometry", "rainbow or multi-axis gradient has no variable model"]
    },
    "opacity_recession": {
      "fields": ["owner_id", "base_opacity", "recessed_opacity", "why", "off_state"],
      "candidate_ranges": {
        "recessed_opacity": [0.12, 0.55],
        "supporting_context_opacity": [0.25, 0.72]
      },
      "fail_if": ["opacity silently encodes certainty", "required source evidence becomes unreadable", "opacity is the only difference between critical states"]
    },
    "hatch": {
      "fields": ["owner_id", "angle_deg", "spacing_px", "stroke_px", "opacity", "phase_px", "mask_id", "role"],
      "candidate_ranges": {
        "spacing_px": [4, 24],
        "stroke_px": [0.5, 2.0],
        "opacity": [0.18, 0.75],
        "angle_deg": [-90, 90]
      },
      "fail_if": ["hatch spacing aliases at FAR scale", "hatch creates false boundary", "pattern has no owner"]
    },
    "stipple": {
      "fields": ["owner_id", "density", "radius_px", "jitter", "seed", "mask_id", "role"],
      "candidate_ranges": {
        "density": [0.01, 0.22],
        "radius_px": [0.35, 2.2],
        "jitter": [0.0, 0.9]
      },
      "fail_if": ["randomness changes analytical extent", "seed is not recorded", "density is interpreted as data without a mapping model"]
    },
    "grain": {
      "fields": ["owner_id", "base_frequency", "num_octaves", "seed", "opacity", "mask_id", "role", "off_state"],
      "candidate_ranges": {
        "base_frequency": [0.15, 1.2],
        "num_octaves": [1, 4],
        "opacity": [0.03, 0.18]
      },
      "fail_if": ["global uniform grain is used as generic polish", "grain reduces label/line legibility", "material claim exceeds evidence"]
    },
    "halftone": {
      "fields": ["owner_id", "cell_px", "dot_radius_px", "angle_deg", "mapping", "mask_id", "role"],
      "candidate_ranges": {
        "cell_px": [5, 24],
        "dot_radius_px": [0.6, 5.0]
      },
      "fail_if": ["mapped variable is not declared", "pattern becomes moire at target scale", "halftone is used as arbitrary decoration"]
    },
    "contour_band": {
      "fields": ["owner_id", "levels", "interval_model", "stroke_px", "fill_opacity", "legend_id", "role"],
      "candidate_ranges": {
        "stroke_px": [0.5, 1.8],
        "fill_opacity": [0.04, 0.28]
      },
      "fail_if": ["levels are invented", "interval model is absent", "band suggests measured topography without source"]
    },
    "shadow_depth": {
      "fields": ["owner_id", "dx_px", "dy_px", "blur_px", "opacity", "role", "why", "off_state"],
      "candidate_ranges": {
        "dx_px": [-8, 8],
        "dy_px": [1, 12],
        "blur_px": [2, 24],
        "opacity": [0.06, 0.24]
      },
      "fail_if": ["shadow implies unsupported elevation", "shadow hides connection geometry", "shadow is required to understand object identity"]
    },
    "blur_focus": {
      "fields": ["owner_id", "std_deviation_px", "role", "focus_target_id", "off_state"],
      "candidate_ranges": {
        "std_deviation_px": [0.5, 8.0]
      },
      "fail_if": ["text or evidence becomes unreadable", "blur implies uncertainty without legend", "blur is used on map-bound geometry"]
    },
    "glow_emission": {
      "fields": ["owner_id", "blur_px", "spread_px", "opacity", "role", "state_binding", "off_state"],
      "candidate_ranges": {
        "blur_px": [2, 18],
        "spread_px": [0, 8],
        "opacity": [0.08, 0.45]
      },
      "allowed_roles": ["MATERIAL_SURFACE", "PRESENTATIONAL_ATMOSPHERE", "REFERENCE_FIDELITY", "STATE_EMISSION"],
      "fail_if": ["generic quality signal", "no luminous/state owner", "glow masks source geometry"]
    },
    "displacement": {
      "fields": ["owner_id", "scale_px", "frequency", "seed", "axis", "role", "off_state"],
      "candidate_ranges": {
        "scale_px": [1, 18],
        "frequency": [0.01, 0.12]
      },
      "allowed_roles": ["MATERIAL_SURFACE", "PRESENTATIONAL_ATMOSPHERE", "REFERENCE_FIDELITY"],
      "fail_if": ["applied to analytical/map-bound geometry", "distortion changes topology", "used as generic technology/liquid effect"]
    },
    "edge_modulation": {
      "fields": ["owner_id", "amplitude_px", "frequency", "seed", "mask_id", "role", "off_state"],
      "candidate_ranges": {
        "amplitude_px": [0.3, 3.0],
        "frequency": [0.02, 0.25]
      },
      "fail_if": ["changes authoritative boundary", "creates false wear/material fact", "small-scale legibility fails"]
    },
    "paper_fiber": {
      "fields": ["owner_id", "frequency", "octaves", "opacity", "warmth_shift", "role", "off_state"],
      "candidate_ranges": {
        "frequency": [0.25, 1.0],
        "octaves": [1, 3],
        "opacity": [0.02, 0.10],
        "warmth_shift": [0.0, 0.08]
      },
      "allowed_roles": ["PRESENTATIONAL_ATMOSPHERE", "REFERENCE_FIDELITY"],
      "fail_if": ["paper effect competes with technical linework", "source did not contain paper/print character in exact reconstruction"]
    }
  },
  "motion_parameters": {
    "timing": {
      "candidate_ranges_ms": {
        "micro_feedback": [80, 220],
        "small_state_change": [140, 320],
        "layout_continuity": [220, 520],
        "diagram_reveal": [280, 900],
        "narrative_stage": [450, 1600]
      },
      "boundary": "Tune by distance, state frequency, reading load and runtime. These are starting ranges only."
    },
    "easing": {
      "named_candidates": {
        "standard_out": [0.16, 1.0, 0.3, 1.0],
        "standard_in_out": [0.65, 0.0, 0.35, 1.0],
        "gentle_out": [0.22, 1.0, 0.36, 1.0],
        "linear_progress": "linear"
      },
      "fail_if": ["easing is selected only for personality", "spring bounce is decorative", "scroll progress uses eased time instead of actual progress when fidelity to progress matters"]
    },
    "spring": {
      "candidate_ranges": {
        "stiffness": [120, 420],
        "damping": [18, 42],
        "mass": [0.7, 1.4]
      },
      "boundary": "Only for interruptible tactile/layout continuity; no decorative bounce."
    },
    "stagger": {
      "candidate_ranges_ms_per_item": [20, 90],
      "max_group_span_ms": [120, 700],
      "fail_if": ["sequence does not encode hierarchy/order", "large lists cause waiting", "every page load cascades"]
    },
    "parallax": {
      "candidate_relative_displacement": [0.02, 0.12],
      "fail_if": ["required for comprehension", "no reduced-motion alternative", "vestibular-heavy continuous motion", "map position is distorted"]
    },
    "noise_evolution": {
      "candidate_phase_rate_hz": [0.02, 0.35],
      "fail_if": ["moving grain is generic cinematic polish", "motion has no material/time/field role", "loop competes with reading"]
    }
  }
}
