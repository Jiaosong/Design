      "roles": ["MATERIAL_SURFACE", "PRESENTATIONAL_ATMOSPHERE", "REFERENCE_FIDELITY"],
      "mechanism": "feTurbulence + feColorMatrix + feComposite",
      "required_params": ["semantic_owner_id", "surface_role", "base_frequency", "num_octaves", "seed", "opacity", "mask_id", "off_state"],
