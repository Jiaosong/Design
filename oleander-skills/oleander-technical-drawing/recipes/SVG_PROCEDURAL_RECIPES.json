{
  "recipe_library_id": "TD-SVG-RECIPES-001",
  "version": "0.2",
  "status": "CANDIDATE / NO_PROMOTION",
  "parameter_library": "../references/VISUAL_EFFECT_PARAMETER_LIBRARY.json",
  "rules": [
    "Every recipe requires semantic_owner_id and surface_role.",
    "ANALYTICAL_FIELD recipes require mapped_variable and legend_id.",
    "REFERENCE_FIDELITY recipes must not invent effects absent from source.",
    "Recipe output is a graphic carrier, not material or field truth.",
    "Any recipe modifying map-bound or authoritative geometry is rejected unless the source itself contains that modulation.",
    "3D/GIS derived passes remain owned by their source model/data workflow and may only be composited without altering projected geometry."
  ],
  "recipes": [
    {
      "recipe_id": "SVG-R01-LINEAR-FIELD",
      "name": "Role-bound linear / tonal field",
      "roles": ["ANALYTICAL_FIELD", "MATERIAL_SURFACE", "HIERARCHY_RECESSION", "REFERENCE_FIDELITY"],
      "mechanism": "linearGradient + clipPath/mask",
      "required_params": ["semantic_owner_id", "surface_role", "x", "y", "width", "height", "axis_deg", "stops", "off_state"],
      "conditional_required": {"ANALYTICAL_FIELD": ["mapped_variable", "legend_id", "domain"]},
      "output_elements": ["defs/linearGradient", "rect|path fill=url(#gradient)"],
      "off_state": "replace gradient with declared flat fallback",
      "failure_triggers": ["no owner", "analytical gradient without legend", "gradient is sole geometry carrier"]
    },
    {
      "recipe_id": "SVG-R02-RADIAL-FIELD",
      "name": "Bounded radial influence / light field",
      "roles": ["ANALYTICAL_FIELD", "STATE_EMISSION", "PRESENTATIONAL_ATMOSPHERE", "REFERENCE_FIDELITY"],
      "mechanism": "radialGradient + bounded mask",
      "required_params": ["semantic_owner_id", "surface_role", "cx", "cy", "radius", "stops", "off_state"],
      "conditional_required": {"ANALYTICAL_FIELD": ["mapped_variable", "legend_id", "domain"], "STATE_EMISSION": ["state_binding"]},
      "output_elements": ["defs/radialGradient", "bounded field shape"],
      "off_state": "flat field or no emission depending role",
      "failure_triggers": ["looks like glow but has no state/light owner", "analytical radius is invented"]
    },
    {
      "recipe_id": "SVG-R03-HATCH",
      "name": "Vector hatch / directional surface",
      "roles": ["ANALYTICAL_FIELD", "MATERIAL_SURFACE", "HIERARCHY_RECESSION", "REFERENCE_FIDELITY"],
      "mechanism": "pattern + line transform",
      "required_params": ["semantic_owner_id", "surface_role", "angle_deg", "spacing_px", "stroke_px", "opacity", "mask_id", "off_state"],
      "conditional_required": {"ANALYTICAL_FIELD": ["mapped_variable", "legend_id"]},
      "output_elements": ["defs/pattern", "line", "masked fill"],
      "off_state": "flat fill or empty pattern",
      "failure_triggers": ["moire/alias at FAR scale", "pattern creates false boundary"]
    },
    {
      "recipe_id": "SVG-R04-STIPPLE",
      "name": "Deterministic stipple / point field",
      "roles": ["ANALYTICAL_FIELD", "MATERIAL_SURFACE", "REFERENCE_FIDELITY"],
      "mechanism": "seeded point generation",
      "required_params": ["semantic_owner_id", "surface_role", "x", "y", "width", "height", "density", "radius_px", "jitter", "seed", "off_state"],
