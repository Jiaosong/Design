    },
    {
      "recipe_id": "SVG-R12-HALFTONE",
      "name": "Deterministic halftone / print-density field",
      "roles": ["ANALYTICAL_FIELD", "REFERENCE_FIDELITY", "MATERIAL_SURFACE"],
