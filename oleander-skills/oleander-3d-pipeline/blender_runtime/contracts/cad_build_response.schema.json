{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "OLEANDER_CAD_BUILD_RESPONSE_v0.1",
  "title": "OLEANDER CAD Build Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "request_id", "ole_id", "revision", "status", "kernel", "request_sha256", "authoritative", "display_derivative", "measurements", "error"],
  "properties": {
    "schema": {"const": "OLEANDER_CAD_BUILD_RESPONSE_v0.1"},
    "request_id": {"type": "string", "minLength": 1},
    "ole_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["PASS", "FAIL"]},
    "kernel": {"$ref": "#/$defs/kernel"},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authoritative": {"$ref": "#/$defs/authority"},
    "display_derivative": {"$ref": "#/$defs/artifact_any"},
    "measurements": {"$ref": "#/$defs/measurements_any"},
    "error": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "PASS"}}},
      "then": {
        "properties": {
          "authoritative": {"$ref": "#/$defs/authority_pass"},
          "display_derivative": {"$ref": "#/$defs/artifact_pass"},
          "measurements": {"$ref": "#/$defs/measurements_pass"},
          "error": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "FAIL"}}},
      "then": {
        "properties": {
          "error": {"type": "string", "minLength": 1},
          "measurements": {"$ref": "#/$defs/measurements_fail"}
        }
      }
    }
  ],
  "$defs": {
    "kernel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "occ_version"],
      "properties": {
        "name": {"const": "FreeCAD"},
        "version": {"type": "string", "minLength": 1},
        "occ_version": {"type": "string", "minLength": 1}
      }
    },
    "artifact_any": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "artifact_pass": {
      "allOf": [
        {"$ref": "#/$defs/artifact_any"},
        {"properties": {"path": {"minLength": 1}}}
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["master_type", "geometry_authority", "fcstd", "step", "brep"],
      "properties": {
        "master_type": {"const": "CAD_NATIVE"},
        "geometry_authority": {"const": "FREECAD_OCCT_BREP"},
        "fcstd": {"$ref": "#/$defs/artifact_any"},
        "step": {"$ref": "#/$defs/artifact_any"},
        "brep": {"$ref": "#/$defs/artifact_any"}
      }
    },
    "authority_pass": {
      "allOf": [
        {"$ref": "#/$defs/authority"},
        {
          "properties": {
            "fcstd": {"$ref": "#/$defs/artifact_pass"},
            "step": {"$ref": "#/$defs/artifact_pass"},
            "brep": {"$ref": "#/$defs/artifact_pass"}
          }
        }
      ]
    },
    "measurements_any": {
      "type": "object",
      "additionalProperties": false,
      "required": ["units", "bbox_mm", "volume_mm3", "solid_count"],
      "properties": {
        "units": {"const": "mm"},
        "bbox_mm": {
          "type": "array",
          "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}],
          "minItems": 3,
          "maxItems": 3
        },
        "volume_mm3": {"type": "number", "minimum": 0},
        "solid_count": {"type": "integer", "minimum": 0}
      }
    },
    "measurements_pass": {
      "allOf": [
        {"$ref": "#/$defs/measurements_any"},
        {"properties": {"volume_mm3": {"exclusiveMinimum": 0}, "solid_count": {"const": 1}}}
      ]
    },
    "measurements_fail": {
      "allOf": [
        {"$ref": "#/$defs/measurements_any"},
        {"properties": {"solid_count": {"const": 0}}}
      ]
    }
  }
}
