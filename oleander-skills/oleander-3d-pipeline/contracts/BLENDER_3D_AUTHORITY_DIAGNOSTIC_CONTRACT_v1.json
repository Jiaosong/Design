{
  "schema": "oleander.skill.3d-pipeline.authority-diagnostic-contract.v2",
  "skill": "oleander-3d-pipeline",
  "version": "2026-08-17-v2",
  "purpose": "Make every OLEANDER 3D pipeline section executable through explicit input, checks, allowed actions, prohibitions, evidence and failure states while preserving Source/Derived/Diagnostic/Render/Design/Field separation.",
  "section_execution_fields": [
    "INPUT",
    "MUST_CHECK",
    "ALLOWED",
    "FORBIDDEN",
    "EVIDENCE",
    "FAIL"
  ],
  "state_model": [
    "SOURCE_OR_WORKING_SOURCE",
    "DERIVED_EXECUTION",
    "DERIVED_DIAGNOSTIC_NOT_AUTHORITY",
    "VISUALIZATION_OR_RENDER_SCENE",
    "REFERENCE_EVIDENCE"
  ],
  "authority_order": [
    "MASTER_PROTOCOL",
    "PROJECT_STATE",
    "SOURCE_AUTHORITY",
    "CURRENT_TASK",
    "CURRENT_PRODUCTION_ASSET"
  ],
  "task_classes": [
    "SOURCE_EDIT",
    "DERIVED_EXECUTION",
    "DIAGNOSTIC",
    "VISUALIZATION",
    "ANIMATION",
    "EXCHANGE",
    "DELIVERY",
    "REVIEW"
  ],
  "section_contracts": {
    "01_authority": {
      "required_evidence": [
        "AUTHORITY_RECEIPT"
      ],
      "failure_codes": [
        "HOLD_AUTHORITY_UNRESOLVED"
      ],
      "required_checks": [
        "CURRENT_NOT_TIMESTAMP_ONLY",
        "TASK_CLASSIFIED",
        "SOURCE_MUTATION_PERMISSION_EXPLICIT",
        "LEGACY_NOT_REPROMOTED"
      ]
    },
    "02_state_classification": {
      "required_evidence": [
        "STATE_CLASSIFICATION_TABLE"
      ],
      "failure_codes": [
        "FAIL_STATE_CLASSIFICATION_AMBIGUOUS"
      ],
      "required_checks": [
        "EVERY_EDIT_TARGET_CLASSIFIED",
        "OWNER_DECLARED",
        "MUTATION_PERMISSION_DECLARED",
        "REGENERATION_ORIGIN_DECLARED"
      ]
    },
    "03_blender_source_authority": {
      "required_evidence": [
        "SOURCE_BEFORE_JSON",
        "SOURCE_AFTER_JSON",
        "SOURCE_DIGEST",
        "DIAGNOSTIC_PROXY_IDENTITY",
        "SOURCE_DELTA_RECEIPT_IF_EDITED"
      ],
      "failure_codes": [
        "FAIL_SOURCE_OBJECT_SET_MISMATCH",
        "FAIL_SOURCE_MUTATED_DURING_DIAGNOSTIC",
        "FAIL_DIAGNOSTIC_TARGET_IS_AUTHORITATIVE",
        "FAIL_SOURCE_OWNER_TRANSFER_ATTEMPT"
      ],
      "required_checks": [
        "EXPECTED_SOURCE_SET",
        "BEFORE_AFTER_DIGEST",
        "PROXY_ONLY_MATERIAL_MUTATION",
        "SOURCE_OWNER_PRESERVED"
      ]
    },
    "04_sparse_edit": {
      "required_evidence": [
        "SOURCE_EDIT_DELTA_JSON",
        "CONTROLLED_BEFORE_AFTER_DIAGNOSTICS",
        "ROLLBACK_VALUE"
      ],
      "failure_codes": [
        "REVISE_EDIT_CAUSALITY_UNCLEAR",
        "FAIL_DENSE_MESH_PATCH_BYPASSES_SOURCE",
        "HOLD_RELATION_MODEL_INSUFFICIENT"
      ],
      "required_checks": [
        "SMALLEST_AUTHORIZED_CHANGE",
        "ONE_VARIABLE_FAMILY_AT_A_TIME",
        "EXISTING_RELATION_VOCABULARY_TESTED_FIRST",
        "ROLLBACK_RECORDED"
      ]
    },
    "05_surface_diagnostics": {
      "required_evidence": [
        "DIAGNOSTIC_MATRIX_JSON",
        "BROAD_REFERENCE",
        "BROAD_CANDIDATE",
        "STRIP_REFERENCE",
        "STRIP_CANDIDATE",
        "GRAZING_REFERENCE",
        "GRAZING_CANDIDATE",
        "ZEBRA_REFERENCE",
        "ZEBRA_CANDIDATE"
      ],
      "failure_codes": [
        "INSUFFICIENT_DIAGNOSTIC_EVIDENCE"
      ],
      "required_checks": [
        "CONTROLLED_A_B",
        "ALL_REQUIRED_VIEWS_PRESENT",
        "RIG_IDS_BOUND",
        "SOURCE_DIGEST_BOUND",
        "NO_CLASS_A_PROMOTION_FROM_ZEBRA"
      ]
    },
    "06_geometry_topology": {
      "required_evidence": [
        "GEOMETRY_QC_RECEIPT"
      ],
      "failure_codes": [
        "FAIL_SOURCE_STRUCTURE",
        "FAIL_DERIVED_TOPOLOGY",
        "FAIL_UNIT_OR_BOUNDS",
        "REVISE_FORM_DESPITE_CLEAN_TOPOLOGY"
      ],
      "required_checks": [
        "SOURCE_AND_DERIVED_CHECKED_SEPARATELY",
        "NORMALS",
        "MANIFOLDNESS_WHEN_REQUIRED",
        "BOUNDARY_DRIFT",
        "UNITS_BOUNDS"
      ]
    },
    "07_spatial_models": {
      "required_evidence": [
        "SPATIAL_ASSUMPTION_LEDGER",
        "SCALE_EVIDENCE",
        "SECTION_OR_AXON_OR_SEQUENCE_EVIDENCE"
      ],
      "failure_codes": [
        "HOLD_FIELD_DEPENDENT_DIMENSION",
        "REVISE_SPATIAL_PROOF_WEAK",
        "FAIL_INVENTED_SITE_PRECISION"
      ],
      "required_checks": [
        "GEOMETRY_EVIDENCE_CLASSIFIED",
        "FIELD_STATUS_PRESERVED",
        "MAIN_MODEL_PROVES_SPATIAL_PROPERTY",
        "NO_INVENTED_PRECISION"
      ]
    },
    "08_materials_cmf": {
      "required_evidence": [
        "CMF_COMPARISON_MATRIX"
      ],
      "failure_codes": [
        "INSUFFICIENT_PHYSICAL_CMF_EVIDENCE",
        "REVISE_MICRODETAIL_MASKS_FORM",
        "FAIL_COMPARISON_NOT_CONTROLLED"
      ],
      "required_checks": [
        "SHADER_VS_PHYSICAL_CLAIM_SEPARATED",
        "GEOMETRY_LOCKED",
        "RIG_LOCKED",
        "MICRODETAIL_NOT_MASKING_FORM"
      ]
    },
    "09_camera_render": {
      "required_evidence": [
        "RIG_LOCK_RECEIPT",
        "RENDER_SETTING_IDENTITY"
      ],
      "failure_codes": [
        "FAIL_RIG_LOCK_DRIFT",
        "INSUFFICIENT_COMPARISON_CAUSALITY"
      ],
      "required_checks": [
        "CAMERA_LOCK",
        "CROP_LOCK",
        "COLOR_MANAGEMENT_LOCK",
        "LIGHT_LOCK",
        "MATERIAL_LOCK",
        "DENOISE_POLICY_LOCK_WHEN_RELEVANT"
      ]
    },
    "10_technical_outputs": {
      "required_evidence": [
        "EDITABLE_VECTOR_TECHNICAL_OUTPUT",
        "LINKED_MODEL_REVISION",
        "DIMENSION_STATUS_LEGEND",
        "PREVIEW"
      ],
      "failure_codes": [
        "REVISE_TECHNICAL_HIERARCHY_UNREADABLE",
        "FAIL_DIMENSION_STATUS_AMBIGUOUS",
        "FAIL_DECORATIVE_EXPLODED_NOT_TECHNICAL"
      ],
      "required_checks": [
        "CAMERA_SCALE_LOCK",
        "ASSEMBLY_LOGIC",
        "VECTOR_TEXT_WHEN_REQUIRED",
        "DIMENSION_STATUS",
        "REAL_COMPONENT_SCALE_EXCEPT_EXPLICIT_EXPLOSION"
      ]
    },
    "11_exchange_roundtrip": {
      "required_evidence": [
        "ROUNDTRIP_REPORT"
      ],
      "failure_codes": [
        "FAIL_ROUNDTRIP_SCALE",
        "FAIL_ROUNDTRIP_AXIS_OR_ORIGIN",
        "FAIL_ROUNDTRIP_SEMANTIC_LOSS",
        "FAIL_EXPORT_PROMOTED_TO_SOURCE"
      ],
      "required_checks": [
        "FORMAT_PURPOSE_MATCH",
        "UNITS_BOUNDS",
        "AXIS_ORIGIN",
        "HIERARCHY",
        "NORMALS",
        "MATERIALS",
        "CRITICAL_NAMES",
        "SEMANTIC_LOSS_RECORDED"
      ]
    },
    "12_production_artifacts": {
      "required_evidence": [
        "PRODUCTION_ASSET_MANIFEST"
      ],
      "failure_codes": [
        "FAIL_REQUIRED_ARTIFACT_MISSING",
        "FAIL_RETAINED_BINARY_UNRECOVERABLE",
        "FAIL_MANIFEST_ASSET_MISMATCH"
      ],
      "required_checks": [
        "PATH_ROLE_CLASS_BYTES_SHA",
        "APP_VERSION",
        "DEPENDENCIES",
        "RECOVERABILITY",
        "VALIDATION_STATUS"
      ]
    },
    "13_review_gates": {
      "required_evidence": [
        "REVIEW_GATE_MATRIX"
      ],
      "failure_codes": [
        "FAIL_GATE_COLLAPSE",
        "REVISE_DESIGN_QUALITY",
        "REJECT_DESIGN_QUALITY",
        "HOLD_INDEPENDENT_REVIEW_MISSING"
      ],
      "required_checks": [
        "MACHINE_GATE_SEPARATE",
        "EVIDENCE_GATE_SEPARATE",
        "DESIGN_GATE_SEPARATE",
        "INDEPENDENT_REVIEW_FOR_MAIN"
      ]
    },
    "14_failure_routing": {
      "required_evidence": [
        "FAILURE_ROUTE_RECEIPT"
      ],
      "failure_codes": [
        "HOLD_ROOT_CAUSE_UNRESOLVED"
      ],
      "required_checks": [
        "SYMPTOM_RECORDED",
        "OBSERVED_LAYER_RECORDED",
        "OWNER_LAYER_HYPOTHESIS",
        "ISOLATION_TEST",
        "REJECTED_EDIT_TARGETS"
      ]
    },
    "15_completion": {
      "required_evidence": [
        "COMPLETION_RECEIPT"
      ],
      "failure_codes": [
        "PARTIAL_REQUIRED_NATIVE_VALIDATION_MISSING",
        "PARTIAL_REQUIRED_ARTIFACT_MISSING",
        "HOLD_REQUIRED_REVIEW_MISSING",
        "FAIL_FALSE_COMPLETION_CLAIM"
      ],
      "required_checks": [
        "ACTUAL_ASSET_EXISTS",
        "REQUIRED_EVIDENCE_EXISTS",
        "REOPEN_OR_MACHINE_CHECK_WHEN_POSSIBLE",
        "BOUNDARIES_INTACT",
        "GATES_SEPARATELY_STATED",
        "RESIDUAL_UNPROVEN_ITEMS_LISTED"
      ]
    }
  },
  "source_aware_diagnostic_sequence": [
    "RESOLVE_SOURCE_COLLECTION_AND_EXPECTED_OBJECT_SET",
    "SNAPSHOT_SOURCE_IDENTITY_TRANSFORM_PROPERTIES_AND_EDITABLE_GEOMETRY",
    "COMPUTE_DETERMINISTIC_SOURCE_DIGEST_WHEN_SUPPORTED",
    "REGENERATE_DERIVED_EXECUTION_FROM_SOURCE",
    "CREATE_DISPOSABLE_DIAGNOSTIC_PROXY",
    "ASSIGN_DIAGNOSTIC_MATERIAL_TO_PROXY_ONLY",
    "RUN_CONTROLLED_DIAGNOSTIC_VIEWS",
    "SNAPSHOT_SOURCE_AFTER_DIAGNOSTIC",
    "FAIL_CLOSED_ON_UNAUTHORIZED_SOURCE_CHANGE",
    "RECORD_EXACT_AUTHORIZED_SOURCE_DELTA_IF_EDIT_WAS_INTENTIONAL"
  ],
  "diagnostic_view_specs": {
    "BROAD": {
      "question": "IS_PRIMARY_MASS_INTENTIONAL",
      "inspect": [
        "SILHOUETTE",
        "PROPORTION",
        "LARGE_RADIUS_REFLECTION_FLOW",
        "FLATTENING_OR_BULGING",
        "PRIMARY_TERMINATION",
        "SINGLE_VOLUME_READ"
      ],
      "failure_signatures": [
        "MASS_PROPORTION",
        "LARGE_RADIUS_FLOW",
        "PRIMARY_TERMINATION"
      ],
      "required_pair": [
        "BROAD_REFERENCE",
        "BROAD_CANDIDATE"
      ]
    },
    "STRIP": {
      "question": "WHERE_DOES_HIGHLIGHT_VELOCITY_REVEAL_LOCAL_INSTABILITY",
      "inspect": [
        "BAND_ACCELERATION",
        "BAND_DECELERATION",
        "PINCHING",
        "LOCAL_WAVINESS",
        "UNJUSTIFIED_ASYMMETRY",
        "INTERFACE_OR_TERMINATION_DISCONTINUITY"
      ],
      "failure_signatures": [
        "LOCAL_WAVINESS",
        "PINCH",
        "TRANSITION_INSTABILITY"
      ],
      "required_pair": [
        "STRIP_REFERENCE",
        "STRIP_CANDIDATE"
      ]
    },
    "GRAZING": {
      "question": "DOES_FORM_SURVIVE_SHALLOW_ANGLE_LIGHTING",
      "inspect": [
        "FACETING",
        "ABRUPT_NORMAL_CHANGE",
        "DENT",
        "RIDGE",
        "CAP_OR_EDGE_COLLAPSE",
        "FRONTAL_LIGHT_HIDDEN_DEFECT"
      ],
      "failure_signatures": [
        "FACETING",
        "DENT_RIDGE",
        "CAP_COLLAPSE",
        "NORMAL_INSTABILITY"
      ],
      "required_pair": [
        "GRAZING_REFERENCE",
        "GRAZING_CANDIDATE"
      ]
    },
    "ZEBRA": {
      "question": "ARE_REFLECTION_LINES_CONTINUOUS_AND_INTENTIONALLY_PACED",
      "inspect": [
        "LINE_CONTINUITY",
        "SPACING_COMPRESSION",
        "CURVATURE_RATE_CHANGE",
        "POLE_BEHAVIOR",
        "TERMINATION_BEHAVIOR",
        "LOOPS_OR_HOOKS"
      ],
      "failure_signatures": [
        "REFLECTION_KINK",
        "SPACING_COMPRESSION",
        "POLE_HOOK",
        "TERMINATION_LOOP"
      ],
      "required_pair": [
        "ZEBRA_REFERENCE",
        "ZEBRA_CANDIDATE"
      ],
      "does_not_prove": [
        "G2",
        "G3",
        "CLASS_A"
      ]
    }
  },
  "controlled_comparison_locks": [
    "CAMERA_TRANSFORM_AND_PROJECTION",
    "FOCAL_LENGTH_OR_ORTHOGRAPHIC_SCALE",
    "CROP_AND_ASPECT",
    "COLOR_MANAGEMENT_AND_EXPOSURE",
    "WORLD_AND_BACKGROUND",
    "LIGHT_TRANSFORMS_SIZE_ENERGY_SHAPE",
    "DIAGNOSTIC_MATERIAL",
    "RENDER_SAMPLES_AND_DENOISE_POLICY_WHEN_RELEVANT"
  ],
  "hard_prohibitions": [
    "NO_SOURCE_MATERIAL_SLOT_MUTATION_FOR_DIAGNOSTIC_ONLY_WORK",
    "NO_DENSE_DERIVED_MESH_AS_SILENT_SOURCE_REPLACEMENT",
    "NO_DESTRUCTIVE_MODIFIER_ON_ONLY_AUTHORITATIVE_EDITABLE_OBJECT_WITHOUT_AUTHORIZED_SOURCE_CHANGE",
    "NO_UNRECORDED_TRANSFORM_BAKE_ON_SOURCE",
    "NO_LOCAL_COSMETIC_DENSE_MESH_PATCH_TO_HIDE_SOURCE_RELATION_FAILURE_WITHOUT_TOPOLOGY_AUTHORIZATION",
    "NO_NEW_SOURCE_FAMILY_WHEN_EXISTING_RELATION_VOCABULARY_CAN_EXPRESS_THE_CORRECTION",
    "NO_AI_GENERATED_GEOMETRY_OR_RENDER_AS_GEOMETRY_AUTHORITY",
    "NO_ZEBRA_ONLY_CLASS_A_G2_G3_CLAIM",
    "NO_TEXTURE_NOISE_TO_MASK_GEOMETRY_FAILURE",
    "NO_MACHINE_PASS_TO_DESIGN_PASS_PROMOTION",
    "NO_FILE_RECENCY_AS_AUTHORITY",
    "NO_VISUALIZATION_AS_SOURCE_AUTHORITY",
    "NO_FIELD_ZERO_AS_STOP_CONDITION",
    "NO_RASTER_TEXT_AS_SUBSTITUTE_FOR_REQUIRED_VECTOR_TECHNICAL_TEXT",
    "NO_EXCHANGE_EXPORT_AS_SILENT_SOURCE_PROMOTION"
  ],
  "sparse_edit_priority": [
    "LOCKED_GLOBAL_PROPORTIONS_AND_INTERFACES",
    "EXISTING_PROFILE_OR_GUIDE_FAMILIES",
    "EXISTING_RELATION_PARAMETERS",
    "ONE_NEW_EXPLICIT_SPARSE_DOF_IF_EXISTING_CONTROLS_ARE_PROVEN_INSUFFICIENT",
    "SOURCE_FAMILY_OR_TOPOLOGY_EXPANSION_ONLY_IF_RELATION_MODEL_IS_PROVEN_INADEQUATE"
  ],
  "source_edit_delta_required_fields": [
    "source_family",
    "control_name",
    "unit",
    "previous_value",
    "new_value",
    "allowed_range",
    "locked_dependencies",
    "predicted_geometric_effect",
    "sensitive_regions",
    "forbidden_side_effects",
    "rollback_value"
  ],
  "review_gates": {
    "machine_execution": [
      "PASS",
      "FAIL"
    ],
    "evidence": [
      "PASS",
      "INSUFFICIENT",
      "CONTRADICTED"
    ],
    "design_quality": [
      "KEEP",
      "REVISE",
      "REJECT",
      "HOLD"
    ]
  },
  "quality_separation": [
    "ARTIFACT_EXISTENCE_NOT_EQUAL_DESIGN_QUALITY",
    "TRACEABILITY_NOT_EQUAL_PROFESSIONAL_FINISH",
    "EVIDENCE_CORRECTNESS_NOT_EQUAL_VISUAL_EXCELLENCE",
    "PROCESS_PASS_NOT_EQUAL_MAIN_KEEP"
  ],
  "artifact_manifest_required_fields": [
    "path",
    "role",
    "state_class",
    "bytes",
    "sha256",
    "application_version",
    "dependencies",
    "recoverability",
    "validation_status"
  ],
  "blender_surface_system": {
    "preferred_current_line": "v1.21",
    "adapter_path": "90-shared/toolchains/blender-surface-system/v1.21.0/source_authority_adapter.py",
    "adapter_contract_path": "90-shared/toolchains/blender-surface-system/v1.21.0/SOURCE_AUTHORITY_ADAPTER_CONTRACT_v1.21.0.json",
    "diagnostic_proxy_role": "DERIVED_DIAGNOSTIC_NOT_AUTHORITY",
    "source_owner_transfer_allowed": false
  },
  "independent_review_required_for_main_keep": true,
  "boundary": "This Skill contract governs workflow and evidence discipline. It does not itself prove professional form quality, Class-A continuity, engineering validity, field verification, manufacturing readiness, physical CMF truth, or MAIN KEEP.",
  "receipt_schema_path": "oleander-skills/oleander-3d-pipeline/contracts/BLENDER_3D_RECEIPT_SCHEMAS_v1.json"
}
