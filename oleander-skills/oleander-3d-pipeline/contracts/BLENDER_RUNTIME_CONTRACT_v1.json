    "PASS",
    "HOLD_NOT_REQUIRED",
    "HOLD_PENDING",
    "FAIL"
  ],
  "forbidden_pass_conditions": [
    "runtime_support_unknown",
    "network_only_required_dependency",
    "remote_asset_not_materialized",
    "simulation_promoted_to_physical_truth",
    "requested_io_route_unverified",
    "output_not_readback"
  ],
  "does_not_prove_minimum": [
    "field truth",
    "engineering approval",
    "physical material properties",
    "manufacturing readiness",
    "Design KEEP"
  ]
