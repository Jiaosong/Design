{
  "schema": "oleander.modeling-worker.v0.13.blender-surface-binding.v2",
  "benchmark_id": "MW-V013-G1-ERGONOMIC-HANDHELD-SHELL",
  "modeling_worker_version": "v0.13",
  "blender_surface_system": {
    "system": "OLEANDER Blender Surface System",
    "version": "v1.20.0",
    "fidelity": "F1_DESIGN_VALIDATION",
    "required_lighting_rigs": ["BROAD", "STRIP", "GRAZING"],
    "additional_surface_diagnostic": "ZEBRA_NORMAL_FIELD"
  },
  "source_authority": {
    "state": "WORKING_SOURCE",
    "bootstrap_seed": "G1_PRIMARY_CURVE_SOURCE.json + G1_R2_RELATION_CORRECTION.json",
    "live_representation_after_bootstrap": "BLENDER_NATIVE_EDITABLE_WORKING_SOURCE",
    "families": ["GRIP_AXIS","PALM_PROFILE","THUMB_SIDE_PLAN","OPPOSITE_SIDE_PLAN","INTERFACE_DECK_BOUNDARY","LOWER_RETURN_PROFILE"],
    "collection": "OLEANDER_SOURCE_AUTHORITY",
    "objects": {
      "GRIP_AXIS":"OL_SRC_GRIP_AXIS",
      "PALM_PROFILE":"OL_SRC_PALM_PROFILE",
      "THUMB_SIDE_PLAN":"OL_SRC_THUMB_SIDE_PLAN",
      "OPPOSITE_SIDE_PLAN":"OL_SRC_OPPOSITE_SIDE_PLAN",
      "LOWER_RETURN_PROFILE":"OL_SRC_LOWER_RETURN_PROFILE",
      "INTERFACE_DECK_BOUNDARY":"OL_SRC_INTERFACE_DECK_BOUNDARY"
    },
    "native_readback_required": true,
    "native_edit_to_derived_rebuild_required": true,
    "dense_execution_mesh_is_authority": false
  },
  "surface_evaluation": {
    "derived_collection": "OLEANDER_DERIVED_EXECUTION",
    "qa_collection": "OLEANDER_QA_RIG",
    "method": "R2_ANALYTIC_RELATIONSHIP_SURFACE",
    "rebuild_text_block": "OLEANDER_G1_R2_REBUILD.py",
    "live_source_text_block": "OLEANDER_G1_R2_LIVE_SOURCE.json",
    "derived_mesh_object": "OL_DERIVED_G1_R2_BASELINE",
    "revision_variant_object": "OL_DERIVED_G1_R2_THUMB_REVISION"
  },
  "roundtrip_gate": {
    "bootstrap_readback_tolerance_m": 1e-12,
    "controlled_native_edit_object": "OL_SRC_THUMB_SIDE_PLAN",
    "controlled_native_edit_index": 3,
    "controlled_native_edit_delta_m": 0.003,
    "only_declared_source_family_may_change": "THUMB_SIDE_PLAN",
    "derived_surface_must_change_min_m": 0.001,
    "restore_tolerance_m": 1e-12,
    "writeback_policy": "WRITE_NEW_ROUNDTRIP_SNAPSHOT; DO_NOT_OVERWRITE_BOOTSTRAP_SEED"
  },
  "diagnostics": {
    "required_render_passes": ["BROAD","STRIP","GRAZING","ZEBRA","RELATION_A_B"],
    "fixed_camera_required": true,
    "surface_source_and_execution_geometry_must_remain_separable": true
  },
  "boundary": "This binding upgrades the Blender representation from editable mirror to live Working Source with readback/rebuild and a new round-trip snapshot. It does not overwrite historical seed evidence or establish ergonomic comfort, Class-A, engineering CAD, manufacturing/tooling, final CMF, Candidate Promotion, Canonical Promotion or Release."
}
