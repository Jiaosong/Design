  },
  "diagnostic_policy": {
    "diagnostic_proxy_required": true,
    "diagnostic_proxy_role": "DERIVED_DIAGNOSTIC_NOT_AUTHORITY",
    "source_before_after_digest_gate_required": true,
    "source_geometry_mutation_during_diagnostic_forbidden": true,
    "source_material_mutation_forbidden": true,
    "project_target_material_mutation_forbidden": true,
    "diagnostic_material_mutation_allowed_on_proxy_only": true,
    "controlled_source_edit_must_change_digest": true,
    "restored_source_must_restore_digest": true,
    "promotion_impact": "NONE"
  },
  "adoption": {
    "new_surface_diagnostic_runs": "USE_v1.21_SOURCE_CONTEXT_ADAPTER",
