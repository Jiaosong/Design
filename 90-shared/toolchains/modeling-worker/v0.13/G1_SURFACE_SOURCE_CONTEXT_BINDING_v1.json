        "termination_envelope_exponent",
        "termination_envelope_semantics",
        "termination_cap_onset_u",
        "termination_cap_pole_curvature_scale",
        "termination_cap_numeric_dof_count"
      ],
      "INTERFACE_DECK_BOUNDARY": [
        "u_center",
        "u_halfspan",
