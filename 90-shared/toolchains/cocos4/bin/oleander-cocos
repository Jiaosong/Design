#!/usr/bin/env bash
set -euo pipefail

TOOL_ROOT="${OLEANDER_COCOS_HOME:-${OLEANDER_COCOS_TOOL_ROOT:-/opt/oleander/cocos4}}"
ENV_FILE="$TOOL_ROOT/toolchain.env"
[[ -f "$ENV_FILE" ]] && source "$ENV_FILE"
TOOL_ROOT="${OLEANDER_COCOS_HOME:-$TOOL_ROOT}"

usage(){ cat <<'TXT'
OLEANDER COCOS 4 shared gateway
Usage:
  oleander-cocos doctor
  oleander-cocos version
  oleander-cocos create <project-path> [2d]
  oleander-cocos build <project-path> [platform]
  oleander-cocos mcp <project-path> [port]
  oleander-cocos raw <cocos-cli arguments...>
TXT
}

resolve_cocos(){
  local pinned_cli="$TOOL_ROOT/cli/dist/cli.js"
  if [[ -f "$pinned_cli" ]]; then
    COCOS_CMD=(node "$pinned_cli")
    return
  fi
  if command -v cocos >/dev/null 2>&1; then
    COCOS_CMD=(cocos)
    return
  fi
  echo "ERROR: upstream COCOS CLI is not installed at $TOOL_ROOT/cli." >&2
  echo "Run the OLEANDER shared bootstrap first." >&2
  exit 69
}

run_cocos(){
  resolve_cocos
  "${COCOS_CMD[@]}" "$@"
}

run_cocos_with_display(){
  resolve_cocos
  if [[ "$(uname -s)" == "Linux" && -z "${DISPLAY:-}" ]]; then
    if ! command -v xvfb-run >/dev/null 2>&1; then
      echo "ERROR: headless Linux COCOS build requires xvfb-run, but it is not installed." >&2
      echo "Install the xvfb package or provide a DISPLAY before running the build gateway." >&2
      exit 69
    fi
    echo "OLEANDER: no DISPLAY detected; running COCOS build under Xvfb software rendering." >&2
    LIBGL_ALWAYS_SOFTWARE="${LIBGL_ALWAYS_SOFTWARE:-1}" \
      xvfb-run -a -s "-screen 0 1280x720x24" "${COCOS_CMD[@]}" "$@"
    return
  fi
  "${COCOS_CMD[@]}" "$@"
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  help|-h|--help) usage ;;
  doctor) "$TOOL_ROOT/doctor.sh" ;;
  version) run_cocos --version ;;
  create)
    p="${1:?project path required}"
    type="${2:-2d}"
    if [[ "$type" != "2d" ]]; then
      echo "ERROR: OLEANDER governed create gateway currently supports only 2d; requested: $type" >&2
      exit 64
    fi
    run_cocos create --project "$p" --type "$type"
    ;;
  build) p="${1:?project path required}"; platform="${2:-web-mobile}"; run_cocos_with_display build --project "$p" --platform "$platform" ;;
  mcp) p="${1:?project path required}"; port="${2:-9527}"; run_cocos start-mcp-server --project "$p" --port "$port" ;;
  raw) run_cocos "$@" ;;
  *) echo "Unknown command: $cmd" >&2; usage; exit 64 ;;
esac
