{
  "name": "@oleander/notion-canonical-knowledge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Authority-aware Notion canonical knowledge ingestion and retrieval runtime for OLEANDER.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:migrate:local": "wrangler d1 migrations apply oleander-knowledge-manifest --local",
    "d1:migrate:remote": "wrangler d1 migrations apply oleander-knowledge-manifest --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260911.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.1"
  }
}
