{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oleander.modeling-contract.v0.2",
  "title": "OLEANDER Modeling Contract v0.2",
  "type": "object",
  "required": [
    "contract_version",
    "job_id",
    "domain",
    "decision_question",
    "loop",
    "fidelity",
    "design_state",
    "source_authority",
    "modeling_stage",
    "hard_points",
    "envelopes",
    "sections",
    "semantic_components",
    "locks",
    "qa",
    "resource_budget",
    "cache",
    "exit_condition",
    "promotion",
    "persistence"
  ],
  "properties": {
    "contract_version": {"const": "v0.2"},
    "job_id": {"type": "string", "minLength": 1},
    "domain": {"enum": ["PRODUCT", "AUTOMOTIVE", "FURNITURE", "ARCHITECTURE", "SPATIAL", "STRUCTURAL_COMPONENT", "LANDSCAPE", "GIS", "VECTOR_GEOMETRY", "OTHER"]},
    "decision_question": {"type": "string", "minLength": 1},
    "loop": {"enum": ["EXPLORATION_SANDBOX", "CANONICAL_PRODUCTION"]},
    "fidelity": {"enum": ["F0_PREFLIGHT", "F1_DESIGN_VALIDATION", "F2_PROMOTION", "F3_PRESENTATION"]},
    "design_state": {"enum": ["EXPLORE", "CANDIDATE", "REVISE", "REJECTED", "PROMOTED", "LOCKED", "SUPERSEDED"]},
    "source_authority": {
      "type": "object",
      "required": ["state", "editable_source"],
      "properties": {
        "state": {"enum": ["NONE", "WORKING_SOURCE", "CANDIDATE_AUTHORITY", "CANONICAL_AUTHORITY", "FROZEN_AUTHORITY"]},
        "editable_source": {"type": ["string", "null"]},
        "artifact_hash": {"type": ["string", "null"]},
        "derived_models": {"type": "array", "items": {"type": "string"}},
        "exports": {"type": "array", "items": {"type": "string"}}
      }
    },
    "modeling_stage": {"enum": ["M0", "M1", "M2", "M3", "M4", "M5", "M6", "M7", "M8", "M9", "M10"]},
    "hard_points": {"$ref": "#/$defs/applicableBlock"},
    "envelopes": {"$ref": "#/$defs/applicableBlock"},
    "sections": {"$ref": "#/$defs/applicableBlock"},
    "primary_geometry": {"type": "array", "items": {"type": "object"}},
    "semantic_components": {"type": "array", "items": {"$ref": "#/$defs/component"}},
    "dependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}},
    "locks": {"type": "array", "items": {"$ref": "#/$defs/lock"}},
    "revision": {"type": ["object", "null"]},
    "qa": {
      "type": "object",
      "required": ["integrity", "construction", "design_geometry", "project"],
      "properties": {
        "integrity": {"type": "array", "items": {"type": "string"}},
        "construction": {"type": "array", "items": {"type": "string"}},
        "design_geometry": {"type": "array", "items": {"type": "string"}},
        "project": {"type": "array", "items": {"type": "string"}},
        "diagnostic_views": {"type": "array", "items": {"type": "string"}}
      }
    },
    "resource_budget": {"type": "object"},
    "cache": {
      "type": "object",
      "required": ["enabled", "scope", "key_inputs"],
      "properties": {
        "enabled": {"type": "boolean"},
        "scope": {"enum": ["JOB_LOCAL", "PROJECT_LOCAL", "PERSISTENT_CROSS_RUN"]},
        "key_inputs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "exit_condition": {"type": "string", "minLength": 1},
    "promotion": {
      "type": "object",
      "required": ["worker_may_mutate_source_authority"],
      "properties": {
        "worker_may_mutate_source_authority": {"const": false},
        "decision": {"enum": ["PENDING", "PROMOTE", "REVISE", "REJECT", "BLOCK"]}
      }
    },
    "persistence": {
      "type": "object",
      "required": ["policy"],
      "properties": {
        "policy": {"enum": ["TEMP_ONLY", "RECEIPT_ONLY", "PROMOTION_ONLY"]},
        "artifact_registry": {"type": "boolean"},
        "sync_targets": {"type": "array", "items": {"enum": ["NOTION", "GITHUB", "GOOGLE_DRIVE"]}}
      }
    }
  },
  "$defs": {
    "applicableBlock": {
      "type": "object",
      "required": ["applicable", "items"],
      "properties": {
        "applicable": {"type": "boolean"},
        "not_applicable_reason": {"type": ["string", "null"]},
        "items": {"type": "array"}
      }
    },
    "component": {
      "type": "object",
      "required": ["id", "role", "parent", "source_type", "authority_state"],
      "properties": {
        "id": {"type": "string"},
        "role": {"type": "string"},
        "parent": {"type": ["string", "null"]},
        "source_type": {"enum": ["EDITABLE_SOURCE", "GENERATOR", "INSTANCE", "DERIVED_MODEL", "EXPORT"]},
        "source_ref": {"type": ["string", "null"]},
        "parameters": {"type": "object"},
        "instance_rule": {"type": ["string", "null"]},
        "authority_state": {"enum": ["NONE", "WORKING_SOURCE", "CANDIDATE_AUTHORITY", "CANONICAL_AUTHORITY", "FROZEN_AUTHORITY"]}
      }
    },
    "dependency": {
      "type": "object",
      "required": ["from", "to", "type"],
      "properties": {
        "from": {"type": "string"},
        "to": {"type": "string"},
        "type": {"enum": ["DESIGN", "GEOMETRY", "PARAMETER", "INSTANCE", "MATERIAL", "VIEW", "EXPORT"]}
      }
    },
    "lock": {
      "type": "object",
      "required": ["target", "state", "reason"],
      "properties": {
        "target": {"type": "string"},
        "state": {"enum": ["OPEN", "LOCKED", "DEPENDENCY_LOCKED", "CONDITIONALLY_UNLOCKABLE", "FROZEN"]},
        "reason": {"type": "string"},
        "unlock_trigger": {"type": ["string", "null"]}
      }
    }
  }
}